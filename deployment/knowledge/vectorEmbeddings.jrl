64,0.0155444145,-0.019779958,0.008796463,-0.03442506,0.017983863,0.0050589545,-6.085191E-8,-0.04443129,0.040571347,6.948834E-4,-0.065207936,0.039998293,-0.016135762,0.063962184,0.010816183,0.015738089,-0.10509846,0.12166341,0.038153425,0.10569984,-0.025157683,0.06835084,-0.022293523,0.04660207,-0.054231234,-0.02974112,-0.026949378,-0.01676876,-0.041169405,0.018281085,-0.045739084,-0.056489177,-0.08105961,0.045285966,0.09094535,0.08204255,-0.049639363,-0.19393848,0.030151688,-0.031479444,0.04160593,-0.065914296,-0.047428742,-0.05728797,-0.05547652,0.063933946,0.0726603,0.038206484,-0.023959488,-0.06792148,0.011000437,0.033778194,0.048507184,-0.019839972,-0.045574866,0.057397924,0.01644823,-0.06597771,0.014687346,0.011158291,0.004567922,0.06488696,-0.018844089,0.031179061,-0.028715448,0.037906505,0.014636667,0.0050701164,-0.0029990256,-0.025048692,0.001028814]})
