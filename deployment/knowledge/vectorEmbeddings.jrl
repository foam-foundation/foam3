c({id:"U3:15",text:"Property View Refinements\nEvery FOAM property type ships a default view via a refinement class in Element2.js. These map types to their UI widgets:\n\n| Property type | Default view |\n|--------------|-------------|\n| String | foam.u2.view.StringView (TextField in edit, text in view) |\n| Int, Float | IntView, FloatView |\n| Boolean | CheckBox |\n| Date | DateView |\n| DateTime | DateTimeView |\n| Enum | EnumView |\n| FObjectProperty | FObjectPropertyView |\n| FObjectArray | TitledArrayView |\n| Reference | ReferencePropertyView |\n| Color | ModeAltView with ColorPicker (write) / ReadColorView (read) |\n| Password | PasswordView |\n| Code | CodeView |\n\nOverride per-property with view::\n\njavascript\n{\n  class: 'String',\n  name: 'type',\n  view: {\n    class: 'foam.u2.view.ChoiceView',\n    choices: ['VISA', 'MASTERCARD', 'AMEX']\n  }\n},\n{\n  class: 'Reference',\n  of: 'foam.core.auth.User',\n  name: 'assignedTo',\n  view: function(_, X) {\n    return {\n      class: 'foam.u2.view.RichChoiceView',\n      sections: [{ heading: 'Users', dao: X.userDAO }]\n    };\n  }\n}\n\n\n---",sourceId:"U3",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[0.0074967467,0.032108124,0.03166502,0.10702772,0.041882064,0.08449437,0.036414906,-0.020749658,0.03170985,-0.03160286,-0.0516223,-0.0414554,-0.057980485,0.022923429,0.03002956,0.08421818,-0.048673965,-0.08362902,-0.060306657,0.06201248,0.066548906,-0.019150699,0.027548729,-0.06604583,-0.06233095,0.068915,0.07871085,-0.056929246,-0.07821751,-0.054775197,-0.010326227,0.06963666,0.002303615,0.025936559,-0.10814921,-0.037859477,0.008054524,8.012176E-4,0.01679845,-0.013897326,-0.050794214,0.052789353,-0.04941517,-0.042219482,0.020526009,7.392706E-4,0.065812066,-0.03829339,-0.01651001,0.06300783,0.026115032,0.0055224914,-0.0049600997,0.030205948,0.047837887,0.061353885,-0.03836948,0.032083064,0.07342665,0.01707286,0.017041994,1.4587982E-4,0.030674275,-5.754253E-4,0.0058818827,0.02323108,-0.0346656