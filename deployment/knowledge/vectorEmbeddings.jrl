c({id:"demo:0",text:"demo\nA foam.QA2 demo: a restaurant-picker decision tree driven by questions, outcomes, and predicates.\n\nKeywords: qa2, demo, decision tree, questions, knowledge\n\n<flow name=\"demo\" category=\"DOC/DEV\" spid=\"foam\" description=\"A foam.QA2 demo: a restaurant-picker decision tree driven by questions, outcomes, and predicates.\" keywords=\"qa2,demo,decision tree,questions,knowledge\"/>\n\njs\nconsole.clear();\n\nfoam.QA2({\n  package: 'com.example',\n  name: 'RestaurantPicker',\n\nproperties: [\n    // Inputs\n    { class: 'Boolean', name: 'allergicToSeafood' },\n    { class: 'Boolean', name: 'allergicToWheat' },\n    { class: 'Float',   name: 'priceLimit' },\n\n// Outputs\n    { class: 'String',  name: 'name' }\n  ],\n\nquestions: [\n    { name: 'cuisine',\n      prompt: 'What type of cuisine are you in the mood for?',\n      choices: ['Asian', 'Italian', 'American', 'Mexican'] },\n\n{ name: 'spicy',\n      prompt: 'Do you enjoy spicy food?' },\n\n{ name: 'vegetarian',\n      prompt: 'Are you looking for a vegetarian option?' },\n\n{ name: 'dineIn',\n      prompt: 'Would you like to dine in?' }\n  ],\n\noutcomes: [\n    { name: 'Sushi Place',\n      predicate: 'allergicToSeafood IS FALSE AND cuisine=Asian AND spicy=FALSE AND priceLimit>=30' },\n\n{ name: 'Thai Restaurant',\n      predicate: 'cuisine = Asian AND spicy = TRUE AND priceLimit >= 20' },\n\n{ name: 'Noodle Bar',\n      predicate: 'allergicToWheat IS FALSE AND cuisine = Asian AND priceLimit < 20' },\n\n{ name: 'Pizza Trattoria',\n      predicate: 'allergicToWheat IS FALSE AND cuisine = Italian AND priceLimit < 25' },\n\n{ name: 'Fine Italian',\n      predicate: 'cuisine = Italian AND priceLimit >= 40' },\n\n{ name: 'Burger Joint',\n      predicate: 'allergicToWheat IS FALSE AND cuisine = American AND vegetarian = FALSE AND priceLimit < 20' },\n\n{ name: 'Steakhouse',\n      predicate: 'cuisine = American AND vegetarian = FALSE AND priceLimit >= 30' },\n\n{ name: 'Veggie Grill',\n      predicate: 'cuisine = American AND vegetarian = TRUE' },",sourceId:"demo",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[0.012593898,0.08741551,0.050184168,0.061482135,-0.004640135,0.0054431804,0.02341994,-0.013287212,0.06702626,-0.014090895,-0.016192043,-0.11034808,0.020907639,0.0104183825,0.087178975,0.057703093,-0.07119447,-0.021880763,-0.07153316,-0.104087315,0.07890501,0.038166665,0.008129074,-0.037134204,-0.014665508,0.028642807,0.029652895,0.013305358,-0.0844626,-0.001037094,-0.051184382,-0.025291426,0.030879125,0.03779189,-0.05877802,-0.0305819,-0.06742136,-0.053220388,0.003471137,0.013971612,-0.03767829,0.06119232,-0.06433273,-0.13127106,0.077775106,-0.04210611,-0.15166463,0.006362659,0.052403793,0.018643286,-0.078636296,-0.052547075,-0.012243071,-0.020775264,0.040545788,0.046018723,-0.06264124,-0.062135097,-0.009214453,-0.053835083,0.010361686,-0.06760199,-0.018465769,0.045597557,0.028963562,-0.06738586,-0.007426504,0.08451663,0.0016542437,0.058276318,-0.027497908,0.069176205,0.045867316,-0.027816074,0.023523789,0.013908576,0.04871985,-0.064780444,0.061093558,0.066830784,-0.111106984,-0.056338638,-0.09322128,0.0061923205,0.0495906,-7.8980386E-4,-0.01610453,0.015749289,-0.046076335,-0.051926956,-0.07902853,-0.06898711,0.038041368,0.004672051,0.027667193,0.08286623,0.009985713,-0.07502883,-0.009919778,0.06248272,-0.009720099,-0.052295633,0.020168558,-0.065264866,0.0012108373,-0.009238482,-0.017265642,-0.019224275,0.02681201,0.007941269,-0.049866844,0.03552334,-0.038498785,-0.0030498859,-0.10641963,0.063937396,0.07012783,-0.03678261,0.04842496,0.0037289546,0.08436349,0.03230695,-0.043437995,-0.006307144,0.019705404,-0.102582484,0.012708042,4.3457747E-33,0.011275458,-0.09325575,0.032980032,-0.039490715,0.12607494,0.010541732,-0.029029386,0.04758379,-0.026295573,0.02836409,-0.014064006,0.02338635,-0.07838108,-0.030494928,0.043622453,-0.09073355,-0.009253121,0.020938417,-0.021388726,-0.0097985035,-0.029967686,0.013890974,-0.0036106927,0.02164