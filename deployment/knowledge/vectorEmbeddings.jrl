c({id:"NanoServices:10",text:"Create a services.jrl file:\n\njavascript\np({\n  \"class\": \"foam.core.boot.CSpec\",\n  \"name\": \"searchService\",\n  \"serve\": true,\n  \"authenticate\": true,\n  \"boxClass\": \"com.example.SearchServiceSkeleton\",\n  \"serviceScript\": \"\"\"\n    return new com.example.ServerSearchService(x)\n      .setIndexPath(\"/var/search/index\");\n  \"\"\",\n  \"client\": \"\"\"\n    {\n      \"class\": \"com.example.ClientSearchService\",\n      \"delegate\": {\n        \"class\": \"foam.box.SessionClientBox\",\n        \"delegate\": {\n          \"class\": \"foam.box.HTTPBox\",\n          \"url\": \"service/searchService\"\n        }\n      }\n    }\n  \"\"\"\n})\n\nStep 5: Use the Service\n\njavascript\nfoam.CLASS({\n  name: 'SearchView',\n  extends: 'foam.u2.View',\n\nimports: ['searchService'],\n\nrequires: ['com.example.SearchRequest'],\n\nmethods: [\n    async function doSearch(query) {\n      var request = this.SearchRequest.create({ query: query });\n      var response = await this.searchService.search(this.subContext, request);\n      return response.results;\n    }\n  ]\n});\n\n---",sourceId:"NanoServices",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.054003697,0.05231488,-0.011654073,0.031456504,-0.030764816,0.040591426,-0.01579654,-0.019476572,0.031292107,-0.089082815,-0.05595651,-0.0048542665,0.033406515,0.03754191,0.051255267,-0.036119193,0.022027489,-0.048572984,0.01574113,-0.03152725,0.10299285,0.06788486,0.051627826,-0.08647283,-0.104369916,-0.04316073,-0.029730856,-0.15414332,-0.024239883,0.01360144,0.055119053,-0.023689913,-0.061739102,0.030498717,-0.01718758,0.034143694,0.008673627,-0.0478566,0.0053653778,3.759641E-4,0.0073766396,0.020865116,-0.027070316,-0.058102947,0.02898932,-0.06416391,-0.040210485,-0.054900944,0.05677511,0.03231711,-0.07322602,-0.047266934,0.0054902695,-0.016259795,-0.039631233,0.024770673,-0.07822795,0.038108803,0.0057785907,-0.0421303,0.049352527,-0.083979666,0.052704252,0.001