// Transformers.js: dynamic import() triggers both script-src and connect-src for the CDN URL. The library
// then imports its ONNX runtime from onnxruntime-web's own CDN folder, at the exact version transformers.js
// 4.3.2 pins (1.31.0-dev.20260914-8d85527a0): a new library version needs both URLs changed together
p({class:"foam.core.http.csp.CSPDirective",name:"script-src",key:"knn-transformers",value:"https://cdn.jsdelivr.net/npm/@huggingface/transformers@4.3.2/dist/ https://cdn.jsdelivr.net/npm/onnxruntime-web@1.31.0-dev.20260914-8d85527a0/dist/"})
// Model weights are fetched from HuggingFace and their AWS CDN mirrors at runtime
p({class:"foam.core.http.csp.CSPDirective",name:"connect-src",key:"knn-transformers",value:"https://cdn.jsdelivr.net https://huggingface.co https://*.huggingface.co https://*.hf.co"})
// TransformersPipeline runs the models in a worker made from a blob: URL
p({class:"foam.core.http.csp.CSPDirective",name:"worker-src",key:"knn-transformers",value:"blob:"})
