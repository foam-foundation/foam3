0.018679257,0.08940528,-0.001568856,0.025046447,0.04063073,-0.028149843,0.040634684,0.067821726,0.021397995,0.025940536,-0.072851986,-0.077763066,-0.01194755,-0.015561204,-0.013857132,-0.083344705,0.0029726054,0.0010507979,-0.017863661,-0.04680751,0.09316495,-0.052556504,-0.09533576,0.098283984,0.027317071,0.04223645,-0.05314067,0.013177498,0.06719301,0.06441452,0.11776521,0.023389626,0.07234055,0.015080516,0.090966925,0.039260816,0.09046689,0.0278753,-0.010102806,-0.011304785,0.005276569,0.023435328,0.01419942,-0.15019464,0.04577789,-0.01588029,-0.089739755,-0.05868749,0.041539203,-0.04583287,0.03618966,0.06751416,-0.09753982,0.00922775,-0.043212164,-0.0143407425,0.05443197,-0.023059458,-0.036608443,0.04744804,0.005572226]})
