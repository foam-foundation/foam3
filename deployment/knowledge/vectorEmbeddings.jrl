c({id:"DesignPatterns:11",text:"NullObject\nNullDAO is a NullObject implementation of the DAO interface. It stores nothing and does nothing \u2014 put returns the object unchanged, find returns null, select returns immediately with an empty result. It is useful as a placeholder, a default, or a test double where no storage is needed.",sourceId:"DesignPatterns",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.056122657,0.07699356,-0.10247098,0.056048747,-0.051783178,-0.023298306,-0.0014540071,0.014315928,-0.022091938,0.018690202,0.0554498,-0.06940946,-0.06309509,-0.06644583,-0.08173626,0.11087251,0.07096279,-0.032898925,-0.021302348,0.009906023,0.034069046,0.07715698,-0.0053846347,-0.045230243,0.018088544,0.062085092,0.015893018,-0.09112748,0.002201306,-0.059592582,-0.053038526,0.07660682,-0.015882071,-0.03365278,0.074673,0.051519625,0.079171784,0.029110624,-0.0033533874,-0.017503805,0.06499525,0.09253921,-0.019628465,0.028313527,-0.044284087,0.012564429,-0.032492593,-0.008883125,0.07560362,-0.13081186,-0.009311199,0.024190504,-0.013178967,0.087341495,-0.009568794,0.046089273,0.021975351,-0.048173554,-0.07724135,0.022354685,0.017226458,0.0023301565,0.0665568,0.041496392,0.11667474,-0.04568098,-0.012290212,-0.100487895,0.0067197657,-0.1001969,-0.047155283,-0.015571938,0.03171175,0.11328542,-0.016625151,-0.018611094,0.019648619,0.011640045,0.12839706,0.051249575,-0.05205419,0.0026550952,-0.035507508,-0.042103913,-0.030426744,0.01852174,0.0018070495,-0.022631137,0.03182032,0.08167534,-0.05915292,0.009569523,-0.039884366,-0.06313137,-0.044674926,-0.0611143,0.04558006,0.05415559,-0.027092211,0.018890211,0.024276014,0.01332582,-0.036566343,-0.04438642,-0.050690524,-0.02602424,-0.0055200197,-0.10965375,-0.006013687,0.057827614,-0.03386412,0.014798074,-0.03295182,-0.015672829,-0.10213183,-0.051483415,-0.05470366,-0.01943855,-0.03895667,0.010069728,0.031373218,-0.049314097,-0.0035185593,-1.651313E-4,-0.0028915363,-5.0482247E-4,-0.009760523,-5.409856E-34,0.02687