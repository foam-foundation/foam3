});

add(LinkedDateTimeExample.create());

## DateService Integration Test
Test DateService parsing with various formats
--
foam.CLASS({
  name: 'DateServiceTest',
  extends: 'foam.u2.Controller',
  imports: ['dateService?'],

  properties: [
    {
      class: 'String',
      name: 'testInput',
      label: 'Test Date String',
      value: '2024-03-15'
    },
    {
      class: 'String',
      name: 'results',
      label: 'Parse Results',
      view: { class: 'foam.u2.tag.TextArea', rows: 15, cols: 80 }
    }
  ],

  actions: [
    {
      name: 'testParse',
      label: 'Test DateService Parsing',
      code: async function() {
        if ( ! this.dateService ) {
          this.results = 'ERROR: DateService not available in context';
          return;
        }

        var formats = [
          '2024-03-15',    // YYYY-MM-DD
          '2024/03/15',    // YYYY/MM/DD
          '20240315',      // YYYYMMDD
          '03-15-2024',    // MM-DD-YYYY
          '03/15/2024',    // MM/DD/YYYY
          '03152024',      // MMDDYYYY
          '24-03-15',      // YY-MM-DD
          '24/03/15',      // YY/MM/DD
          '240315'         // YYMMDD
        ];

        var output = 'DateService Format Testing\n';
        output += '=' .repeat(60) + '\n\n';

        for ( var i = 0; i < formats.length; i++ ) {
          var format = formats[i];
          try {
            var date = await this.dateService.parseDateString(this.__context__, format);
            output += '✓ ' + format.padEnd(15) + ' → ' + date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: '2-digit',
              day: '2-digit'
            }) + '\n';
          } catch (e) {
            output += '✗ ' + format.padEnd(15) + ' → ERROR: ' + e.message + '\n';
          }
        }

        output += '\n' + '='.repeat(60) + '\n';
        output += 'Custom Input Test: ' + this.testInput + '\n';

        try {
          var customDate = await this.dateService.parseDateString(this.__context__, this.testInput);
          output += '✓ Parsed: ' + customDate.toLocaleDateString() + '\n';
          output += '  ISO: ' + customDate.toISOString() + '\n';
        } catch (e) {
          output += '✗ ERROR: ' + e.message + '\n';
        }

        this.results = output;
      }
    }
  ],

  methods: [
    function render() {
      this.addClass().start().
        add(this.TEST_INPUT).br().
        add(this.TEST_PARSE).br().br().
        add(this.RESULTS).
      end();
    }
  ]
});

add(DateServiceTest.create());

## DateService Status
Check DateService availability and capabilities
--
foam.CLASS({
  name: 'DateServiceStatus',
  extends: 'foam.u2.Controller',
  imports: ['dateService?'],

  methods: [
    function render() {
      var self = this;
      this.addClass().start().
        start('h3').add('DateService Status').end().

        callIf(! this.dateService, function() {
          this.start('div').addClass('foam-demos-examples-Controller-status-error').
            add('✗ DateService is NOT available in context').
          end();
        }).

        callIf(this.dateService, function() {
          this.
            start('div').addClass('foam-demos-examples-Controller-status-success').
              add('✓ DateService is available').
            end().
            start('ul').
              start('li').add('Class: ' + self.dateService.cls_.name).end().
              start('li').
                add('MAX_DATE: ').
                add(self.dateService.MAX_DATE ?
                  self.dateService.MAX_DATE.toISOString() :
                  'undefined').
              end().
              start('li').
                add('Supported Formats:').
                start('ul').
                  start('li').add('YYYY-MM-DD, YYYY/MM/DD').end().
                  start('li').add('YYYYMMDD (year 1900-2999)').end().
                  start('li').add('MM-DD-YYYY, MM/DD/YYYY').end().
                  start('li').add('MMDDYYYY').end().
                  start('li').add('YY-MM-DD, YY/MM/DD').end().
                  start('li').add('YYMMDD').end().
                end().
              end().
              start('li').
                add('Available Methods: ').
                add(Object.getOwnPropertyNames(Object.getPrototypeOf(self.dateService))
                  .filter(name => typeof self.dateService[name] === 'function' && name !== 'constructor')
                  .join(', ')).
              end().
            end();
        }).
      end();
    }
  ]
});

add(DateServiceStatus.create());
