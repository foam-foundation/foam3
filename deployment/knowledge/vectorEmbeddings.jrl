3576,0.094746046,-0.019045306,0.0101186065,-0.03345845,-6.11442E-8,-0.0021540031,-0.0029806937,-0.08017412,0.013203925,0.09375474,0.07560995,0.027247794,0.039897263,0.03566898,-0.0016620279,0.066084735,0.09278792,-0.056280956,0.031731717,-0.036491297,-0.02661139,0.03478418,0.062285278,-0.06585764,-0.008702358,0.008538681,0.006045841,-0.02158807,0.09873859,0.050695334,-0.01907788,0.10790422,0.017801668,-0.030461295,0.08951392,-0.05089699,0.050494496,-0.06022029,-0.013054439,1.6721972E-4,0.058039315,0.059429735,-0.009442716,0.050553482,0.085065834,-0.021208469,0.0073393597,-0.021101462,0.018989662,0.023542594,0.0018615678,-0.16107008,-0.004103191,-0.031054022,-0.008836153,-0.0100847855,0.04261938,-0.055769604,0.022624087,-0.020535111,0.021275004,0.04751542,-0.075705506,0.03843929,-0.029388836,0.0601495,-0.06793409,0.119144335,0.019569501]})
