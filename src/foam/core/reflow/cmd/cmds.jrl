p({
  "class":"foam.core.reflow.cmd.Command",
  "id": "perf",
  "description": "Performance capture block",
  "icon": "speed",
  "script": """
    var p = foam.core.reflow.perf.Perf.create({}, this);
    this.out.add(p);
    this.currentBlock.value = p.report;
    p.report$.sub(() => { this.currentBlock.value = p.report; });
   """,
  permissionRequired: true
})

p({"class":"foam.core.reflow.cmd.LoadPerf", "id": "loadPerf", "icon": "speed", linkable: false, permissionRequired: true})
