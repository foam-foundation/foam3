7,-6.291438E-8,-0.074347526,0.056715716,0.03180504,-0.014757927,-0.04948263,0.005952454,0.062270176,0.02771972,0.03173986,0.009299263,-0.043276582,0.059446774,0.003753815,0.01761489,-0.0056807227,0.03818453,0.02307335,0.06044231,-0.0549156,0.014313865,0.023922278,-0.077955306,0.022149581,-0.0040446785,0.05609968,-0.04260233,0.01397629,0.061441153,0.05444944,0.018154595,-0.10666414,0.102500446,-0.021423792,0.022910345,-0.08311761,0.03599317,0.020611834,-0.021664524,0.0077925823,0.056316543,0.035664402,-0.015452018,-0.049622454,-0.010996102,0.06447408,0.04977556,-0.047941588,-0.03481281,-0.021449901,0.0454721,-0.051085904,0.028627152,-0.09178658,0.028697392,0.0108687505,-0.036206864,0.019983135,0.011075347,0.022717694,-0.0432249,0.0022973502,0.03146872,0.13821399,-0.003373941]})
