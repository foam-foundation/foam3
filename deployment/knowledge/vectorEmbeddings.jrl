c({id:"claude:10",text:"6. Actions\nActions are methods with GUI metadata \u2014 label, availability, enablement. Views automatically render them as buttons.\n\njavascript\nactions: [\n  {\n    name: 'submit',\n    label: 'Submit Invoice',\n    isAvailable: function(paid) { return !paid; },   // hides when paid\n    isEnabled:   function(amount) { return amount > 0; },\n    code: function(X) {\n      this.pub('submitted');\n      X.invoiceDAO.put(this);\n    }\n  }\n]\n\n\n---",sourceId:"claude",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.12629494,-0.019930974,-0.086989105,0.040888336,-0.01843647,0.038700927,0.01756619,-0.042865768,0.024877613,0.053142104,0.02200273,0.014549804,-0.086233556,0.02178134,0.0012969641,-0.010969802,0.043639958,-0.13299058,-0.014670982,0.054337397,0.074269235,-0.026898302,0.0145185925,-0.038743123,0.064097926,-0.056171536,-0.03466454,-0.07555309,0.009945596,-0.021082157,0.092888705,-0.02505781,0.04639873,-0.050446734,-0.09066367,0.09660769,0.027861886,-0.059328325,-0.0032230315,-0.059030164,-0.012907217,-0.055079084,-0.04808454,-0.045607712,-0.0057751373,0.031592,0.042836394,0.01794552,-0.03532248,0.061803218,-0.0013922794,-0.035833795,0.00368941,-0.016231943,-0.06438778,-0.03409892,-0.003593237,-0.076193385,0.012074564,0.0125944335,0.04555071,0.037539165,-0.022938216,0.076490685,-0.08471319,0.10754878,0.07557881,-0.08753928,-0.0620589,-0.044435933,0.07177178,9.87916E-4,-0.011475666,-0.0634603,0.02838438,-0.110961005,0.011658026,-0.06464042,-0.068872884,-0.017859736,0.04813949,-0.049643114,-0.08745667,0.059904262,-0.019279666,0.03341792,-5.803441E-4,-0.011653535,0.039912537,0.0052930517,-0.002389318,0.021192495,4.3691887E-4,-0.047505863,-0.0423986,-0.073255435,-0.002148367,0.06465539,-0.046639636,-0.008846942,0.06613288,-7.7185093E-4,0.0026851436,-0.018718535,0.087130144,-0.023247683,0.015158613,-0.08955364,-0.040867798,0.048008066,-0.048782945,-0.0042477027,-0.030432979,-0.04816506,0.057639144,0.036493488,-0.022322195