c({id:"APITesting:0",text:"APITesting\nCovers FOAM's DIG (Data Interchange Gateway) client for API testing: scoped sessions with full server-side DAO access.\n\nKeywords: api testing, dig, sessions, abstractdigtest, knowledge\n\n<flow name=\"APITesting\" category=\"DOC/GUIDE\" spid=\"foam\" description=\"Covers FOAM's DIG (Data Interchange Gateway) client for API testing: scoped sessions with full server-side DAO access.\" keywords=\"api testing,dig,sessions,abstractdigtest,knowledge\"/>",sourceId:"APITesting",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.0750649,0.0047474513,-0.0022940713,-0.004204764,-0.008895725,-0.10539887,-0.01245165,-0.039465267,-0.060715232,-0.005192032,-0.030724429,-0.029060686,0.020349173,0.033260748,0.06338321,0.016619256,0.061360057,-0.003574344,0.08849485,-0.016579075,0.015414082,0.09966398,-0.091896094,-0.043811604,-0.017238079,-0.010221588,-0.020820793,-0.0936973,0.010779735,-0.018117417,0.008023984,0.06798226,-0.12785292,0.042098295,0.022239624,-0.03645452,0.013074793,-0.027558781,0.038374722,0.047569994,0.019690838,-0.031545777,0.010120095,-0.0030905178,7.2774E-4,0.034383073,-0.05162915,0.013872661,-0.015193628,0.03130366,-0.017853992,-0.10123846,0.0057411585,0.054491892,-0.043094862,-0.027199687,-0.002165736,0.007334768,-0.06654366,0.076828204,0.013620714,-0.024000306,-0.021910077,0.0881285,-0.007163147,-0.028574878,-0.0025583531,-0.039171826,0.009221553,-0.13243602,-0.06934012,-0.0028558797,0.017716976,-0.022560628,0.038222764,0.09072933,0.002891362,0.0057144533,0.10848168,-0.07882964,0.014673316,0.147168,0.0256999,0.04199247,-0.047436163,0.07299926,0.081078924,-0.021199236,-0.03977464,-0.011284398,0.04567471,-0.09657084,-0.080989756,-0.018113235,0.034434605,-0.011162455,0.03822393,-0.011561849,-0.01993256,0.03223661,-0.031075636,-0.0029102021,-0.07257773,-0.04393621,-0.030343821,0.012376223,-0.005833785,-0.08390315,0.082556315,0.094229616,-0.05960319,0.040041745,0.0801284,-0.02030461,-2.8937025E-4,-0.035514444,-0