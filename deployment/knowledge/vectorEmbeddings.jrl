c({id:"DaoGotchas:4",text:"Re-homing the object is not a shortcut. Generated setX is literally x = x; (src/foam/java/refinements.js:689) and does not cascade into nested FObjectProperty values, and ContextualizingDAO re-homes only the top object, only on find and put (not select_), and is opt-in through EasyDAO's contextualize flag.\n\n---",sourceId:"DaoGotchas",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[0.015538338,0.005791183,-0.044194184,0.082556866,-0.0110722985,0.037164155,0.043477613,0.009775157,-0.06942804,0.03553076,-0.026055656,-0.091742024,-0.0309862,-0.060971748,0.07309988,0.057021867,0.045643557,-0.046229932,-0.051181614,0.05680882,0.060238767,-0.05642982,0.0023558224,-0.06523025,0.0056255637,0.061324637,0.027411662,0.016190777,0.08853287,-0.019743979,-0.0042742705,0.11395684,-0.01876274,-0.05113318,-0.04843216,0.08385057,0.048281122,-0.008807438,0.04166608,0.028958188,0.018881511,0.07010536,-0.011967832,-0.004966457,-0.039421756,0.035279382,0.01790706,0.028955862,-0.01742059,-0.0144822085,-0.010450539,-0.020763822,0.019453615,-0.022316715,0.030281108,0.13883536,-0.022333352,0.018054321,0.059879795,-0.02016636,-0.0033815883,-0.05123918,0.07297926,0.06807218,0.047095384,-0.045902878,-0.06845414,-0.0740703,-0.031386923,-0.03173965,0.043806415,0.006936889,0.07836112,0.03326664,0.07836475,0.003864267,0.02838468,0.013862334,0.030244406,-0.049264215,0.0124448305,-0.017235443,-0.013984037,0.06891435,0.005174339,0.040416937,0.041121863,-0.062039305,-0.0051765945,0.09246494,0.0026016426,-0.108154304,0.070745215,0.014662528,0.0011566286,-0.04381184,-0.0072359513,-0.0072741886,-0.05563686,-0.043841265,-0.028743846,0.012353327,0.063915886,-0.0015749772,-0.049159843,-0.035176262,-0.028654141,-0.005036294,-0.090505525,0.043694273,-0.087475464,0.09548171,0.05501114,0.002196746,-0.094151735,-0.011695888,-0.038118865,-0.08835403,-0.0036517088,-0.06271274,0.029459449,-0.09302801,-0.012609938,0.041556943,-0.021678854,-0.05425981,-0.031875677,1.875927E-33,