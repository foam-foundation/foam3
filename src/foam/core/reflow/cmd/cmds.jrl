p({
  "class":"foam.core.reflow.cmd.Command",
  "id": "clock",
  "description": "Clock widget",
  "icon": "clock",
  "script": """
    var clock = foam.core.reflow.Clock.create({x:110, y:110}, this);
    this.addValue(clock);
//    this.out.add(clock);
//    this.currentBlock.value = clock;
   """,
   permissionRequired: true
})

p({
  "class":"foam.core.reflow.cmd.Command",
  "id": "api",
  "category": "doc",
  "description": "API documentation for a DAO",
  "icon": "documentation",
  "parserClass": "foam.core.reflow.parser.DAOTargetParser",
  "script": """
    let doc = foam.doc.DIGApiDoc.create({data: args[0]}, this);
    this.addValue(doc);
   """,
   permissionRequired: true
})

p({"class":"foam.core.reflow.cmd.Command", "id": "signature", "description": "Signature block", "icon": "signature", "script": """var s = foam.core.reflow.Signature.create({label: args[0] || ''}, this); this.out.add(s); this.currentBlock.value = s;"""})

p({"class":"foam.core.reflow.cmd.Command", "id": "check", "description": "Checkmark", "icon": "checkmark", "script": """var s = foam.core.reflow.Check.create({label: args[0] || ''}, this); this.out.add(s); this.currentBlock.value = s;""", permissionRequired: true })

p({"class":"foam.core.reflow.cmd.Command", "id": "now", "description": "Now timestamp", "icon": "clock", "script": """var d = new Date(); var holder = foam.lang.DateTimeHolder.create({value: d}); this.currentBlock.value = holder; this.out.add(holder.value$);"""})

p({"class":"foam.core.reflow.cmd.Command", "id": "today", "description": "Today's date", "icon": "calendar", "script": """var d = new Date(); var holder = foam.lang.DateHolder.create({value: d}); this.currentBlock.value = holder; this.out.add(holder.value$.map(d => d.toDateString()));"""})

