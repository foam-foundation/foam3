// ── scripts.jrl ──
// On-demand scripts for the foam.core.ai subsystem.
// Appear under Data Management → Scripts and run via the Run button.

p({
  "class": "foam.core.script.Script",
  "id": "generate-foam-dataset",
  "description": "Submit a FoamDatasetGenerator job. Walks FOAM source paths, chunks files, calls the LLM to produce Alpaca instruction-answer pairs, and stores results in datasetDAO. Progress is visible in Data Management → Jobs.",
  "server": true,
  "language": "BEANSHELL",
  "code": """
    import foam.core.ai.dataset.FoamDatasetGeneratorImpl;
    import foam.dao.DAO;

    String HOME = System.getProperty("user.home");

    // ── Source paths — replace with your project's FOAM source roots ──────
    String[] SOURCE_PATHS = new String[] {
      // HOME + "/github/my-foam-app/src",
      // HOME + "/github/foam3/src/foam/core/ai"
    };
    // ──────────────────────────────────────────────────────────────────────

    int    SAMPLES_PER_CHUNK = 3;
    int    MAX_CHUNK_SIZE    = 2000;
    String LLM_MODEL         = "gpt-4o-mini";
    int    MAX_FILES         = 5;     // 0 = unlimited

    // ── Anonymization — DO NOT COMMIT proprietary names ───────────────────
    // Interleaved literal string/replacement pairs (simple replace, not regex).
    // Edit locally before running; keep this block out of your commits.
    String[] ANON_PATTERNS = new String[] {
      // "MyCompany",      "Example",
      // "mycompany.com",  "example.com"
    };
    // ──────────────────────────────────────────────────────────────────────

    FoamDatasetGeneratorImpl job = new FoamDatasetGeneratorImpl(x);
    job.setSourcePaths(SOURCE_PATHS);
    job.setSamplesPerChunk(SAMPLES_PER_CHUNK);
    job.setMaxChunkSize(MAX_CHUNK_SIZE);
    job.setLlmModel(LLM_MODEL);
    job.setMaxFiles(MAX_FILES);
    job.setAnonymizePatterns(ANON_PATTERNS);

    ((DAO) x.get("jobDAO")).put(job);
    print("Job submitted. Track progress in Data Management → Jobs.");
  """
})
