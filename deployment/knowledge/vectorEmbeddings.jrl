c({id:"i18n:3",text:"Overview\nFOAM's messages: feature provides a built-in internationalization (i18n) system for defining translatable strings within models. Messages are defined as axioms that install properties on classes, resolving to localized strings based on the current locale.",sourceId:"i18n",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[0.030570852,-0.01713662,0.05075268,3.5787787E-5,0.03387802,0.018009562,0.057486337,-0.033635713,0.0091434205,-0.10146464,0.0119945295,-0.06757561,0.038968407,0.06741071,0.020502098,0.019515734,0.08038224,-0.04800112,-0.016068336,-0.020943113,0.08442275,0.122726396,0.019988207,0.07454495,-0.012994182,0.06432993,-0.002521794,-0.0744244,0.011033684,-0.014978898,-0.032810442,0.05973288,0.025687216,0.0142890625,0.013582534,0.056740772,0.011691859,-0.050446622,-0.0015639376,0.007288712,-0.03881942,-0.11333645,0.021984503,-0.03831176,0.081100255,-9.91712E-4,-0.052705795,0.068450384,-0.0382938,0.054107253,0.007972486,-0.07439242,0.0070347306,0.014568635,0.08478935,0.0036779118,0.007616717,0.038336974,-0.013104551,0.021308022,0.011774377,0.02724232,0.008990831,0.08464773,0.039952543,-0.0064297672,0.0030568773,0.07215261,-0.047830552,-0.020266593,-0.07246267,0.017666353,-0.0052123526,0.09939941,-0.011498433,0.083112,0.016413938,-0.0061541926,0.041896712,0.005447483,-0.044361386,-0.009683493,0.08054941,-0.07832709,0.027710963,8.7402464E-4,0.042550344,-0.014947468,-0.020829443,0.020972373,0.025913948,-0.12824947,0.0549309,0.05452342,0.003007689,-0.0431076,-0.030070353,-0.029997732,-0.018488346,0.06193311,-0.042255506,0.03418954,0.056179814,-0.015441474,-0.045149222,-0.041368324,-0.01869998,-0.062346984,0.018048368,-0.020514252,-0.04933566,-0.047930103,0.029059675,-0.02854399,0.040637773,-0.060597345,0.018855978,-0.02243909,0.07239382,-0.06962345,-0.041487906,-0.11008118,0.0092204325,0.009977969,0.008531017,0.039827783,-0.040615678,1.4691166E-33,0.029482173,0.040499773,0.0040448452,0.09327389,0.05513787,-0.02977719,-0.06