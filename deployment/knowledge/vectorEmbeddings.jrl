6,-0.04143007,0.05172979,-0.0038222156,-6.465559E-8,-0.03870724,-0.050160516,0.021586455,0.009289702,0.10794236,-0.030523222,-0.024978656,-0.0129751265,-0.010360853,-0.038173176,0.08506384,0.08296784,0.06599551,-0.06440255,0.048065096,-0.02305004,-0.02484367,-0.036215123,-0.11783397,-0.023966253,0.019322611,-0.007883176,-0.097839154,-0.03061107,0.1281356,0.0035907226,0.0051401258,-0.0018360296,0.07378606,0.08511941,-0.044082604,0.067130096,0.052972585,-0.029936198,-0.005068854,0.0032729474,0.084714875,0.027130187,-0.025916561,0.058560904,0.026436053,0.059662245,-0.013064898,-0.025433728,0.06195551,-0.04088553,0.07794597,-0.051204637,0.07055266,0.034326322,-0.036904555,-0.010304317,-0.0041099037,0.021337857,-0.03903124,-0.04182634,0.0054997858,-0.028762266,0.037990395,-0.0052766395,0.041466273,-0.039144587,0.15404367,0.058983967]})
