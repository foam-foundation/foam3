23436086,0.059186887,-0.0112808095,-0.021286396,-0.017764488,-0.003953101,0.0684537,0.09928553,-0.0065587545,0.014209808,0.015903901,0.018867536,-0.010620436,-0.10324855,0.028552096,-0.01982269,-0.04679917,0.0026380923,-0.0030251697,0.05722165,0.016382445,0.0015604463,0.07159273,0.010090722,0.041048523,-0.095659055,0.011540995,0.04268563,0.060857847,-0.04621407,0.04975533,0.01321309,-0.032444168,0.039054263,0.06111367,0.027474258,-0.070974246,-0.003527636,-0.03995655,0.08715651,0.016984016,-0.088389315,-0.06298069,0.023488928,0.030262372,-0.105027,0.03289157,-0.089297265,0.0010491204,0.05849946,-0.073799536,0.05565852,0.017304793,0.058918122,0.009664114,0.031931274,-0.0141209215,0.043690924,0.035653103]})
