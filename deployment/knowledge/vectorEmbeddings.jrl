c({id:"Actions:3",text:"The metadata does not change how the method works when called programmatically. It only enriches what views can do with it.\n\njavascript\nfoam.CLASS({\n  name: 'Invoice',\n  // ...\n  actions: [\n    {\n      name: 'submit',\n      label: 'Submit Invoice',\n      toolTip: 'Send this invoice to the customer',\n      isAvailable: function(status) { return status === InvoiceStatus.DRAFT; },\n      isEnabled:   function(amount) { return amount > 0; },\n      confirmationRequired: function() { return true; },\n      code: async function(X) {\n        await X.invoiceDAO.put(this);\n      }\n    }\n  ]\n});\n\nThis single declaration replaces a button element, an onClick handler, manual enable/disable toggling, a visibility check, a confirmation dialog, and a running guard \u2014 all of which you would otherwise write by hand at every usage site.",sourceId:"Actions",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.091444485,0.038607743,-0.08724295,0.061610337,-0.055680335,-0.040550247,0.020054894,0.01939571,0.0153941,-0.017772676,0.004502909,0.017021287,-0.05353732,-0.023928413,0.0060180128,0.052653383,0.11305404,-0.17364568,-0.015542484,0.10420936,0.13444012,-0.006363762,0.0211488,0.05928138,0.005797159,-0.047883697,-0.04386756,-0.13449861,0.034662697,-0.020907028,0.07383018,0.04022793,-0.03698452,-0.052264392,-0.076655805,0.096196175,0.0423825,0.019841462,0.047124654,0.0019031869,-0.01141159,-0.063410364,-0.11925547,-0.048284166,0.024803648,-0.06173567,0.046262465,-0.032485105,-0.018227167,0.08850644,-0.01945838,-0.024502287,-0.018431053,0.0012647918,-0.0021931666,-0.011907783,0.06157345,-0.012074671,-0.029882884,-0.017390454,0.026187327,0.043961763,0.0018503993,0.11491007,0.0039005051,0.018100744,0.008469634,-0.08368567,-0.07681999,-0.088821776,0.062115904,0.04450215,0.08141628,0.030432772,0.041127723,-0.017694548,0.05715541,-0.012170656,-0.028280163,-0.030312203,0.07777717,0.032279614,0.0066905734,0.022165483,1.919963E-4,0.031488