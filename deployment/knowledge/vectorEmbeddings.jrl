5154,-0.05666356,0.035543714,0.004948903,-0.049423132,-0.061708067,-5.3758107E-8,0.044593867,-0.083608456,0.007068665,0.06780284,0.0984018,-0.036513817,-0.06994858,0.07417844,0.012067903,-0.05108856,0.060419224,0.12666525,0.065366164,0.006483707,0.05319199,-0.08706386,0.03908151,-0.06147696,-0.1051645,-0.020894539,0.0014432048,-0.020966725,-0.026024338,0.020604035,0.116441384,-0.03078161,0.13000317,0.061336763,0.04170477,0.06869751,-0.03906625,0.058100227,0.07954318,0.10223022,0.06411457,0.015699225,-0.013727122,0.04216443,-0.07516895,0.03856678,0.069135465,0.03355416,0.031311825,0.030386532,0.040162206,0.003045161,-0.0073449975,-0.05240072,0.04967647,-0.01389879,-0.11291175,0.039998718,-0.024194775,0.029393137,-0.037111063,-0.022554806,0.053722747,-0.09370808,0.0027801597,0.043589104,0.02042824,-0.0138205085,0.049214445,0.0067089912]})
