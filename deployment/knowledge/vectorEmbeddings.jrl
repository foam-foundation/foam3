// Modified by admin admin (42) at 2026-10-02T11:20:13.299+0000
c({id:"EmailSystemArchitecture:8",text:"+-----------------------------------------------------------------------------------+\n|                        ChainedPropertyService                                      |\n+-----------------------------------------------------------------------------------+\n|                                                                                   |\n|   EmailMessage (DRAFT)                                                            |\n|        |                                                                          |\n|        v                                                                          |\n|   +----+------------------------------------------+                               |\n|   | 1. ApplyBaseArgumentsEmailPropertyService     |                               |\n|   |    - Sets SPID from user                      |                               |\n|   |    - Loads theme, appConfig, supportConfig    |                               |\n|   |    - Populates templateArgs (logo, appLink,   |                               |\n|   |      supportEmail, hostname, etc.)            |                               |\n|   +-----------------------------------------------+                               |\n|        |                                                                          |\n|        v                                                                          |\n|   +----+------------------------------------------+                               |\n|   | 2. EmailTemplateApplyEmailPropertyService     |                               |\n|   |    - Finds EmailTemplate by name/group/locale |                               |\n|   |    - Applies template to emailMessage         |                               |\n|   |    - Renders body, subject with variables     |                               |\n|   +-----------------------------------------------+                               |\n|        |                                                                          |\n|        v                                                                          |\n|   +----+------------------------------------------+                               |\n|   | 3. GroupEmailTemplateService                  |                               |\n|   |    - Walks group hierarchy for replyTo, from  |                               |\n|   |    - Inherits from parent groups              |                               |\n|   +-----------------------------------------------+                               |\n|        |                                                                          |\n|        v                                                                          |\n|   +----+------------------------------------------+                               |\n|   | 4. EmailConfigEmailPropertyService            |                               |\n|   |    - Loads EmailConfig by SPID                |                               |\n|   |    - Sets replyTo, displayName, from, to      |                               |\n|   +-----------------------------------------------+                               |\n|        |                                                                          |\n|        v                                                                          |\n|   +----+------------------------------------------+                               |\n|   | 5. EmailMessageValidationPropertyService      |                               |\n|   |    - Validates: to, subject, body are set     |                               |\n|   |    - Throws InvalidParameterException if not  |                               |\n|   +-----------------------------------------------+                               |\n|        |                                                                          |\n|        v                                                                          |\n|   EmailMessage (validated, ready for UNSENT)                                      |\n|                                                                                   |\n+-----------------------------------------------------------------------------------+",sourceId:"EmailSystemArchitecture",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.027183313,0.05274512,-0.040623035,0.021514215,0.015288469,-0.001300695,0.059914418,0.03428117,0.01438164,-0.005496058,0.018191746,-0.07834194,0.019901777,-0.06407165,-0.03074351,0.029642563,-0.0027199786,-0.05191415,-0.024394253,-0.011153332,0.026140317,0.061655115,-0.016631927,-0.024842171,0.016610887,0.029709667,-0.041608192,-0.058965925,-0.04646844,-7.072375E-6,0.05670022,0.008826105,-0.046351317,0.03489353,0.029590312,0.05403294,0.054490484,-0.0081763575,-0.03969582,-0.046089936,-0.026800249,0.020581221,-0.04436075,-0.048093677,0.009263794,-0.03527631,-0.06995443,-0.014102177,-0.079622515,0.0077924877,-0.04302223,-0.048827898,-0.030637898,0.0057805497,0.00905334,0.07549753,-0.049237993,0.04479009,0.06111234,-0.0070320875,-0.03763091,-0.013302771,-0.040132858,0.006492135,-0.019873548,-0.06507905,-0.018157743,-0.018603697,0.021229453,-0.043362886,-0.12944771,0.03194882,-0.05990338,0.04103088,0.02090799,0.041392088,-0.0037757426,6.344768E-4,-0.06701075,-0.13025874,0.030052079,0.023991367,-0.092974395,-0.03612355,0.07742481,-0.004852609,-0.03409334,-0.028890546,0.05167052,-0.009098637,-0.035043895,-0.013242087,-0.055276223,-0.003794023,-0.031272534,0.054391105,-0.07255387,0.022583256,-0.06955474,0.1474843,0.022188837,0.014295181,-0.0020878585,0.031742305,0.09282536,-0.031135011,-0.030697908,0.06201668,-0.057536706,0.032889836,0.0021242881,0.0670579,-0.052329823,-0.042545058,0.029821256,-0.03033603,0.08161315,0.003069794,0.028819222,0.06799356,0.062545545,-0.07459942,-0.05113578,0.0036504648,-0.022237282,-0.08256602,0.07734214,1.7901602E-33,-0.008076205,-0.09613474,-0.018959448,0.07688932,0.06504178,0.071988456,0.009387944,0.045245513,0.024049278,-0.0247097