## Linked Date Views
Multiple date inputs linked to the same property - type in any field to update all
--
foam.CLASS({
  name: 'LinkedDateExample',
  extends: 'foam.u2.Controller',

  properties: [
    {
      class: 'Date',
      name: 'sharedDate',
      label: 'Shared Date',
      value: new Date('2024-03-15')
    }
  ],

  methods: [
    function render() {
      this.addClass().start().
        start('h4').add('All inputs below share the same date property').end().
        start('p').add('Type in any field and watch all fields update!').end().
        br().

        start('div').style({padding: '10px', background: '#f0f0f0', margin: '5px 0'}).
          start('label').add('Date View 1: ').end().
          tag(foam.u2.view.DateView, {data$: this.sharedDate$}).
        end().

        start('div').style({padding: '10px', background: '#f5f5f5', margin: '5px 0'}).
          start('label').add('Date View 2: ').end().
          tag(foam.u2.view.DateView, {data$: this.sharedDate$}).
        end().

        start('div').style({padding: '10px', background: '#f0f0f0', margin: '5px 0'}).
          start('label').add('Date View 3: ').end().
          tag(foam.u2.view.DateView, {data$: this.sharedDate$}).
        end().

        br().
        start('div').style({padding: '10px', background: '#e8f4f8', border: '1px solid #b3d9e6'}).
          start('strong').add('Current Value: ').end().
          add(this.sharedDate$.map(d => d ? d.toLocaleDateString('en-US', {
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          }) : 'No date selected')).
        end().
      end();
    }
  ]
});

add(LinkedDateExample.create());

## Linked DateTime Views
Multiple datetime inputs linked to the same property - type in any field to update all
--
foam.CLASS({
  name: 'LinkedDateTimeExample',
  extends: 'foam.u2.Controller',

  properties: [
    {
      class: 'DateTime',
      name: 'sharedDateTime',
      label: 'Shared DateTime',
      value: new Date()
    }
  ],

  methods: [
    function render() {
      this.addClass().start().
        start('h4').add('All inputs below share the same datetime property').end().
        start('p').add('Type in any field and watch all fields update!').end().
        br().

        start('div').style({padding: '10px', background: '#f0f0f0', margin: '5px 0'}).
          start('label').add('DateTime View 1: ').end().
          tag(foam.u2.view.DateTimeView, {data$: this.sharedDateTime$}).
        end().

        start('div').style({padding: '10px', background: '#f5f5f5', margin: '5px 0'}).
          start('label').add('DateTime View 2: ').end().
          tag(foam.u2.view.DateTimeView, {data$: this.sharedDateTime$}).
        end().

        start('div').style({padding: '10px', background: '#f0f0f0', margin: '5px 0'}).
          start('label').add('DateTime View 3: ').end().
          tag(foam.u2.view.DateTimeView, {data$: this.sharedDateTime$}).
        end().

        br().
        start('div').style({padding: '10px', background: '#e8f4f8', border: '1px solid #b3d9e6'}).
          start('strong').add('Current Value: ').end().
          add(this.sharedDateTime$.map(d => d ? d.toLocaleString('en-US', {
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit'
          }) : 'No datetime selected')).
        end().
      end();
    }
  ]
});

add(LinkedDateTimeExample.create());

## MultiView for Dates
