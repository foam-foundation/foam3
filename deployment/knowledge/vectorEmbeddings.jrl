,-0.0010820576,-0.0070349122,0.009006622,0.034825113,0.15695782,-0.027509825,-0.027744487,0.065813564,-0.041884385,-0.023540946,0.08640242,0.031493995,-0.004017871,0.06073995,0.036557674,-0.0767694,-0.0210555,-0.027985035,-0.10607759,-0.012848533,-0.034685727,-0.019461846,-0.031665888,0.015597105,0.017847138,-0.022032728,0.13712652,-0.03439584,0.013071296,0.08338249,-0.012728329,-0.008832867,0.07955013,0.12232634,-0.023389997,0.029352793,0.076215275,0.07815285,-0.05665255,0.001336795,0.0020540764,-0.006378925,0.029201899,-0.0055047874,0.039068606,0.011796939,-0.08855036,0.008759135,0.09976058,-0.04433624,-0.06500725,-0.020914542,-0.081732586,-0.023795526,-0.024254944,-0.02500957,0.021882953,-0.028249845,0.08012279,0.07295292,0.09397333,-0.039187163,0.0017860804,0.07208557]})
