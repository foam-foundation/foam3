1778968,-0.04356709,-0.007373402,-0.076575644,-0.014216612,0.028853038,-0.05874825,0.06798082,0.0012336456,0.019534437,-0.050485305,0.02234827,0.02414048,0.055460773,0.07201649,-0.11125686,0.069062956,0.05233812,-0.040572222,0.059964553,0.030230742,0.04908734,0.02744284,0.018976467,0.052838948,-0.041670658,-0.046986688,-0.06231845,-0.023693886,0.11006692,-0.07256225,-0.012042866,-0.015553612,0.041171763,0.013373199,0.007257044,0.031294666,-0.033866413,0.0063814623,0.005322693,-0.052112095,-0.014020964,0.02237964,0.0030229376,-0.017209526,0.079095915,0.04204954,0.0974023,0.0030071354]})
