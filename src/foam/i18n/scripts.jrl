p({
  "class": "foam.core.script.Script",
  "id": "ExtractStringAxiom",
  "description": "get all String axiom to translate them",
  "server": false,
  "code": """
  let used = Object.values(foam.USED)
  let objs = used.concat(Object.values(foam.UNUSED))
  let locales = [];
  // One-time seeding script: rerunning can overwrite reviewed translations
  // because Locale ids are locale + variant + source + themeId.
  // TODO: Skip existing localeDAO rows before writing so this can be rerun safely.
  // Match the enabled Language row so TranslationConsole can load these rows
  // when users select plain French. fr-CA requires an enabled fr-CA Language.
  let targetLocale = 'fr';
  let targetVariant = '';
  let targetLocaleVariant = 'fr';

  let putLocale = xl => {
    locales.push(xl);
  }

  // Raw model specs can include __copyFrom__ entries without name; derive or skip safely.
  let constantizeAxiomName = a => {
    if ( ! a ) return;
    if ( typeof a.name === 'string' && a.name ) return foam.String.constantize(a.name);
    if ( typeof a.__copyFrom__ === 'string' && a.__copyFrom__ ) {
      let parts = a.__copyFrom__.split('.');
      return parts[parts.length - 1];
    }
  }

  objs.forEach(o => {
    !!o.messages && o.messages.forEach(m => {
      let mName = constantizeAxiomName(m);
      if ( ! mName ) return;
      let xl = foam.i18n.Locale.create({
        "id": o.id+'.'+mName,
        "locale": targetLocale,
        "variant": targetVariant,
        "locale_variant": targetLocaleVariant,
        "source": o.id+'.'+mName,
        "target": m.message+' fr',
      })
      putLocale(xl);
    })

    !!o.properties && o.properties.forEach(p => {
      let pName = constantizeAxiomName(p);
      if ( ! pName ) return;
      if ( !!p.label && typeof p.label != "object" ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.'+pName+'.label',
          "locale": targetLocale,
          "variant": targetVariant,
          "locale_variant": targetLocaleVariant,
          "source": o.id+'.'+pName+'.label',
          "target": p.label+' fr',
        })
        putLocale(xl);
      }

      if ( !!!p.label && !!p.name && ( p.class != "foam.lang.Enum" && p.class != "Enum") ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.'+pName+'.label',
          "locale": targetLocale,
          "variant": targetVariant,
          "locale_variant": targetLocaleVariant,
          "source": o.id+'.'+pName+'.label',
          "target": p.name+' fr',
        })
        putLocale(xl);
      }
      if ( !!p.value && typeof p.value !== 'function' && p.name !== 'slashReplacement' && p.name !== 'code' && typeof p.value !== 'object' && ( p.class != "foam.lang.Enum" && p.class != "Enum")  ) { //not for object
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.'+pName+'.value',
          "locale": targetLocale,
          "variant": targetVariant,
          "locale_variant": targetLocaleVariant,
          "source": o.id+'.'+pName+'.value',
          "target": p.value+' fr',
        })
        putLocale(xl);
      }
      if ( !!p.documentation ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.'+pName+'.documentation',
          "locale": targetLocale,
          "variant": targetVariant,
          "locale_variant": targetLocaleVariant,
          "source": o.id+'.'+pName+'.documentation',
          "target": p.documentation+' fr',
        })
        putLocale(xl);
      }
      if ( !!p.placeholder ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.'+pName+'.placeholder',
          "locale": targetLocale,
          "variant": targetVariant,
          "locale_variant": targetLocaleVariant,
          "source": o.id+'.'+pName+'.placeholder',
          "target": p.placeholder+' fr',
        })
        putLocale(xl);
      }

      if ( !!p.view && !!p.view.placeholder  ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.'+pName+'.view.placeholder',
          "locale": targetLocale,
          "variant": targetVariant,
          "locale_variant": targetLocaleVariant,
          "source": o.id+'.'+pName+'.view.placeholder',
          "target": p.view.placeholder+' fr',
        })
        putLocale(xl);
      }
      if ( !!p.view && !!p.view.label ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.'+pName+'.view.label',
          "locale": targetLocale,
          "variant": targetVariant,
          "locale_variant": targetLocaleVariant,
          "source": o.id+'.'+pName+'.view.label',
          "target": p.view.label+' fr',
        })
        putLocale(xl);
      }
    })

    !!o.sections && !!o.sections.forEach(m => {
      let mName = constantizeAxiomName(m);
      if ( ! mName ) return;
      if ( !!m.title ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.SECTION_'+mName+'.title',
          "locale": targetLocale,
          "variant": targetVariant,
          "locale_variant": targetLocaleVariant,
          "source": o.id+'.SECTION_'+mName+'.title',
          "target": m.title+' fr',
        })
        putLocale(xl);
      }
      if ( !!m.subTitle ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.SECTION_'+mName+'.subTitle',
          "locale": targetLocale,
          "variant": targetVariant,
          "locale_variant": targetLocaleVariant,
          "source": o.id+'.SECTION_'+mName+'.subTitle',
          "target": m.subTitle+' fr',
        })
        putLocale(xl);
      }
    })

    !!o.actions && o.actions.forEach(p => {
      let pName = constantizeAxiomName(p);
      if ( ! pName ) return;
      if ( !!p.label ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.'+pName+'.label',
          "locale": targetLocale,
          "variant": targetVariant,
          "locale_variant": targetLocaleVariant,
          "source": o.id+'.'+pName+'.label',
          "target": p.label+' fr',
        })
        putLocale(xl);
      }

      if ( !!!p.label && !!p.name ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.'+pName+'.label',
          "locale": targetLocale,
          "variant": targetVariant,
          "locale_variant": targetLocaleVariant,
          "source": o.id+'.'+pName+'.label',
          "target": p.name+' fr',
        })
        putLocale(xl);
      }
    })
  })
  // Write sequentially to avoid flooding the browser with localeDAO POSTs.
  for ( let xl of locales ) await x.localeDAO.put(xl);
  """
})

p({
  "class": "foam.core.script.Script",
  "id": "extractMenuFromJournal",
  "lastRun": 1593184732391,
  "lastDuration": 18,
  "server": false,
  "code": """
  // One-time seeding script: rerunning can overwrite reviewed translations.
  // TODO: Skip existing localeDAO rows before writing so this can be rerun safely.
  // Match ExtractStringAxiom and the enabled plain French Language row.
  let targetLocale = 'fr';
  let targetVariant = '';
  let targetLocaleVariant = 'fr';
  let locales = [];

  let putLocale = xl => {
    locales.push(xl);
  }

  await x.menuDAO.select(function(m) {

    let l = foam.i18n.Locale.create({
      "id": m.id+'.label',
      "locale": targetLocale,
      "variant": targetVariant,
      "locale_variant": targetLocaleVariant,
      "source": m.id+'.label',
      "target": m.label +' fr'
    });
    putLocale(l);

    if ( m.handler && m.handler.title ){
      let l2 = foam.i18n.Locale.create({
        "id": m.id+'.handler.title',
        "locale": targetLocale,
        "variant": targetVariant,
        "locale_variant": targetLocaleVariant,
        "source": m.id+'.handler.title',
        "target": m.handler.title +' fr'
      });
      putLocale(l2);
    }

    if ( m.handler && m.handler.subtitle ){
      let l2 = foam.i18n.Locale.create({
        "id": m.id+'.handler.subtitle',
        "locale": targetLocale,
        "variant": targetVariant,
        "locale_variant": targetLocaleVariant,
        "source": m.id+'.handler.subtitle',
        "target": m.handler.subtitle +' fr'
      });
      putLocale(l2);
    }

    if ( m.handler && m.handler.config ) {
      if ( m.handler.config.browseTitle ) {
        let l2 = foam.i18n.Locale.create({
          "id": m.id+'.handler.config.browseTitle',
          "locale": targetLocale,
          "variant": targetVariant,
          "locale_variant": targetLocaleVariant,
          "source": m.id+'.handler.config.browseTitle',
          "target": m.handler.config.browseTitle +' fr'
        });
        putLocale(l2);
      }
      if ( m.handler.config.browseSubtitle ) {
        let l2 = foam.i18n.Locale.create({
          "id": m.id+'.handler.config.browseSubtitle',
          "locale": targetLocale,
          "variant": targetVariant,
          "locale_variant": targetLocaleVariant,
          "source": m.id+'.handler.config.browseSubtitle',
          "target": m.handler.config.browseSubtitle +' fr'
        });
        putLocale(l2);
      }
      if ( m.handler.config.createTitle ) {
        let l2 = foam.i18n.Locale.create({
          "id": m.id+'.handler.config.createTitle',
          "locale": targetLocale,
          "variant": targetVariant,
          "locale_variant": targetLocaleVariant,
          "source": m.id+'.handler.config.createTitle',
          "target": m.handler.config.createTitle +' fr'
        });
        putLocale(l2);
      }
    }
  });
  // Write sequentially to avoid flooding the browser with localeDAO POSTs.
  for ( let xl of locales ) await x.localeDAO.put(xl);
""",
  "output": "",
  "notes": "",
  "lastModifiedBy": 1348
})
p({
  "class": "foam.core.script.Script",
  "id": "ExtractStringAxiomPerPackage",
  "description":"get all String axiom to translate them per package",
  "server": false,
  "code": """
  let used = Object.values(foam.USED)
  let objs = used.concat(Object.values(foam.UNUSED))
  let msg  = '';
  let package = 'some.package';

  objs = used.filter(p => p.package == package)

  objs.forEach(o => {
    !!o.messages && o.messages.forEach(m => {console.log(objs+'mm')
      let xl = foam.i18n.Locale.create({
        "id": o.id+'.'+foam.String.constantize(m.name),
        "locale": 'pt',
        "variant": 'PT',
        "locale_variant": 'pt-PT',
        "source": o.id+'.'+foam.String.constantize(m.name),
        "target": m.message+' pt',
      })
      x.localeDAO.put(xl);
      msg+= m.message+'\\n';
    })

    !!o.properties && o.properties.forEach(p => {
      if ( !!p.label && typeof p.label != "object" ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.'+foam.String.constantize(p.name)+'.label',
          "locale": 'pt',
          "variant": 'PT',
          "locale_variant": 'pt-PT',
          "source": o.id+'.'+foam.String.constantize(p.name)+'.label',
          "target": p.label+' pt',
        })
        x.localeDAO.put(xl);
        msg+= p.label+'\\n';
      }

      if ( !!!p.label && !!p.name && ( p.class != "foam.lang.Enum" && p.class != "Enum") ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.'+foam.String.constantize(p.name)+'.label',
          "locale": 'pt',
          "variant": 'PT',
          "locale_variant": 'pt-PT',
          "source": o.id+'.'+foam.String.constantize(p.name)+'.label',
          "target": p.name+' pt',
        })
        x.localeDAO.put(xl);
        msg+= p.name+'\\n';
      }
      if ( !!p.value && typeof p.value !== 'function' && p.name !== 'slashReplacement' && p.name !== 'code' && typeof p.value !== 'object' && ( p.class != "foam.lang.Enum" && p.class != "Enum")  ) { //not for object
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.'+foam.String.constantize(p.name)+'.value',
          "locale": 'pt',
          "variant": 'PT',
          "locale_variant": 'pt-PT',
          "source": o.id+'.'+foam.String.constantize(p.name)+'.value',
          "target": p.value+' pt',
        })
        x.localeDAO.put(xl);
        msg+= p.value+'\\n';
      }
      if ( !!p.documentation ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.'+foam.String.constantize(p.name)+'.documentation',
          "locale": 'pt',
          "variant": 'PT',
          "locale_variant": 'pt-PT',
          "source": o.id+'.'+foam.String.constantize(p.name)+'.documentation',
          "target": p.documentation+' pt',
        })
        x.localeDAO.put(xl);
        msg+= p.documentation+'\\n';
      }
      if ( !!p.placeholder ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.'+foam.String.constantize(p.name)+'.placeholder',
          "locale": 'pt',
          "variant": 'PT',
          "locale_variant": 'pt-PT',
          "source": o.id+'.'+foam.String.constantize(p.name)+'.placeholder',
          "target": p.placeholder+' pt',
        })
        x.localeDAO.put(xl);
        msg+= p.placeholder+'\\n';
      }

      if ( !!p.view && !!p.view.placeholder  ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.'+foam.String.constantize(p.name)+'.view.placeholder',
          "locale": 'pt',
          "variant": 'PT',
          "locale_variant": 'pt-PT',
          "source": o.id+'.'+foam.String.constantize(p.name)+'.view.placeholder',
          "target": p.view.placeholder+' pt',
        })
        x.localeDAO.put(xl);
        msg+= p.view.placeholder+'\\n';
      }
      if ( !!p.view && !!p.view.label ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.'+foam.String.constantize(p.name)+'.view.label',
          "locale": 'pt',
          "variant": 'PT',
          "locale_variant": 'pt-PT',
          "source": o.id+'.'+foam.String.constantize(p.name)+'.view.label',
          "target": p.view.label+' pt',
        })
        x.localeDAO.put(xl);
        msg+= p.view.label+'\\n';
      }
    })

    !!o.sections && !!o.sections.forEach(m => {
      if ( !!m.title ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.SECTION_'+foam.String.constantize(m.name)+'.title',
          "locale": 'pt',
          "variant": 'PT',
          "locale_variant": 'pt-PT',
          "source": o.id+'.SECTION_'+foam.String.constantize(m.name)+'.title',
          "target": m.title+' pt',
        })
        x.localeDAO.put(xl);
        msg+= m.title+'\\n';
      }
      if ( !!m.subTitle ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.SECTION_'+foam.String.constantize(m.name)+'.subTitle',
          "locale": 'pt',
          "variant": 'PT',
          "locale_variant": 'pt-PT',
          "source": o.id+'.SECTION_'+foam.String.constantize(m.name)+'.subTitle',
          "target": m.subTitle+' pt',
        })
        x.localeDAO.put(xl);
        msg+= m.subTitle+'\\n';
      }
    })

    !!o.actions && o.actions.forEach(p => {
      if ( !!p.label ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.'+foam.String.constantize(p.name)+'.label',
          "locale": 'pt',
          "variant": 'PT',
          "locale_variant": 'pt-PT',
          "source": o.id+'.'+foam.String.constantize(p.name)+'.label',
          "target": p.label+' pt',
        })
        x.localeDAO.put(xl);
        msg+= p.label+'\\n';
      }

      if ( !!!p.label && !!p.name ) {
        let xl = foam.i18n.Locale.create({
          "id": o.id+'.'+foam.String.constantize(p.name)+'.label',
          "locale": 'pt',
          "variant": 'PT',
          "locale_variant": 'pt-PT',
          "source": o.id+'.'+foam.String.constantize(p.name)+'.label',
          "target": p.name+' pt',
        })
        x.localeDAO.put(xl);
        msg+= p.name+'\\n';
      }
    })
  })
  console.log(msg)
  """
})
