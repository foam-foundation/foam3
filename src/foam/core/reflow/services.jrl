p({
  "class": "foam.core.boot.CSpec",
  "name": "consoleZACClient",
  "authenticate": false,
  "lazyClient": true,
  "serve": true,
  "client":"""{"class":"foam.core.reflow.ConsoleZACClient"}"""
})

p({
  "class": "foam.core.boot.CSpec",
  "name": "modelDAO",
  "authenticate": false,
  "authNotes": "Client only, used for documentation",
  "lazyClient": true,
  "serve": true,
  "client":"""{"class":"foam.core.reflow.ModelDAO"}"""
})

p({
  "class":"foam.core.boot.CSpec",
  "name":"localFlowHistoryDAO",
  "description": "Flow edit history storage. One journal per flow under flowHistory/, replayed the first time that flow's history is queried. Written by the flowDAO history rule.",
  "serviceScript":
  """
    foam.core.partition.PartitionedDAO dao = new foam.core.partition.PartitionedDAO(
      x,
      foam.core.reflow.FlowHistoryRecord.getOwnClassInfo(),
      "flowHistory/",
      foam.core.reflow.FlowHistoryRecord.OBJECT_ID);
    // Load-progress rows are keyed by the served name the client queries.
    dao.setServiceName("flowHistoryDAO");
    return dao;
  """
})

p({
  "class":"foam.core.boot.CSpec",
  "name":"flowHistoryDAO",
  "description": "Flow edit history as served to clients; a record is readable by whoever can read its flow.",
  "serve":true,
  "authenticate":false,
  "serviceScript":
  """
    return new foam.dao.EasyDAO.Builder(x)
      .setPm(true)
      .setOf(foam.core.reflow.FlowHistoryRecord.getOwnClassInfo())
      .setInnerDAO(x.get("localFlowHistoryDAO"))
      .setRuler(false)
      .build();
  """,
  "client":"""{"of":"foam.core.reflow.FlowHistoryRecord"}"""
})

p({
  "class":"foam.core.boot.CSpec",
  "name":"flowDAO",
  "description": "Stores FLOWs.",
  "serve":true,
  "authenticate":false,
  "serviceScript":
  """
    return new foam.dao.EasyDAO.Builder(x)
      .setPm(true)
      .setNdiff(true)
      .setJournalType(foam.dao.JournalType.SINGLE_JOURNAL)
      .setJournalName("flows")
      .setOf(foam.core.reflow.Flow.getOwnClassInfo())
      .setRuler(true)
      .build();
  """,
  "client":"""{"of":"foam.core.reflow.Flow"}"""
})

p({
  "class": "foam.core.boot.CSpec",
  "name": "agentDAO",
  "description": "Stores Reflow SinkView Agents",
  "serve":true,
  "authenticate":false,
  "serviceScript":`
    return new foam.dao.EasyDAO.Builder(x)
      .setPm(true)
      .setAuthorize(true)
      .setJournalType(foam.dao.JournalType.SINGLE_JOURNAL)
      .setJournalName("agents")
      .setOf(foam.core.reflow.SinkAgent.getOwnClassInfo())
      .build();
    `,
  "client":"""
    {
      "of":"foam.core.reflow.SinkAgent",
      "cache":true,
      "ttlSelectPurgeTime": 0,
      "ttlPurgeTime": 0
    }
  """
})


p({
  "class": "foam.core.boot.CSpec",
  "name": "toolbarControlDAO",
  "description": "Stores Reflow Toolbar Controls",
  "serve":true,
  "authenticate":false,
  "serviceScript":`
    return new foam.dao.EasyDAO.Builder(x)
      .setPm(true)
      .setAuthorize(true)
      .setJournalType(foam.dao.JournalType.SINGLE_JOURNAL)
      .setJournalName("controls")
      .setOf(foam.core.reflow.ToolbarControl.getOwnClassInfo())
      .build();
    `,
  "client":"""
    {
      "of":"foam.core.reflow.ToolbarControl",
      "cache":true,
      "ttlSelectPurgeTime": 0,
      "ttlPurgeTime": 0
    }
  """
})
