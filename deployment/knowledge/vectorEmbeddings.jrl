365137,-0.01596622,-0.02016259,-0.013321257,0.04786758,0.01398669,-0.05886056,-4.8992646E-8,-0.076999374,-0.027316,0.0024445436,0.018278254,-0.004913221,-0.042730812,0.02786669,-0.014103181,-0.06744916,-0.032334857,0.039374124,0.12128626,-0.04656828,-0.0024362146,0.016103512,-0.034738652,0.027549706,0.06841066,-0.058380976,-0.002107759,0.021606408,-0.043072373,-0.033642627,0.053688314,0.08243403,0.011902004,-0.038402364,0.018259628,0.07678882,0.081917256,0.0063954517,0.014881737,0.072312124,0.039406866,-0.020054376,-0.07367456,0.036785923,-0.017485315,0.015361563,0.10981981,0.103844866,-0.01841695,-0.049311783,0.025658391,0.011357823,0.020177163,0.022456743,-0.07462916,0.09355265,0.031542916,-0.06289075,-0.07129872,-0.014130651,-0.02558862,-0.02105325,0.022712547,0.05227904,0.015399851,-0.017203445,0.0076821446,0.07208495,0.0055267964,0.0044951052,0.045834582]})
