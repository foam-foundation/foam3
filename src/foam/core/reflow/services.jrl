p({
  "class": "foam.core.boot.CSpec",
  "name": "consoleZACClient",
  "authenticate": false,
  "lazyClient": true,
  "serve": true,
  "client":"""{"class":"foam.core.reflow.ConsoleZACClient"}"""
})

p({
  "class": "foam.core.boot.CSpec",
  "name": "modelDAO",
  "authenticate": false,
  "authNotes": "Client only, used for documentation",
  "lazyClient": true,
  "serve": true,
  "client":"""{"class":"foam.core.reflow.ModelDAO"}"""
})

p({
  "class":"foam.core.boot.CSpec",
  "name":"flowHistoryDAO",
  "description": "In-memory history of FLOW changes; rebuilt from flows journal replay on each startup.",
  "serve":true,
  "authenticate":false,
  "serviceScript":
  """
    // In-memory MDAO with auto-assigned seqNo so HistoryRecord's composite id
    // (objectId + seqNo) stays unique across multiple edits of the same flow.
    foam.dao.DAO mdao = new foam.dao.MDAO(foam.dao.history.HistoryRecord.getOwnClassInfo());
    return new foam.dao.SequenceNumberDAO.Builder(x)
      .setDelegate(mdao)
      .setProperty("seqNo")
      .build();
  """,
  "client":"""{"of":"foam.dao.history.HistoryRecord"}"""
})

p({
  "class":"foam.core.boot.CSpec",
  "name":"flowDAO",
  "description": "Stores FLOWs.",
  "serve":true,
  "authenticate":false,
  "serviceScript":
  """
    // Wrap HistoryDAO inside the journal so replay produces history records.
    foam.dao.DAO historyMdao = (foam.dao.DAO) x.get("flowHistoryDAO");
    foam.dao.MDAO flowMdao = new foam.dao.MDAO(foam.core.reflow.Flow.getOwnClassInfo());
    foam.dao.DAO historyWrappedMdao = new foam.dao.history.HistoryDAO(x, historyMdao, flowMdao);

    return new foam.dao.EasyDAO.Builder(x)
      .setPm(true)
      .setNdiff(true)
      .setMdao(historyWrappedMdao)
      .setJournalType(foam.dao.JournalType.SINGLE_JOURNAL)
      .setJournalName("flows")
      .setOf(foam.core.reflow.Flow.getOwnClassInfo())
      .setRuler(true)
      .build();
  """,
  "client":"""{"of":"foam.core.reflow.Flow"}"""
})

p({
  "class": "foam.core.boot.CSpec",
  "name": "agentDAO",
  "description": "Stores Reflow SinkView Agents",
  "serve":true,
  "authenticate":false,
  "serviceScript":`
    return new foam.dao.EasyDAO.Builder(x)
      .setPm(true)
      .setAuthorize(true)
      .setJournalType(foam.dao.JournalType.SINGLE_JOURNAL)
      .setJournalName("agents")
      .setOf(foam.core.reflow.SinkAgent.getOwnClassInfo())
      .build();
    `,
  "client":"""
    {
      "of":"foam.core.reflow.SinkAgent",
      "cache":true,
      "ttlSelectPurgeTime": 0,
      "ttlPurgeTime": 0
    }
  """
})


p({
  "class": "foam.core.boot.CSpec",
  "name": "toolbarControlDAO",
  "description": "Stores Reflow Toolbar Controls",
  "serve":true,
  "authenticate":false,
  "serviceScript":`
    return new foam.dao.EasyDAO.Builder(x)
      .setPm(true)
      .setAuthorize(true)
      .setJournalType(foam.dao.JournalType.SINGLE_JOURNAL)
      .setJournalName("controls")
      .setOf(foam.core.reflow.ToolbarControl.getOwnClassInfo())
      .build();
    `,
  "client":"""
    {
      "of":"foam.core.reflow.ToolbarControl",
      "cache":true,
      "ttlSelectPurgeTime": 0,
      "ttlPurgeTime": 0
    }
  """
})
