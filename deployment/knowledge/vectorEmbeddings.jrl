c({id:"VsSpring:2",text:"Core Philosophy\nFOAM is a model-driven, cross-language framework where you define declarative models that generate code for multiple platforms (JavaScript, Java, Swift) 1 . The framework centers on foam.CLASS() definitions that describe properties, methods, and behaviors 2 .\n\nSpring Boot is a convention-over-configuration Java framework built on dependency injection and annotations. It focuses on rapid application development with auto-configuration and embedded servers.",sourceId:"VsSpring",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.011720934,-0.050457776,-0.07622365,-0.04638838,0.09636896,-0.010349358,-0.028621195,0.01086395,-0.057724763,-0.055597994,0.0052304296,0.011872369,0.05249269,0.008223167,0.037090812,-0.029253764,0.053153083,-0.06699997,0.031822633,0.057626493,0.031436246,0.05375359,-0.06039011,0.061861347,-0.040566828,0.08169143,-0.016115258,-0.092739604,-0.018271523,-0.03601728,0.019795023,0.07104767,-0.0068748845,-0.020364778,-0.011445429,0.0556477,0.05210814,-0.033172898,-0.031064501,-0.018014142,-0.10529897,-0.07156994,0.021802895,-0.017800815,0.0803575,0.020762647,-0.046372198,-0.03081436,-0.0097832475,-0.021795675,0.0073790294,-0.122485206,-0.02478851,-0.05478284,0.028002562,0.063577555,0.038764153,0.046799574,-0.053348493,-0.010005921,0.04581023,-0.008076947,-0.013893764,0.12441866,0.079271674,-0.04308308,0.016939035,0.0014453884,0.020717222,-0.10615723,-0.028617438,-0.046567023,0.08384297,-0.015504064,-0.03543045,0.067669526,-0.016025493,0.048763525,0.050065804,-0.012758675,-0.040291686,0.11790053,0.056957953,-0.038331598,-0.02117043,0.045417383,0.08510055,-0.036088448,-0.01403363,0.04037746,0.024630185,-0.038342033,0.016381556,0.023694267,-0.08024838,0.040814877,-0.059863724,-0.033566196,-0.038657054,0.03931257,-0.0654564,0.033560824,0.070613876,-0.005178695,0.02608725,-0.05705187,-0.042261582,2.1410536E-4,0.023120508,0.015742501,-0.060394328,-2.9068967E-4,-0.01870933,-0.0013238845,0.09096809,-0.0