57,0.0010711938,-0.12047282,0.029236486,0.03367153,-0.0072709555,-0.062313963,-0.05264887,-0.029832423,-0.0023070471,0.008930802,0.045260254,0.011869493,-0.06467589,-0.01621821,0.10931723,0.041577537,-0.019968146,-0.0476847,0.07616532,0.15788019,0.018959964,-0.07042799,0.031018093,-4.6573288E-4,-0.0501883,0.030101694,0.0052925353,0.071395636,-0.065226704,0.0042852955,0.042156965,-0.07502553,-0.034249756,0.02359127,-0.06519528,0.01936542,-0.04451095,-0.051944587,0.09872469,0.08505225,0.030400217,0.08093462,0.0023941598]})
