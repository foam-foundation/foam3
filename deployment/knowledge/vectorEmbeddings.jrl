3,-0.04935266,-0.032939967,0.022403175,0.07781951,-0.00564106,0.048739295,-0.014811703,0.12114924,-0.048167236,0.036376644,0.0023285043,-1.0938991E-4,0.06806209,-0.0492878,-0.04939239,0.043433435,-0.0068968753,-0.1032446,-0.006323386,0.013519986,0.12280855,-0.04608589,0.03798772,0.0786726,0.07858493,0.069853485,-0.036484774,0.024262851,-0.013854798,0.07804202,0.038577445,-0.036986552,-0.02162838,-0.006134736,-0.010987305,0.03567125,1.416802E-4,-0.0013598332,-0.08963018,-0.016913505,0.108779326,0.03926075,4.6633874E-4,-0.07343798,0.009967218,0.08359261,-0.06012968,-0.044395994,4.2876718E-4,-0.035450965,-0.0037268947,-0.032051284,0.008647414,-0.051561493,0.074879244,-0.0439979,0.03880946,-0.0061040814,0.007023341,0.026722142]})
