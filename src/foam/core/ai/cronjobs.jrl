// Embeds the records that EmbeddingAwareDAO marked NEW or DIRTY since the last run, at most
// embeddingSync's batchSize (50) AI calls per run. After a restart every record is NEW, and
// one whose stored chunks still hold its text is marked embedded with no AI call.
p({
  "class": "foam.core.cron.Cron",
  "id": "embeddingSync",
  "description": "Embed the records of EmbeddingAware DAOs that changed, for Ask AI",
  "schedule": {
    "class": "foam.core.cron.IntervalSchedule",
    "duration": {
      "class": "foam.core.cron.TimeHMS",
      "minute": 5
    }
  },
  "code": """
    ((foam.ai.vector.EmbeddingSync) x.get("embeddingSync")).sync(x);
  """
})
