// Transformers.js: dynamic import() triggers both script-src and connect-src for the CDN URL
p({class:"foam.core.http.csp.CSPDirective",name:"script-src",key:"knn-transformers",value:"https://cdn.jsdelivr.net/npm/@xenova/transformers@2.17.2/dist/transformers.min.js"})
// Model weights are fetched from HuggingFace and their AWS CDN mirrors at runtime
p({class:"foam.core.http.csp.CSPDirective",name:"connect-src",key:"knn-transformers",value:"https://cdn.jsdelivr.net https://huggingface.co https://*.huggingface.co https://*.hf.co"})
// Transformers.js spawns inference workers as blob: URLs
p({class:"foam.core.http.csp.CSPDirective",name:"worker-src",key:"knn-transformers",value:"blob:"})
