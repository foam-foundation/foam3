094745,-0.014641389,0.050331622,0.09006872,0.012001661,-0.053730547,-5.5378003E-8,-0.0470779,0.024450418,-0.019881658,0.010094238,0.00934192,-0.010431826,-0.014648465,0.019545468,-0.02719044,-0.026555248,0.027182966,0.10127229,-0.063879415,0.059792474,0.009614627,-0.009524081,0.0041788467,0.046040114,-0.07484683,-0.009223183,0.015343521,-0.026231404,-0.034186907,0.052621774,0.051110163,0.010749427,-0.04879766,0.050169352,0.030652644,0.094213076,-0.024440618,0.04223703,0.016533308,0.007919608,0.018206311,-0.006392029,0.024629278,-0.086488634,0.023877408,0.10308749,0.054472666,-0.05491954,-0.08407377,-0.016516997,-0.009795284,-0.0061751525,0.025980344,-0.036504738,0.06818077,0.009556075,-0.05802157,-0.021052592,-0.027193831,-0.022600038,0.016119525,-0.021881478,0.03466813,0.015597029,0.040294725,0.0335179,0.055620838,-0.023830788,0.0387074,0.053648844]})
