# Local-dev secrets file.
# Copy to ../var/dev-secrets.env (your application folder under /opt) and
# replace each REPLACE_ME with a real key before starting the server.
#
# NOTE: macOS Finder hides the .template extension, so the file may appear as
# "dev-secrets.env" in Finder even though it is still named dev-secrets.env.template.
# Use the terminal to rename it:
#   mv /opt/<app>/var/dev-secrets.env.template /opt/<app>/var/dev-secrets.env

# LLM providers
foam/llm/claude/api-key=sk-ant-api03-REPLACE_ME
foam/llm/openai/api-key=sk-REPLACE_ME
foam/llm/deepseek/api-key=sk-REPLACE_ME
