## Date and DateTime Views
Complete guide to Date/DateTime views with DateService integration
--

## Date View - Single Input with All Formats
Change the date and see how it's represented in different formats
--
foam.CLASS({
  name: 'DateViewExample',
  extends: 'foam.u2.Controller',

  properties: [
    {
      class: 'Date',
      name: 'selectedDate',
      label: 'Select a Date',
      value: new Date('2024-03-15')
    },
    {
      class: 'String',
      name: 'dateInfo',
      label: 'Date Information',
      view: { class: 'foam.u2.tag.TextArea', rows: 8, cols: 80 },
      expression: function(selectedDate) {
        if ( ! selectedDate ) return 'No date selected';

        var info = '';
        info += 'Local:      ' + selectedDate.toLocaleDateString('en-US', {
          weekday: 'long',
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        }) + '\n';
        info += 'ISO:        ' + selectedDate.toISOString() + '\n';
        info += 'UTC:        ' + selectedDate.toUTCString() + '\n';
        info += 'GMT:        ' + selectedDate.toGMTString() + '\n';
        info += 'Timestamp:  ' + selectedDate.getTime() + '\n';
        info += 'valueOf():  ' + selectedDate.valueOf();

        return info;
      }
    }
  ],

  methods: [
    function render() {
      this.addClass().start().
        add(this.SELECTED_DATE).br().br().
        add(this.DATE_INFO).
      end();
    }
  ]
});

add(DateViewExample.create());

## DateTime View - Single Input with All Formats
Change the datetime and see how it's represented in different formats
--
foam.CLASS({
  name: 'DateTimeViewExample',
  extends: 'foam.u2.Controller',

  properties: [
    {
      class: 'DateTime',
      name: 'selectedDateTime',
      label: 'Select a DateTime',
      value: new Date()
    },
    {
      class: 'String',
      name: 'dateTimeInfo',
      label: 'DateTime Information',
      view: { class: 'foam.u2.tag.TextArea', rows: 10, cols: 80 },
      expression: function(selectedDateTime) {
        if ( ! selectedDateTime ) return 'No datetime selected';

        var info = '';
        info += 'Local:      ' + selectedDateTime.toLocaleString('en-US', {
          weekday: 'long',
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit'
        }) + '\n';
        info += 'ISO:        ' + selectedDateTime.toISOString() + '\n';
        info += 'UTC:        ' + selectedDateTime.toUTCString() + '\n';
        info += 'GMT:        ' + selectedDateTime.toGMTString() + '\n';
        info += 'Timestamp:  ' + selectedDateTime.getTime() + '\n';
        info += 'valueOf():  ' + selectedDateTime.valueOf() + '\n\n';
        info += 'Date Only:  ' + selectedDateTime.toDateString() + '\n';
        info += 'Time Only:  ' + selectedDateTime.toTimeString();

        return info;
      }
    }
  ],

  methods: [
    function render() {
      this.addClass().start().
        add(this.SELECTED_DATE_TIME).br().br().
        add(this.DATE_TIME_INFO).
      end();
    }
  ]
});

add(DateTimeViewExample.create());

## Linked Date Views - All Views Share One Property
Multiple date inputs bound to the SAME property - change any field to update all
--
foam.CLASS({
  name: 'LinkedDateExample',
  extends: 'foam.u2.Controller',

  properties: [
    {
      class: 'Date',
      name: 'sharedDate',
      label: 'Shared Date',
      value: new Date('2024-03-15')
    },
    {
      class: 'String',
      name: 'formatInfo',
      label: 'Current Value in All Formats',
      view: { class: 'foam.u2.tag.TextArea', rows: 6, cols: 80 },
      expression: function(sharedDate) {
        if ( ! sharedDate ) return 'No date selected';

        var info = '';
        info += 'Local: ' + sharedDate.toLocaleDateString() + '\n';
        info += 'ISO:   ' + sharedDate.toISOString() + '\n';
        info += 'UTC:   ' + sharedDate.toUTCString() + '\n';
        info += 'GMT:   ' + sharedDate.toGMTString() + '\n';
        info += 'Time:  ' + sharedDate.getTime();

        return info;
      }
    }
  ],

  methods: [
    function render() {
      this.addClass().start().
        start().addClass('foam-demos-examples-Controller-linked-example-hint').
          add('💡 All three date inputs below share the SAME property (sharedDate). ').
          add('Change any field and watch all fields update automatically!').
        end().

        start().addClass('foam-demos-examples-Controller-linked-example-container').
          start().addClass('foam-demos-examples-Controller-linked-example-item').
            start('span').addClass('foam-demos-examples-Controller-linked-example-label').add('Date Input #1').end().
            tag(foam.u2.view.DateView, {data$: this.sharedDate$}).
          end().

          start().addClass('foam-demos-examples-Controller-linked-example-item').
            start('span').addClass('foam-demos-examples-Controller-linked-example-label').add('Date Input #2').end().
            tag(foam.u2.view.DateView, {data$: this.sharedDate$}).
          end().

          start().addClass('foam-demos-examples-Controller-linked-example-item').
            start('span').addClass('foam-demos-examples-Controller-linked-example-label').add('Date Input #3').end().
            tag(foam.u2.view.DateView, {data$: this.sharedDate$}).
          end().
        end().

        br().
        add(this.FORMAT_INFO).
      end();
    }
  ]
});

add(LinkedDateExample.create());

