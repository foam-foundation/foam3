c({id:"EmailSystemArchitecture:23",text:"9. IMAP Delete vs Mark as Read\n\nIssue: Emails reprocessed after restart.\n\nSolution: Set EmailServiceConfig.delete: true to delete after processing. Default (false) only marks as SEEN, which may not persist across restarts with some providers.\n\n---",sourceId:"EmailSystemArchitecture",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.055968508,-0.063984305,0.04335927,0.05868393,0.05622439,-0.05306959,0.044083446,-0.026483364,0.113064535,0.038065176,0.021255005,0.013228345,0.04685215,0.10472959,-0.006358286,0.03942629,-0.011052728,-0.055963047,-0.006094207,0.0052234586,-0.06906313,-0.015519602,0.054112207,0.018375264,0.019506045,-0.06562245,-0.05969405,-0.074584946,-0.075878784,-0.04376368,0.014821774,-0.060703374,0.011849019,-0.007086364,0.016555661,0.13261294,0.042808864,-0.0036482771,0.048785295,-0.027015688,-0.0065985294,-0.0370914,-0.03349236,-0.051952716,0.093477085,0.05466941,0.027733838,-0.0047206725,-0.08245733,0.08010769,-0.018909095,-0.010663236,-0.07914954,-0.028399263,0.052735243,0.004878363,-0.013631267,0.020647315,-0.058112055,0.0011818195,-0.03947226,0.055709988,0.019340068,-0.07699601,0.062451217,0.061175223,0.047658835,-0.13100068,0.030147612,-0.018655878,0.012632556,0.05692446,-0.039568536,-0.0011062323,-0.01363919,0.104992405,-0.012787588,0.015075434,-0.0317474,0.03224814,-0.012041833,-0.035412364,-0.0067532603,0.0065383213,0.050213054,-0.037898183,-0.051647186,-0.10502949,0.054833002,0.10772147,0.06437733,0.03508057,-0.0152171375,0.08861584,0.035649076,-0.030759884,-0.028009906,0.088977516,-0.027296716,0.043738976,0.092023365,-0.025551777,-0.036637638,0.046504088,0.056777507,-0.0677705,0.022261476,0.0058634994,-0.10128937,-0.038480204,0.050524186,-0.038686734,-0.025992531,0.05874631,-0.023044094,0.065955155,-0.025609685,0.07699802,-0.005387361,0.05339511,-0.06935052,-0.06957537,-0.044143856,-0.04814649,-0.051204327,0.023071362,0.059992366,2.958252E-33,-0.15912966,-0.048929747,0.014871529,