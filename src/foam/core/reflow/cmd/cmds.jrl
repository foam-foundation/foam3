p({
  "class":"foam.core.reflow.cmd.Command",
  "id": "upload",
  "category": "dao",
  "color": "$primary400",
  "description": "Upload data to a DAO",
  "icon": "upload",
  "parserClass": "foam.core.reflow.parser.DAOTargetParser",
  linkable: false,
  "script": """
    var scope = this.__context__.scope;

    if ( foam.String.isInstance(args[0]) && scope[args[0]] ) {
      args[0] = scope[args[0]];
    } else if ( foam.String.isInstance(args[0]) && scope[args[0] + 'DAO'] ) {
      args[0] = scope[args[0] + 'DAO'];
    }

    var m = foam.dao.DAO.isInstance(args[0]) ?
      { dao: args[0] } :
      { daoKey: args[0] } ;
    var upload = foam.core.reflow.Upload.create(m, this);

    this.out.tag(foam.core.reflow.UploadView, {data: upload});
  """
})
p({
  "class":"foam.core.reflow.cmd.Command",
  "id": "script",
  "category": "script",
  "color": "$orange400",
  "description": "Script an editable JavaScript block",
  "icon": "script",
  "script": """
    var code = args.join(' ');
    addValue(foam.core.reflow.Script.create({code: code, autoRun: !! code}, this), true);
  """
})
p({
  "class":"foam.core.reflow.cmd.Command",
  "id": "function",
  "category": "script",
  "color": "$orange400",
  "icon": "functionSign",
  "description": "Script an editable JavaScript block whose return value is the block's value",
  "script": """
    var code = args.join(' ');
    addValue(foam.core.reflow.function.Function.create(code ? {code: code, autoRun: true} : {}, this), true);
  """
})
