-0.080037914,0.07650765,0.001624797,-0.008384373,-0.06278396,0.016262643,0.05977185,-0.028040387,0.008601914,0.058857415,0.04746749,0.06440421,-0.056303825,0.080221914,0.044088144,0.057047937,-0.011858494,6.625762E-4,0.09125167,0.00982042,-0.06215213,-0.019932445,0.020928971,-0.020442514,-0.06796985,-0.019018218,0.08389143,1.306871E-4,-0.008258254,-0.047359932,-0.0015116493,0.040732313,-0.026846575,0.08223734,-0.02483106,-0.023562642,-0.037095148,0.017588848,-0.01420352,-0.021822862,0.034085866,0.014102,0.022005687,-0.023028547,0.13190052,0.00826111]})
