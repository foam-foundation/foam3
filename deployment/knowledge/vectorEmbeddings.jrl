c({id:"ReactivePatterns:2",text:"1. obj.name$ \u2014 PropertySlot Accessor\nSource: Property.js:497 \u2014 getter installed on prototype via Object.defineProperty\n\njavascript\n// Returns a PropertySlot \u2014 a live, subscribable handle to a single property\nvar slot = person.fname$;\nslot.get();           // \u2192 'John'\nslot.set('Steve');    // same as person.fname = 'Steve'\nslot.sub(listener);   // fires when fname changes\n\n\nReturns: PropertySlot (cached per instance in obj.getPrivate_('name$'))\n\nNote: person.fname$ is a short-form for person.slot('fname').\n\nUse case: When you need a slot reference to a single, flat property \u2014 for linking, following, or passing to views.\n\n---",sourceId:"ReactivePatterns",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.06322661,0.038350403,0.005975721,0.028842658,-0.060349476,-0.032574322,0.10507168,-0.009317331,0.059843723,-0.07112154,-0.023387043,-0.03370091,-0.06692763,-0.007244644,0.038021937,0.09156717,0.036270794,0.013299813,-0.034143515,0.056448583,0.023428688,-0.00563854,-0.018540274,-0.054376118,-0.03552121,-0.023602523,-0.018930223,0.03491775,0.03788694,-0.026606893,0.10786276,-0.026313689,0.008050478,0.027693685,-0.053556066,-0.0017662987,-0.03816309,0.043714847,0.0074396776,0.045515325,0.03593033,-0.015769215,0.005667928,-0.07644515,0.007601013,0.050463367,0.020957945,-0.0053393375,-0.015478532,-0.018527888,-0.036158916,4.7358352E-4,0.013338921,0.01804495,0.015744649,0.021128744,0.032205507,0.03861706,0.015492232,0.031026158,0.0066033877,-0.019193709,0.034737673,0.009115683,0.006657134,-0.055490114,-0.028910257,-0.012140779,0.016722685,0.053062826,0.026687248,0.022030493,0.09745811,-0.071650885,5.0155364E-4,-0.0062810653,-0.062306274,0.0111472495,0.034241036,-0.0686685,-0.03910471,-0.057599485,-0.05365069,-0.018104888,0.047568075,0.115576155,0.017968187,-0.027138477,-0.03124998,0.021672295,-0.11960287,-0.07868438,0.05860305,0.043263834,-0.08297972,0.020819794,0.019178959,-0.06571368,-