c({id:"VsSpring:6",text:"Code Generation vs Runtime\nFOAM generates code at build time:\n- Single model definition generates JavaScript, Java, and Swift code 4\n- Java code generation from JavaScript models 14\n- PropertyInfo classes for metadata access\n- Cross-platform consistency guaranteed\n\nSpring Boot is runtime-based:\n- Reflection and proxies at runtime\n- Annotation processing at compile time\n- No cross-language code generation\n- Java bytecode manipulation (AOP)",sourceId:"VsSpring",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.06491609,-0.060970534,-0.03050827,0.0066895653,0.07017373,-0.036392394,-0.06548106,-0.02536555,-0.0213591,-0.05993694,0.016164094,-0.043066036,-0.0109947175,-0.08093108,0.064998575,0.003559914,0.04320096,-0.08586925,-0.0047491067,0.024925448,0.06951194,-0.0061519383,-0.031367127,0.05720865,0.023136413,0.082441814,0.051620692,-0.0501052,0.06848635,0.0018053252,0.022279253,0.040652845,-0.017917028,-0.011671431,-0.009057205,0.052424178,0.043209627,-0.03905041,0.0027935652,-0.0042047617,-0.13736922,-0.020759605,0.054916047,0.02386556,0.06276314,-0.050463524,0.03285063,-0.057626456,-0.115004085,-0.025058726,-0.014400341,-0.046306774,-0.018839855,-0.102111824,0.019286493,-0.018560195,0.03910126,0.047248803,0.009811373,0.05793331,-0.05267081,0.044616655,-0.03601457,0.04142291,0.057876978,-0.054397292,0.02419358,-0.034582302,0.005283179,-0.12085464,-0.06045018,0.007748563,0.049291797,0.048355345,-0.045598436,0.102242194,0.017673755,0.055649083,0.08109433,-0.075867444,0.010633206,0.049473446,-0.0064264373,0.040038973,-0.049198348,0.057747353,0.082931526,0.028995512,0.05123078,0.10396796,0.014614104,-0.06748761,0.08466375,0.04606198,-0.038303483,0.005854972,-0.009521569,-0.075469,0.052790858,0.029217064,-0.06580645,0.075024106,0.09226835,0.042023566,0.03508389,-0.0051077046,0.006380282,0.02064613,-0.0145489415,0.062483188,0.030799918,0.016250463,0.02179074,-0.021663088,0.04724525,-0.021081038,-0.0031704465,-0.046458807,0.0