17,0.046896555,0.056969278,-0.057939384,0.02473327,-0.07605716,0.012192359,-0.06754156,-7.410151E-8,-0.0065360176,0.07690307,0.05412251,-0.052109413,0.043524098,-0.02317275,-0.00778979,-0.08107999,-0.04063473,-0.03375079,0.060521435,0.04894025,0.05892202,-0.036880974,0.040705033,0.0364672,-0.02082412,0.004459323,-0.096277736,0.003106835,-0.039761137,-0.090131745,-0.043117482,0.021446703,0.017096013,-0.008453719,0.042027354,0.06790753,0.041164026,0.074841775,-0.05478799,5.144097E-4,0.04370165,-0.0024096204,-0.07957853,0.061212987,0.055608213,-0.06325879,0.067822754,0.016597528,0.026500812,-0.012848252,-0.0343868,0.04110927,0.019008487,0.054316908,-0.073443696,-0.06238756,0.021291267,-0.028321702,-0.0570159,0.026790498,-0.0389561,0.11645346,0.011301676,0.005524073,0.04537882,-0.08497785,0.08170071,0.077004984,0.0945779,-0.079455264,0.040083222,-0.04329711]})
