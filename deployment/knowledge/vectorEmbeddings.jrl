07178617,0.023024717,-0.053887457,-0.033370167,0.052506678,0.05502056,0.09799889,-0.021964947,0.07691804,0.010246024,-0.0075022634,0.050643496,0.15274775,0.10145024,-0.05103318,-0.024575692,0.04057162,-0.058515187,0.010511928,-0.019855032,9.7171596E-4,0.08278148,-0.035121627,-0.09227747,0.005672937,-0.0040125092,-0.021256836,-0.021695092,-0.024357634,0.03382908,-0.0070856484,0.066395804,0.08361901,0.00281186,0.018884366,-0.03789246,-0.012710683]})
