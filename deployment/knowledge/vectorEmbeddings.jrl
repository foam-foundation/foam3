c({id:"Listeners:2",text:"Declaring Listeners\nShort Form\n\nFor simple listeners with no options:\n\njavascript\nlisteners: [\n  function onAlarm() {\n    console.log('Alarm fired for', this.name);\n  }\n]\n\n\nThe function must be named \u2014 anonymous functions are rejected.\n\nLong Form\n\nFor listeners that need timing control or auto-subscription:\n\njavascript\nlisteners: [\n  {\n    name: 'onResize',\n    isMerged: true,\n    delay: 100,\n    code: function() {\n      this.relayout();\n    }\n  }\n]\n\n\n---",sourceId:"Listeners",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.016968362,0.030603763,0.026152335,0.037465926,0.08208077,0.019133948,0.1398916,-0.012959463,0.047726598,-0.040444918,-0.010875668,0.023899471,-0.0650084,0.042863533,-0.0014533754,0.007564092,0.04863979,0.013583577,0.0033708762,-0.038895596,0.013418167,0.030225705,-0.04220926,0.025931746,-0.055083677,-0.11391336,0.017705582,-0.08023312,0.0035476931,0.018962786,-0.00527057,-0.05995057,0.02537302,-0.044394422,-0.11956401,-0.031298716,-0.026286045,0.024543028,-0.013465507,0.0076027676,0.07256447,-0.03225223,-0.051896166,-0.036597416,-0.08975616,-0.06340915,0.016797138,-0.05787734,-0.05189232,0.051475115,0.02906258,0.029415557,0.0061351336,0.008344921,0.0824127,-0.09728892,-0.10165233,0.010065569,0.024362432,0.066631116,-0.019434137,-0.059790608,-0.020208552,0.041924268,-0.0024171777,0.027882984,0.034417372,0.047920633,0.018462349,0.08051406,-0.02865699,0.040407777,0.09751851,0.056655962,0.021443237,-0.03353207,0.023214418,0.03234156,-0.0367125,0.007985711,-0.056358255,-0.12067646,-0.07136714,-0.03183949,0.010167272,0.078047335,-0.023472127,0.022324538,0.0033073789,-0.02418357,-0.07155611,-0.029581757,-0.06474234,-0.017997393,-0.01079912,-0.08119041,-0.034245864,-0.013109193,-0.04346438,-0.0088167,-0.019386522,0.0069596646,-0.066036455,-0.0010135942,0.007293454,-0.032526013,-0.12153518,-0.010394844,0.030719997,0.07410372,-0.018002564,0.014987424,0.023400286,-0.03308614,0.04