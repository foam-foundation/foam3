c({id:"cheat-sheet:6",text:"Methods\nMethods are member functions on instances.  \nName and implementation only; methods collection:  \njavascript\nmethods: {  \n  addAndMultiply: function(x, y, z) { return (x \\+ y) \\ z; },  \n  \u2026  \n}  \nAdditional information; methods collection:  \nmethods: [  \n  {  \n    name: 'addAndMultiply',  \n    documentation: 'First add first two parameters, then multiply by the third.',  \n    code: function(x, y, z) { return (x \\+ y) \\ z; },  \n  },  \n  \u2026  \n]",sourceId:"cheat-sheet",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.049612023,-0.010248595,-0.019198222,0.033126663,-0.10583151,-0.011330681,0.007771073,-0.0018766379,-0.020395234,-0.013227126,0.069071375,0.04892001,-0.057745986,-0.015651831,0.09358024,0.021545663,-0.048958216,0.024948051,-0.014644645,-0.036418937,0.12408418,-0.04251369,-0.012979535,0.019489445,0.0359541,-0.05246937,-0.08573911,-0.028990373,0.11162895,0.022632005,0.031693656,0.014184129,-0.043092985,0.0160036,-0.1381193,0.09047846,0.03210965,6.4163527E-4,-0.012438202,-0.008374327,-0.04025796,0.063292354,-0.08543899,-0.09883411,0.015185653,-0.013879863,-0.010675857,-0.013309613,0.0076819826,0.026211414,0.032663487,0.08218598,-0.060676266,-0.0077592097,0.09309198,-0.032261506,-0.020280857,0.018013008,0.022553919,-0.07596803,0.022978911,-0.04678454,-0.025410729,0.06358037,0.036138542,-0.07374749,-0.039111372,0.030816728,-0.0739549,0.08599476,-0.030978832,0.009332209,0.115117505,0.020654637,0.018622551,0.01398743,0.029942697,0.0043594954,-0.015394652,0.01626051,0.045048892,-0.011354418,0.018738486,0.09167942,0.008546555,0.095135376,-0.10545385,-0.060877185,-0.0029156366,-0.0063525913,0.02776777,0.00998175,-0.08206551,-0.0011783137,-0.052185394,-0.11606389,-5.046143E-5,-0.00724793,-0.0535279,0.0076484405,-0.005429299,0.012990137,0.06412826,-0.09920078,0.022711178,0.0038886403,-0.004880887,-0.1226231,0.019633055,0.020697517,-0.032298785,0.040613048,-0.07010913,-0.052286245,-0.00850951