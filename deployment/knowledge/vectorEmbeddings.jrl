c({id:"DesignPatterns:12",text:"Flyweight\nMDAO indexes are Flyweights. The index tree shares structural nodes across queries, giving the polymorphism benefits of object-oriented design without the overhead of allocating a full object for every node in the tree. Index nodes are small, immutable value objects that are freely shared rather than cloned.",sourceId:"DesignPatterns",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[0.023441803,0.07057174,-0.004506202,0.06406028,0.06433232,-0.036598317,0.019391552,-0.020673199,0.014436808,0.020851403,-0.031825893,-0.031423945,-0.019196346,-0.038388893,-0.0922644,0.03671888,-0.03348983,0.049486693,-7.8436243E-4,0.0790342,0.06414931,0.017850462,-0.06297774,0.035789292,-0.08785828,0.05574751,-0.021004688,0.0069370177,0.053916506,-0.054304797,-0.050020885,0.08021204,-9.036046E-4,0.05420921,-0.1584891,0.0266481,0.031652637,-0.06766373,-0.013435792,-0.07488904,0.06359248,0.07901865,0.058348615,0.010018342,-0.06450327,-0.015095008,-0.033453386,-0.026288329,-0.057834234,0.005733877,-0.071625434,-0.04761175,-0.06700037,0.04208145,0.0692699,0.089637816,-0.019393465,-0.07134012,-0.077199414,-0.047891222,0.04542669,0.11885107,0.03715375,0.008527367,0.10258209,-0.0133127775,0.011345045,-0.06011359,0.05278673,-0.085451104,0.036154594,-0.0013776766,-0.026966536,0.075460784,-0.019723045,0.10198419,0.026454223,-0.025412785,0.030034238,0.01776777,-0.09053601,0.04160186,0.03782973,-0.022875302,0.08007079,-0.0840835,0.01658964,-0.02808134,-0.009074743,0.018560525,0.07056758,0.05643702,-0.04702973,-0.044106357,0.046273366,-0.011822451,-0.015706532,0.014695377,-0.07526684,0.02236894,-0.004420519,0.058877416,0.012791532,0.024282128,-0.10452364,0.026674282,-0.01487786,-0.12268691,0.0052051554,0.0014796384,-0.08862911,0.07401302,-0.033706382,-0.05409202,-0.09516293,-0.02699292,-0.023158308,-0.046573505,0.014562398,0.007781479,-0.045771025,-0.05843062,0.0062448955,-0.053305175,0.11229023,-0.016644008,-0.13049304,2.2226148E-33,0.015793392