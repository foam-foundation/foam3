c({id:"Boxes:4",text:"When not to use Boxes\nBoxes are not an all encompassing network abstraction.  If you are talking to existing APIs like a REST based API from some third party, you would not use HTTPBox.  You would continue to use fetch() or whatever http client library you would traditionally use.  Boxes are meant to be used by all communicating parties, most transport boxes expect specific wire level protocols.",sourceId:"Boxes",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[0.004587402,0.037577998,-0.018567957,0.0099570835,-0.04900989,0.0026506735,-0.10372051,-0.028546626,0.035046887,-0.04093653,-0.060596127,0.06069693,-0.04172155,-0.044399202,0.005582642,-0.065621056,0.1096902,0.016126893,0.012056029,0.011172778,-0.05736067,0.021413127,-0.058811776,-0.025324808,-0.05030681,-0.028171254,-0.051006284,0.004490039,-0.0013330291,-0.010939393,0.039620146,-0.029428137,-0.09165608,0.059824113,-0.111674674,0.021047108,-0.048130922,-0.0608868,0.023393165,0.013913934,-0.03732631,-0.026164632,0.0023742802,0.031269524,0.020528523,-0.08948027,0.0012530164,-0.10236985,-0.05039015,-0.062815055,0.032885525,0.07944158,0.0572851,0.034721322,-0.03742674,-0.11297768,-0.018389247,0.039056428,-0.033703886,0.04584212,-0.012041633,-0.024795298,0.05674275,-0.01509338,0.05997287,0.015333884,-0.019413475,0.049736578,0.04299016,-0.11427941,-0.06030456,0.056966238,-0.029112881,0.012188733,0.048118897,-0.09245041,0.022606382,-0.023260465,0.0667023,0.08731398,-0.018579297,0.02813243,-0.005624701,0.031926125,-0.0839416,0.05246519,-0.06268313,0.115476854,-0.0784377,-0.06105533,0.05499628,-0.008281339,0.046785176,0.051329833,0.02113257,0.007710596,-0.09662922,-0.01984765,-0.09442307,-0.05491501,0.060967863,-0.047231242,-0.059845123,-0.028527237,0.059337843,-0.05768725,0.022707384,0.08542572,0.03599204,0.03930225,-0.0950743,-0.054747492,-0.087218985,0.0057960013,-0.07700947,0.026058313,-0.03908929,-0.05308976,0.010972727,-0.024552763,0.05725812,-0.045371305,0.027706904,-0.003284