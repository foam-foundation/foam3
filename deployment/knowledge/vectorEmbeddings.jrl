-8,-0.084742665,0.004696849,0.039938234,-0.04582695,-0.00840321,0.028570846,0.042728893,-0.011516932,-0.022639003,-0.016135396,0.044261083,0.10920938,0.030632973,0.008408364,-0.05831817,-0.0052472497,0.02477632,-0.017895298,-0.068865836,0.08778202,0.01702325,0.02092274,0.038020235,-0.009372679,0.102581866,-0.057053898,0.009693723,0.022745237,0.038151223,0.066050045,-0.0050317273,0.014102158,0.049465694,0.11490439,-0.033201862,-0.034989532,0.0058033844,-0.064619094,0.05369792,0.16166256,0.047079477,-0.03714262,-0.010358529,0.008487537,0.016941518,0.05860065,-0.07489357,-0.07361875,0.055714827,0.009555994,-0.035543617,-0.046899814,-0.057520896,-0.02756614,0.0043117465,-0.050940562,0.03081987,0.026551541,0.0155964615,0.043109242,-0.013606519,-0.008884782,-0.0063065803,-0.045652922]})
