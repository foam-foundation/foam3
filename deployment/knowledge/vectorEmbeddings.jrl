688,0.0072022206,0.034479078,0.023166189,-0.04218163,-5.7340113E-8,-0.046541363,0.0017493638,0.0074510747,-0.032746922,0.057477057,0.014789996,0.06900613,0.07134591,-0.0405255,-0.044625916,0.134257,0.11577088,-0.0036321303,-0.00977108,0.053906836,0.019603767,0.018701132,0.024498895,-0.0520907,-0.011995253,0.0327181,-0.02623746,-0.02068445,-0.005326212,0.107178435,-0.0045470004,-0.058577485,-0.0060553476,0.05246974,0.10149794,0.045482196,0.025759352,0.03163445,0.07762435,-0.0066599986,-0.02533756,0.052633345,-0.009685579,-0.039174076,0.049513496,0.05379655,0.043429215,0.011434494,0.012741797,0.066928804,0.09280691,-0.017940585,-0.03987438,0.053523704,-0.034205656,-0.09616316,-0.021659443,0.003228338,0.022029629,-0.09084999,-0.03161483,0.059366204,0.032150146,0.03912906,0.04457529,-0.010583012,-0.0010565809,0.055643633,0.06621944]})
