c({id:"ReactivePatterns:7",text:"6. this.slot(function(a, b) {...}) \u2014 Lazy Computed Slot\nSource: FObject.js:767-775 \u2192 creates ExpressionSlot\n\njavascript\n// Returns an ExpressionSlot\nvar fullNameSlot = person.slot(function(fname, lname) {\n  return fname + ' ' + lname;\n});\nfullNameSlot.get();      // \u2192 'John Smith'\nfullNameSlot.sub(l);     // fires when fname or lname changes\n\n\nHow it differs from expression property:\n\n- expression: is baked into a property definition (model time)\n- slot(fn) creates an ad-hoc ExpressionSlot at runtime\n\nUse case: When you need a reactive computed value outside of a model definition \u2014 in a method, view, or controller.\n\n---",sourceId:"ReactivePatterns",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.099055044,0.04256136,0.015782239,0.08833945,-0.023555882,0.036269322,-0.0028924756,0.07059407,0.09453805,0.044760358,0.0209763,-0.058406834,-0.07913951,-0.0020633875,0.09052486,0.076029666,0.0022120676,-0.075318865,-0.03888231,-0.029539907,0.07415347,-0.051124044,-0.060927887,-0.04526873,0.038682092,0.011032457,-0.06075178,0.036028344,0.12857808,-0.0054116133,0.0152968615,0.033531927,0.08867459,0.037623428,-0.1235358,0.0139502585,-0.011715975,0.034778923,0.037967265,0.013082809,0.055842057,-0.056271743,0.022213878,-0.09539254,0.107108176,-2.4557734E-4,0.04097785,-0.019028012,-0.075863704,0.075067475,-0.036925353,0.030235477,-0.040191006,0.07280742,0.04063236,0.0070543136,0.014224032,-0.031892028,0.018636389,0.031360485,-0.0083296755,0.0017969792,0.013776357,0.05318759,0.040431634,-0.04166041,0.012227827,-0.063246235,0.032203097,0.10010253,0.038131088,0.054513898,0.01568968,-0.073750824,0.010544104,0.0078583,-0.01235605,0.068903826,0.06712625,-0.038491614,0.007061446,-0.016243482,-0.09938622,-0.063116655,0.0132913925,0.046307772,-0.052004796,-0.04468449,0.037387174,0.02596298,-0.021981098,-0.08946417,0.007215233,0.03508562,-0.07520535,-0.03154319,0.005120575,0.069859505,-0.0685642,0.029283