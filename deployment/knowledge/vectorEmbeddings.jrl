089423,-0.029329708,-0.021497203,0.021723,-0.015494042,0.02528526,0.075250834,0.02248395,-0.010323428,-0.024675148,0.07331716,-0.08073634,-0.018883772,-0.07432373,-0.042424288,0.008948466,0.019774793,-0.072778106,-0.048813306,0.060237862,-0.0031971228,-0.028692631,0.024759201,0.027679687,0.066988476,-0.060192525,0.0018089486,-0.025628135,0.043350466,-0.021970855,0.07145447,0.06701158,-0.07277189,-0.01893095,-0.0028413637,0.035505574,0.04974122,-0.027856983,-0.052118905,0.0048371726,0.04131682,-0.025474789,-0.0134762935,0.07188233,0.014789831,-0.014308223,-0.047808655,-0.059936788,0.032358944,0.0248244,-0.06102546,-0.003893221,-0.046288855,0.10545051,0.031524897,0.018822962,0.016904552,0.1862104,-0.0057033543]})
