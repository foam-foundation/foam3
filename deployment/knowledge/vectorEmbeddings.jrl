c({id:"Modals:2",text:"Usage Patterns\nThe framework registers these components in the build system 20 , making them available throughout the application.\n\nWhen to use each:\n- Popup: For custom modals requiring full control over styling and behavior\n- StyledModal: For standard application modals with consistent branding\n- ConfirmationModal: For simple confirmation dialogs with primary/secondary actions\n- ApplicationPopup: For complex workflows, wizards, and multi-step processes",sourceId:"Modals",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.0844321,-5.780444E-4,-0.041679658,-0.032940626,0.08932901,-0.036455598,0.10902225,0.061998736,0.05255555,-0.030779282,0.04459536,0.016859395,-0.011950086,-0.013963214,0.12264264,-0.0073433304,-3.3451E-4,-0.048334055,-0.017279025,0.05250471,0.027720576,-0.043359388,0.015889278,0.0048024915,-0.028364407,-8.4443344E-4,9.1924315E-4,-0.005788141,0.14252415,0.012101123,0.080823965,0.14143465,0.022349782,-0.0631921,-0.09637517,0.015874354,0.08112877,0.015016575,-0.07011354,-0.04052634,-0.058874913,-0.027995097,-0.06012652,0.017168844,-0.039044783,-0.035131328,-0.03190281,-0.0651436,-0.040970955,0.041893564,0.04521862,-0.088949084,-0.0010702725,-0.017178927,0.052433454,0.013956533,0.026168209,-0.013320695,0.042661015,0.012192933,-0.041480042,0.019642323,-0.11072484,0.052180532,0.0011877886,0.07651624,-0.024451382,-0.057844486,0.049529593,-0.12165042,-0.0539603,-0.037784323,0.041308608,-0.0020919312,-0.07726376,-0.024319304,-0.037260093,-0.053079564,-0.06374926,-0.07572505,0.041957572,0.046536654,0.027441073,0.011170255,0.046021886,0.051695168,0.04273841,0.021237362,0.018930053,0.061456483,0.008869453,-0.04045904,0.051184576,0.01447712,-0.03735666,0.03870903,-0.07395577,-0.07844843,0.017928459,0.025063599,-0.008860744,-0.062194325,0.09149,0.023490606,0.011047301,-0.024766456,-0.076824196,0.001937246,-0.0042149764,0.0054875948,-0.051694628,-0.04710398,0.017142782,-0.059832674,0.05946966,-0.070366986,-0.01787641,0.0