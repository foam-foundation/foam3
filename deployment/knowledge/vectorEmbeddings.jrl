c({id:"NDiff:3",text:"Quick Start\nTo enable NDiff for a DAO, add .setNdiff(true) in your services.jrl:\n\n\nreturn new foam.dao.EasyDAO.Builder(x)\n  .setNdiff(true)\n  .setJournalName(\"mydata\")\n  .setOf(com.example.MyModel.getOwnClassInfo())\n  .build();\n\n\nOnce enabled, access Admin > NDiffs to view changed objects.\n\n---",sourceId:"NDiff",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.028969724,-0.043881305,-0.020281626,-0.0229408,0.047755755,-0.025932046,-0.028536974,-0.028511923,-0.055301964,-0.027066154,-0.0025238264,-0.042307254,-0.07106875,0.011398669,-0.034209974,-0.049321663,0.059796147,0.041756716,-0.028826237,0.08769677,0.019962661,0.07288122,-0.028585605,-0.06495288,0.06445703,0.030644534,0.049644988,-0.025759393,-0.0043601445,-0.113705166,-0.006615302,0.040387638,-0.019122802,-0.016699862,0.06685461,-0.039738063,0.045118023,0.011798468,0.042774018,-0.010700214,0.01820125,-0.011414016,0.02079597,-0.046614368,-0.0285235,-0.026069473,-0.05555335,0.013012332,0.108139396,0.011882771,-0.0365881,-0.05631737,0.013717157,-0.031037696,0.04589763,0.067084625,0.027245551,0.07268092,-0.08939955,-0.02061253,0.016289681,-0.0038319658,0.06537108,0.06700345,-0.00600161,0.035345953,0.08391065,-0.011643207,-0.01780704,-0.06263829,-0.033315323,0.04002138,0.07810443,-0.03488317,-0.005229696,0.04322224,-0.016136425,0.13112089,0.10755258,-0.093545094,0.01966902,0.04840081,0.05543961,0.017040454,-0.040604256,0.04116748,-2.7256898E-4,-0.017479232,0.034908943,0.037434295,0.0027400062,-0.035581686,-0.011299281,-0.05654318,-0.15721379,-0.05583856,-0.0151707865,0.06232083,0.061614938,0.03206633,-0.046542305,0.07569862,0.003679679,0.061250802,0.027125794,-0.037089534,0.0073230467,-0.06480672,-0.058654822,0.10800177,-0.020560915,0.054308575,-0.0038086385,-0.010337826,0.024313835,-0.099243455,-0.01662735,-0.023785431,-0.10819244,-0.0810265,0.04472816,-0.102102675,0.014227728,4.1733298E-4,0.009080497,0.07560507,-0.024170173,1.497756E-33,0.08237836,-0.049091812,