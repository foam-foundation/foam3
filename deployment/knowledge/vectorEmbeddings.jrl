c({id:"Reflow:4",text:"UI Components\nThe system includes several specialized UI components:\n- DynamicReflowComponents - Searchable list of available commands 14\n- DynamicReflowData - Collections and flows browser 15\n- DynamicReflowHelp - Keyboard shortcuts reference 16\n- ReflowToolBar - Toolbar controls for components, collections, flows, and help 17",sourceId:"Reflow",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.08052603,-0.01642939,-0.018040005,-0.009450152,-0.025755828,0.022859428,0.03601935,0.03565023,0.008319017,-0.05544385,-0.021391802,-0.059037235,-0.021231137,-0.02892219,-0.034798995,-0.07971365,0.009296397,0.016517697,-0.028849134,-0.059950896,0.01860244,0.014021916,-0.021590276,-0.007975102,-0.06968179,0.084603466,-0.015949387,-0.098107904,0.06518445,-0.026995461,0.04586697,0.085183196,0.0028537987,-0.0068341303,-0.16390653,-0.020485522,0.09757455,0.038246386,-0.033399377,-0.016151117,-0.07174922,0.04824819,-0.03317267,-0.016518781,0.04973374,-0.009215971,-0.02230387,-0.077377476,-0.051243145,0.038343746,-0.04669781,-0.046054535,-0.0014015858,0.16285995,0.046575997,0.050251115,0.009047304,-0.009233451,0.05334793,0.03037033,-0.051950958,-0.010251545,0.003830659,-0.006106319,-0.05647341,0.019864324,-0.076692626,-0.0011048747,0.0827719,-0.104109764,-0.0060640653,-0.007328168,0.026657958,-0.061515726,0.018498506,-0.09154742,0.006125836,-0.02947724,-0.019577753,0.0066932864,0.031473838,0.04603106,-0.041582167,0.0010207283,0.015847053,0.081686966,-0.004148363,-0.044188544,0.051503915,0.013409598,-0.034754694,-0.06552658,0.09218622,-0.062695906,0.08835379,0.052419715,-0.02856876,-0.074355185,-0.0096345665,-0.009512345,0.034370095,0.005555442,0.05953153,0.036148254,-0.04920344,7.0234743E-4,0.026113523,0.031986956,0.0385196,0.0030257201,-0.006365232,-0.072502226,0.0074951835,-0.0929758,0.07013818,-0.071874574,-0.047483232,-0.03386559,-0.030937431,0.055177487,-0.06199936,0.08018987,-0.049805745,-0.056352112,0.0916539,-0.0024370113,-0.03776541