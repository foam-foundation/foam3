// The fallback: a save already starts a sync, so this run only catches what a save could not.
// It embeds the records left NEW or DIRTY while the provider was down, and the records loaded at
// boot, which are all NEW. One whose stored chunks still hold its text is marked embedded with no
// AI call. When nothing waits, a run only scans the records' status.
p({
  "class": "foam.core.cron.Cron",
  "id": "embeddingSync",
  "description": "Embed the records of EmbeddingAware DAOs that changed, for Ask AI",
  "schedule": {
    "class": "foam.core.cron.IntervalSchedule",
    "duration": {
      "class": "foam.core.cron.TimeHMS",
      "minute": 30
    }
  },
  "code": """
    ((foam.ai.vector.EmbeddingSync) x.get("embeddingSync")).sync(x);
  """
})
