c({id:"claude:18",text:"10. Pub/Sub\nEvery FObject has built-in pub/sub through a topic hierarchy.\n\njavascript\n// Publish\nobj.pub('myTopic', 'subTopic', data);\n\n// Subscribe\nvar sub = obj.sub('myTopic', function(sub, topic, ...args) {\n  console.log(args);\n});\n\n// Property changes are published automatically:\n// obj.pub('propertyChange', 'amount', slot)\nobj.sub('propertyChange', 'amount', handler);\n\n// Unsubscribe\nsub.detach();\n\n\n---",sourceId:"claude",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[0.013648851,-0.03140782,-0.019580338,0.054428454,0.024101896,-0.036500618,-0.027456606,-0.018631317,0.08686461,0.054008134,-0.098246716,-0.016759956,-0.0032101,0.046292093,0.032238763,0.0030921132,-0.0086787455,-0.0060573146,-0.0046659796,-0.048366956,-0.058103856,0.0859986,0.043556545,-0.012718556,0.025646564,-0.042406723,-0.030139027,-0.027083332,9.966443E-4,-0.011303509,0.09068359,-0.04999755,0.034827765,0.008247361,0.016883342,-0.04966399,-0.03662016,-0.03134676,0.069616005,0.08264198,0.0724846,-0.052342426,-0.04447359,-0.09945587,0.021571852,0.0198029,-0.10443833,0.025912367,-0.026587214,0.086712174,0.043793287,-0.13063215,-0.0578988,0.105371416,0.07639563,0.049545277,0.050703287,0.017887052,0.051687222,-0.060784698,0.01795188,0.05563677,-0.08763262,0.019283434,0.061624486,0.05160098,-0.03129045,0.06218088,0.015701497,0.073141396,0.051495444,0.07234238,0.023131859,-0.00847095,-0.014284275,-0.058573645,-0.04060594,0.0150850145,0.035261244,-0.009563397,-0.002588314,-0.039333083,-0.041189946,-0.02768987,0.0143373925,0.0029263054,0.08792566,-0.056655508,-0.04599974,0.02482649,-0.046635285,-0.009454812,0.094573565,0.017122183,-0.0881307,-0.036767118,-0.006926139,-0.053941235,0.08301814,0.024162585,-0.031548027,0.06972274,-0.006767035,-0.035598483,0.0013943077,-0.081174105,-0.035082135,0.016326416,-0.059166744,0.11318523,-0.073261574,0.07311794,-0.055393353,-0.023427228,0.033306394,0.020384634,0.1362071,0.03157917,-0.03594297,-0.008788519,0.