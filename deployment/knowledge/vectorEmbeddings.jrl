.0012875173,0.009404623,0.0022824616,-0.026341178,-0.071965985,0.00700427,-0.013021126,0.038351554,0.020069662,-0.01784081,-0.018696656,-0.0016516653,0.06856877,0.02001955,-0.031181732,-0.03408468,-0.0015180698,-0.020310244,-0.011329263,-0.008965229,-0.0021991082,0.076903455,0.091504015,0.013383405,0.017474255,0.025573067,0.13258822,-0.06656553,-0.0066602076,0.014879402,0.0705429,-0.06852361,0.069010116,-5.7498977E-4,-0.0041399547,-0.009978735,0.05750153,0.06838992,0.058818243,-0.013122691,-0.009690397,0.039714415,-0.010285692,0.058942698,-0.06974869,0.06364888,0.01659379,-0.08480728,0.020856664,-0.038846377,0.03512049,-0.030483432,0.032554902,0.055865634,0.02539392,0.08840154,0.046692166,-5.167716E-5,0.011386735,-0.0011122425,0.03556116]})
