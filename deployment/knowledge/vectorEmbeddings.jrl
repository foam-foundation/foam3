c({id:"manual:Query Syntax:3",text:"Logical Operators\nAND\nCombine expressions with spaces or explicit AND:\n\nexpression1 AND expression2\nexpression1 & expression2\n\n\nNOT\nNegate expressions with NOT:\n\nNOT expression\n\n\nOR\nCombine expressions with OR or pipe:\n\nexpression1 OR expression2\nexpression1 | expression2\n\n\nOR\nCombine expressions with OR or pipe:\n\nexpression1 OR expression2\nexpression1 | expression2",sourceId:"manual:Query Syntax",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[0.0049216147,0.048786532,0.04370474,-0.030922456,0.029673,-0.03057454,0.001836557,-0.046500284,0.025293196,-0.017890656,0.048826713,-0.07158821,0.045141976,0.045125406,0.034450416,0.100687526,-0.07869055,0.01777476,-0.04184041,-0.07413808,0.066255614,0.01206337,-0.06859158,-0.024409171,0.04630344,0.07622547,-0.046704948,0.011049603,0.10941287,0.009877446,-0.026327178,-0.040288784,-0.09211727,0.055651102,0.04197268,-0.044940505,0.012154863,0.057976276,0.0029998864,-0.06569901,-0.06552275,-0.11273245,-0.06894407,-0.053725712,0.013963723,0.032896753,-0.038544867,-0.022561803,-0.011861406,-0.028639039,-0.04150277,0.018327055,-0.04177814,-0.016736472,0.048798084,0.017037882,-0.101255104,0.017619543,0.0038388146,-0.055416614,-0.017844224,-0.04643599,-0.032204114,0.048991848,0.03689177,0.017641589,-0.09544551,0.06258653,-0.03361887,0.13326192,-0.07428609,-0.039570786,-0.05131622,0.0026650685,-0.014833691,0.096890986,0.06970099,0.015676225,0.0145798875,0.0125178415,-0.06482783,-0.03230878,-0.061320826,0.014948957,-0.00530129,-0.03204724,-0.11184742,-0.03265885,0.0050511765,-0.05236067,0.0013534544,0.01114038,0.13710113,-0.015785635,0.13029937,-0.044232477,-0.058444742,0.04963191,-0.018591454,0.02064121,0.003059289,0.1291161,-0.01683514,-0.1299869,0.01294033,-0.034308545,0.024278581,-0.059684526,0.021621177,-0.04084753,0.038784575,-0.028379528,0.06849256,-0.038725834,-0.04643417,0.077905744,0.08548398,0.075018615,0.054119512,-0.04523998,-0.03896199,-0.03505439,-