028,0.006138989,-0.026504286,0.012801374,0.08681105,0.055043645,-0.05236707,-0.040067706,0.064576924,0.07970477,0.058695342,-0.028440084,-0.06795032,-0.024623249,-0.008587261,-0.018071827,-0.022515401,-0.027329387,0.053984623,8.8068E-4,0.011553719,0.0336392,0.033274084,0.051958043,0.010943274,0.03848336,0.026491735,0.045471594,-0.041069377,0.027978184,0.036698285,-0.034548912,-0.019139016,0.022121849,0.0043048803,-0.031092275,0.027929705,-0.007088954,0.039037865,0.038785253,-0.08460217,-0.01684297,0.044164255,0.039733768,-0.106741175,-0.011278473,-0.021260807,0.036577024,0.01302693,-0.021834364,-0.00170191,-0.046425052,0.104550056,0.026248805,0.04632612,0.0054374663,0.09155424,0.082466744]})
