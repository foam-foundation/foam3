c({id:"NanoServices:15",text:"Summary\nFOAM nano-services provide:\n\n- Single interface definition generates both client and server code\n- Box abstraction hides transport details (HTTP, WebSocket, local)\n- Stub/Skeleton pattern makes remote calls look like local calls\n- CSpec configuration controls deployment without code changes\n- Decorator composition adds cross-cutting concerns transparently\n\nThe key insight: services are objects, not endpoints. The transport is configuration, not API design.",sourceId:"NanoServices",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.04334602,-0.015522785,0.009563634,-0.043167375,0.023576241,-0.04576928,0.030335635,0.008747552,-0.0074852062,-0.0126555925,-0.0139991045,-0.057526466,0.015442664,-0.026168594,0.14185278,-0.051139854,0.10037454,-0.10158074,0.059321243,0.04437148,0.06872722,0.034715276,-0.056320034,0.026481712,-0.105043106,0.00912473,-0.0027215465,-0.076394305,0.017973933,-0.07671591,0.0246739,0.08960823,-0.08581036,0.02853925,-0.025266044,0.031236462,0.058887307,-0.024615766,-0.08823134,-0.011469823,-0.030280007,-0.05960698,-0.053919517,-0.02730106,0.0024698249,-0.054141805,-0.013125967,-0.052467737,-0.062720306,-0.032935165,-0.020039678,-0.033359095,0.0043513086,0.05919819,0.009113865,-0.003182059,0.0010826761,0.050314296,-4.5214946E-4,0.044132505,0.02352981,-0.058772407,0.019283498,0.046091896,0.09681328,-0.032622274,-0.026003039,0.030512508,0.02731903,-0.0990435,-0.06406632,-0.018611887,0.046240006,0.008348067,0.006100628,0.047421254,0.04362517,0.055756442,0.03659913,-0.04032864,-0.0030151783,0.073218554,0.033209857,0.074869186,-0.03674704,0.098183475,0.038926218,-0.026683265,-0.04566208,0.040049583,0.05687521,-0.030815056,-0.0513264,-0.068285204,-0.051325314,-0.04465677,-0.02896777,-0.077187076,5.4909923E-4,0.020916244,-0.014855811,-4.822714E-4,0.09054297,-0.027244674,0.0014155876,-0.07238998,-0.043260954,0.012804895,0.042996947,0.11991726,-0.08513255,-0.0068097953,-0.039683633,0.053543348,0.01