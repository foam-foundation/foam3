c({id:"dynamic:2",text:"Notes\nBoth use FOAM's reactive slot system under the hood, but serve different purposes - expressions for computed model data and this.dynamic() for reactive UI rendering. The DynamicFunction implementation ensures UI updates happen immediately when dependencies change, while expressions only compute when accessed.",sourceId:"dynamic",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.08824677,0.018321505,-0.027571408,0.096234545,-0.026429124,-0.009051453,-0.041207984,0.048837326,0.070354626,-0.014065321,0.005677501,-0.07845078,-0.0027133639,0.02515287,0.021890936,0.025784,0.1098815,-0.06344701,0.00760737,-0.02278606,0.021750228,-0.036544338,-0.11009858,0.0017632925,-0.0062596938,0.0800095,-0.015727788,-0.050470367,0.16058828,0.0020125306,0.023867877,0.010753027,-0.017951885,-0.023201015,-0.1776133,-0.043705944,-4.0006763E-4,-0.016489329,-0.025408166,-0.0097475955,-0.0010949286,-0.021328015,-0.01937871,-0.08092131,0.110780165,-0.021112379,0.014785386,-0.011483367,-0.073312975,0.030554341,-0.02215507,0.008800415,0.025551142,0.090784125,0.047272023,0.076548845,0.052673005,-0.010859594,-0.021413915,0.0034121699,0.006268132,0.016101353,0.063797675,0.07044386,0.041295953,0.017894145,0.0012900112,-0.013860615,0.09589715,-0.09369246,-0.027828116,0.05866762,0.059078943,-0.11657793,0.016842337,0.03460545,0.028277593,-0.021979034,0.08310962,0.017328065,0.07116859,0.04895313,-0.050264593,-0.1207731,0.006617507,0.08117723,-0.008094892,-0.06697492,0.010623162,-0.027272835,0.08911301,0.042808715,0.009902561,-0.0025498888,-0.024030713,-0.029300814,0.01458055,0.04340686,0.002081237,0.006140419,-0.039322525,0.06900738,-0.039400306,0.018348517,-0.028349204,-0.045418605,-0.015127558,-0.015864868,-0.06387684,0.022499904,0.04103331,-0.018231263,0.017196702,0.019969227,-0.019919751,-0.043022953,0.0087129455,-0.019887224,0.013278986,0.007999862,0.03686063,-0.017567707,0.0148468455,0.008602705,0.062923044,-0.058385413,-0.011628655,3.0747654E-33,-2.7256