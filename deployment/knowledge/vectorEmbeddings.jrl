c({id:"ExportingFlows:0",text:"ExportingFlows\nStep-by-step instructions for exporting a Reflow flow from the running app and replacing it in the .jrl source file.\n\nKeywords: reflow, export, flow, jrl, knowledge\n\n<flow name=\"ExportingFlows\" category=\"DOC/GUIDE\" spid=\"foam\" description=\"Step-by-step instructions for exporting a Reflow flow from the running app and replacing it in the .jrl source file.\" keywords=\"reflow,export,flow,jrl,knowledge\"/>",sourceId:"ExportingFlows",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.076732926,0.0150013175,-0.012905139,-0.011024256,0.067737415,0.020343244,-0.044038583,0.013389334,-0.02496215,-0.055919934,-0.0467215,-0.022170525,-0.020839036,-0.04866056,-0.021160236,-0.06330288,-0.08688584,0.101376005,-0.087175645,-0.08975826,0.056914747,0.029179666,-0.0031017547,-0.02087152,0.05525641,0.05146525,-0.032403834,-3.0126245E-4,0.031074967,-0.029696818,-0.013210476,0.08004024,-0.022225717,0.023485513,0.034953933,0.09292913,0.032699097,0.028840818,0.014637579,-0.05017775,-0.004670399,0.042399984,-0.047831256,-0.028815946,0.011997296,-0.022126462,-0.06391576,-0.06326618,0.016366966,0.10644839,-0.09303732,-0.054822054,-0.0304716,0.013083742,0.07991345,0.061587702,-0.004815055,-0.066432685,0.0064430106,0.01431033,-0.021061022,-0.057790406,-0.03740322,0.057769764,-0.110333815,4.69834E-4,-0.097381696,0.061511267,0.11204962,-0.119154,-0.108973555,0.054140702,-0.044751815,-0.107474595,-0.008779356,-0.043584988,-0.022034269,0.03514578,-0.02275041,-0.019472793,0.03712624,0.029404774,-0.050451558,0.0067479946,-0.0075897756,0.026269166,0.021936389,-0.017927852,0.12294715,0.112233795,-0.101188086,-0.08780372,0.07047423,-0.026396576,-0.00845174,0.08755033,-0.061105892,-0.026976014,-0.01342952,0.014019859,-0.0145341195,0.025182065,0.08178209,-0.037343904,0.0042825085,-0.04541105,-0.03973928,0.12088062,-0.012671959,0.01324648,0.011079984,0.006613305,0.07883663,-0.08639504,0.03994864,-0.0034189504,-0.047351226,-0.04877569,