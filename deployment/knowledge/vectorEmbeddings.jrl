45E-8,-0.06322167,-0.011594719,-0.061826345,0.012271584,0.050260104,-0.007148907,0.035348274,0.058747333,-0.011936453,0.059951276,0.06389252,0.11763312,0.026861196,-0.05153917,-0.061256196,0.00283892,-0.0033965353,-0.015219643,-0.08361742,0.070847474,0.01114002,-0.055010937,-0.01445435,0.050612804,-0.024204148,-0.11967234,0.03523698,0.053326115,0.04887522,0.0020023845,-0.04247505,0.07835959,0.080189675,0.15131262,0.020973045,0.04645892,-0.04726099,0.058224402,-0.012750057,0.12717964,0.07258149,-0.037022423,-0.061524186,-0.03206552,0.034029055,0.03747254,-0.13213262,0.024052849,0.011531747,-0.06868093,-0.04450063,0.057710156,-0.085197166,0.023113934,-0.0024630162,-0.033542182,-0.0012176966,-0.0015311436,-3.7612984E-4,0.00389495,-0.017220985,-0.01920089,0.04342736,-0.013839727]})
