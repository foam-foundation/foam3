p({
"class":"foam.core.reflow.Flow",
"name":"PropertyBorder",
"label":"Property Border Demo",
"version":18,
"category": "demos",
"script":
"""[
	{

		"flowName": "script1",
		"cmd": "script",
		"value": {
			"class": "foam.core.reflow.Script",
			"code": "foam.CLASS({\\u000a  package: 'foam.u2.demos',\\u000a  name: 'DemoAddress',\\u000a  label: 'Address',\\u000a\\u000a  properties: [\\u000a    {\\u000a      class: 'String',\\u000a      name: 'type',\\u000a      label: 'Type',\\u000a      gridColumns: 4,\\u000a      view: {\\u000a        class: 'foam.u2.view.ChoiceView',\\u000a        choices: [['HOME', 'Home'], ['WORK', 'Work'], ['OTHER', 'Other']]\\u000a      }\\u000a    },\\u000a    { class: 'String', name: 'street',  label: 'Street',  gridColumns: 8 },\\u000a    { class: 'String', name: 'city',    label: 'City',    gridColumns: 6 },\\u000a    { class: 'String', name: 'country', label: 'Country', gridColumns: 6 }\\u000a  ]\\u000a});\\u000a\\u000afoam.CLASS({\\u000a  package: 'foam.u2.demos',\\u000a  name: 'DemoContact',\\u000a\\u000a  tableColumns: ['name', 'email', 'contactType'],\\u000a\\u000a  sections: [\\u000a    { name: 'identity',    title: 'Identity',     order: 1 },\\u000a    { name: 'contactInfo', title: 'Contact Info', order: 2 },\\u000a    { name: 'preferences', title: 'Preferences',  order: 3 }\\u000a  ],\\u000a\\u000a  properties: [\\u000a    { class: 'Long', name: 'id', hidden: true },  // seqNo key for DAO\\u000a\\u000a    // ── Identity ────────────────────────────────────────────────────────────\\u000a    {\\u000a      class: 'String',\\u000a      name: 'name',\\u000a      label: 'Full Name',\\u000a      placeholder: 'Enter full name',\\u000a      section: 'identity',\\u000a      gridColumns: 6,\\u000a      required: true,\\u000a      minLength: 3\\u000a    },\\u000a    {\\u000a      class: 'String',\\u000a      name: 'contactType',\\u000a      label: 'Type',\\u000a      section: 'identity',\\u000a      gridColumns: 6,\\u000a      view: {\\u000a        class: 'foam.u2.view.ChoiceView',\\u000a        choices: [['PERSONAL', 'Personal'], ['BUSINESS', 'Business']]\\u000a      }\\u000a    },\\u000a    {\\u000a      class: 'String',\\u000a      name: 'organization',\\u000a      section: 'identity',\\u000a      gridColumns: 8,\\u000a      // labelFormatter is ONE-TIME. Use data.prop$ slots for reactive labels.\\u000a      // 'this' = Element, 'data' = DemoContact instance.\\u000a      labelFormatter: function(data) {\\u000a        this.add(data.contactType$.map(function(contactType) {\\u000a          return contactType === 'BUSINESS' ? 'Organization Name' : 'Employer';\\u000a        }));\\u000a      },\\u000a      // visibility: function() — show/hide based on a sibling property.\\u000a      // Parameter names tell FOAM which properties to watch.\\u000a      visibility: function(contactType) {\\u000a        return contactType\\u000a          ? foam.u2.DisplayMode.RW\\u000a          : foam.u2.DisplayMode.HIDDEN;\\u000a      }\\u000a    },\\u000a\\u000a    // ── Contact Info ─────────────────────────────────────────────────────────\\u000a    {\\u000a      class: 'String',\\u000a      name: 'email',\\u000a      label: 'Email',\\u000a      section: 'contactInfo',\\u000a      gridColumns: 6,\\u000a      supportingLabel: 'Used for login and notifications'\\u000a    },\\u000a    {\\u000a      class: 'String',\\u000a      name: 'phone',\\u000a      label: 'Phone',\\u000a      section: 'contactInfo',\\u000a      gridColumns: 6,\\u000a      optionalBorder: true  // toggle switch — field hidden until enabled\\u000a    },\\u000a    {\\u000a      class: 'FObjectArray',\\u000a      of: 'foam.u2.demos.DemoAddress',\\u000a      name: 'addresses',\\u000a      label: 'Addresses',\\u000a      section: 'contactInfo',\\u000a      gridColumns: 12,\\u000a      view: function(_, X) {\\u000a        return {\\u000a          class: 'foam.u2.view.TitledArrayView',\\u000a          valueView: {\\u000a            class: 'foam.u2.detail.VerticalDetailView',\\u000a            of: 'foam.u2.demos.DemoAddress',\\u000a            propertyWhitelist: {\\u000a              'type':    { gridColumns: 4 },\\u000a              'street':  { gridColumns: 8 },\\u000a              'city':    { gridColumns: 6 },\\u000a              'country': { gridColumns: 6 }\\u000a            }\\u000a          }\\u000a        };\\u000a      }\\u000a    },\\u000a\\u000a    // ── Preferences ──────────────────────────────────────────────────────────\\u000a    {\\u000a      class: 'Int',\\u000a      name: 'age',\\u000a      label: 'Age',\\u000a      units: 'years',\\u000a      section: 'preferences',\\u000a      gridColumns: 4\\u000a    },\\u000a    {\\u000a      class: 'String',\\u000a      name: 'notes',\\u000a      label: 'Notes',\\u000a      section: 'preferences',\\u000a      gridColumns: 12,\\u000a      optionalBorder: true,\\u000a      view: { class: 'foam.u2.tag.TextArea', rows: 3 }\\u000a    },\\u000a    {\\u000a      class: 'Boolean',\\u000a      name: 'active',\\u000a      label: 'Active',\\u000a      section: 'preferences',\\u000a      gridColumns: 4,\\u000a      value: true  // used by ComicsAction gating in ComicsV3Demo\\u000a    }\\u000a  ]\\u000a});\\u000a\\u000a",
			"autoRun": true
		},
		"border": {
			"oldTitleStyle_": "h300"
		},
		"shown": false,
		"padding_st": "16px"
	},
	{

		"flowName": "intro",
		"cmd": "markdown",
		"value": {
			"class": "foam.core.reflow.Markdown",
			"markdown": "## PropertyBorder\\u000a`foam.u2.PropertyBorder` wraps a single property's input view with its label, supporting label, validation message, units, and optional-toggle. It is what `SectionView` renders for every property in a `DetailView` — but you can also use it directly for fine-grained control over individual fields.\\u000a\\u000a### Class Hierarchy\\u000a\\u000a```\\u000afoam.u2.AbstractPropertyBorder  (abstract view: Provides all basic functionality)\\u000a  └── foam.u2.PropertyBorder    (default: renders a set of labels above and validation below the view)\\u000a  └── foam.u2.DetailView.PropertyBorder    (specific in foam.u2.DetailView: offers a single line propertyBorder)\\u000a```\\u000a\\u000a`AbstractPropertyBorder` does all the logic (visibility, error slots, labelFormatter). `PropertyBorder` provides the default vertical layout and CSS.\\u000a\\u000a### Key Properties\\u000a\\u000a| Property | Type | Description |\\u000a|----------|------|-------------|\\u000a| `prop` | Property axiom | **Required.** The axiom to render (e.g. `MyModel.MY_PROP`). |\\u000a| `data` | FObject | The model instance. Bound to the inner view. |\\u000a| `config` | Map | Override any property attribute for this render only. Does **not** mutate the original property. |\\u000a| `viewArgs` | Map | Extra args forwarded directly to the underlying property view. |\\u000a\\u000a### Context Export\\u000a\\u000a`AbstractPropertyBorder` declares:\\u000a\\u000a```javascript\\u000aexports: [ 'data as objData' ]\\u000a```\\u000aChild views that need the parent FObject (e.g. `CurrencyView` resolving the currency sibling) receive it automatically as `objData`. In custom property views **outside** a PropertyBorder or if you choose to write your own view you must provide this yourself.\\u000a\\u000a##### NOTE:\\u000aThroughout this  demo you will see \\u000a\\u000a```javascript\\u000a.startContext({ data: <someValue> }).....endContext()\\u000a```\\u000aThis is required when you use PropertyBorders without any data in the context. In most FOAM applications this is rarely the case but if you have data linking issues with your properties, this might be the cause.\\u000a"
		},
		"border": {
			"oldTitleStyle_": "h300"
		},
		"padding_st": "16px"
	},
	{

		"flowName": "shorthandDoc",
		"cmd": "markdown",
		"value": {
			"class": "foam.core.reflow.Markdown",
			"markdown": "### The .__ Shorthand\\u000a\\u000aEvery FOAM Property axiom has a `__` getter that returns a proxy which renders as a `PropertyBorder` when added to the DOM. This is the idiomatic way to render a property with its border in custom views.\\u000a\\u000a```javascript\\u000a// Set data in context first — __ wires data$ from X.data$ automatically\\u000a.startContext({ data: myInstance })\\u000a  .add(MyModel.NAME.__)          // renders PropertyBorder for NAME\\u000a  .add(MyModel.EMAIL.__)\\u000a.endContext()\\u000a```\\u000a\\u000aDefined in: [foam/u2/PropertyViewRefinements](https://github.com/kgrgreer/foam3/blob/5df71882aae714bcfa2ec64dc9c9e02fe2bd2433/src/foam/u2/Element2.js#L1760)\\u000a\\u000aTry adding another property in the example below to see how it works."
		},
		"border": {
			"oldTitleStyle_": "h300"
		},
		"padding_st": "0 16px"
	},
	{

		"flowName": "shorthandExample",
		"cmd": "example",
		"value": {
			"class": "foam.core.reflow.example.Example",
			"code": "var DC = foam.u2.demos.DemoContact;\\u000avar contact = DC.create({\\u000a  name: 'Jane Doe',\\u000a  email: 'jane@example.com',\\u000a  contactType: 'BUSINESS',\\u000a  organization: 'Acme Corp',\\u000a  age: 32,\\u000a  active: true\\u000a});\\u000a// <Class>.<AXIOM_NAME>.__\\u000astart().startContext({ data: contact })\\u000a  .add(DC.NAME.__)\\u000a.endContext().end();"
		},
		"border": {
			"oldTitleStyle_": "h300"
		},
		"padding_st": "16px"
	},
	{

		"flowName": "configDoc",
		"cmd": "markdown",
		"value": {
			"class": "foam.core.reflow.Markdown",
			"markdown": "### Configuring property border's rendering\\u000a\\u000a#### config\\u000a\\u000a`config` is a shallow override applied to a **clone** of the property, so the original model is never changed. Any property attribute can be overridden: `label`, `placeholder`, `units`, `view`, `labelFormatter`, etc.\\u000a\\u000a```javascript\\u000a.startContext({ data: myInstance })\\u000a  .tag(MyModel.EMAIL.__, {\\u000a    config: { label: 'Work Email', placeholder: 'name@company.com' }\\u000a  })\\u000a.endContext()\\u000a```\\u000a\\u000a#### viewArgs: forwarded to the inner view\\u000a\\u000aSometimes you may want to pass extra properties to the view that is already configured on the property definition, you can use the PropertyBorder's viewArgs property for this.\\u000a```javascript\\u000a.tag(MyModel.DESCRIPTION.__, { viewArgs: { rows: 6, cols: 80 } })\\u000a```"
		},
		"border": {
			"oldTitleStyle_": "h300"
		},
		"padding_st": "16px"
	},
	{

		"flowName": "configExample",
		"cmd": "example",
		"value": {
			"class": "foam.core.reflow.example.Example",
			"code": "var DC = foam.u2.demos.DemoContact;\\u000avar contact = DC.create({ name: 'Jane Doe' });\\u000astart().startContext({ data: contact })\\u000a  .add(\\"Original Property:\\")\\u000a  .tag(DC.EMAIL.__)\\u000a  .tag(DC.NOTES.__)\\u000a  .br()\\u000a  .add(\\"Overriden Property\\")\\u000a  .tag(DC.EMAIL.__, { config: { label: 'Work Email', placeholder: 'name@company.com' } })\\u000a  .tag(DC.NOTES.__, { viewArgs: { rows: 2}})\\u000a.endContext().end();"
		},
		"border": {
			"oldTitleStyle_": "h300"
		},
		"padding_st": "0 16px"
	},
	{

		"flowName": "unitsDoc",
		"cmd": "markdown",
		"value": {
			"class": "foam.core.reflow.Markdown",
			"markdown": "#### units\\u000a\\u000aSet `units` on the property definition. `PropertyBorder` renders the unit string after the input (e.g. \\"years\\").\\u000a\\u000a#### supportingLabel\\u000a\\u000aSet `supportingLabel` on the property to show a hint line below the input. `PropertyBorder` renders it in a secondary text style."
		},
		"border": {
			"oldTitleStyle_": "h300"
		},
		"padding_st": "16px"
	},
	{

		"flowName": "unitsExample",
		"cmd": "example",
		"value": {
			"class": "foam.core.reflow.example.Example",
			"code": "var DC = foam.u2.demos.DemoContact;\\u000avar contact = DC.create({ name: 'Jane Doe', email: 'jane@example.com', age: 32 });\\u000a// AGE has units: 'years' defined on the property\\u000astart('p').add('AGE with units:').end();\\u000astart().startContext({ data: contact }).add(DC.AGE.__).endContext().end();\\u000a// EMAIL has supportingLabel: 'Used for login and notifications'\\u000astart('p').add('EMAIL with supportingLabel:').end();\\u000astart().startContext({ data: contact }).add(DC.EMAIL.__).endContext().end();"
		},
		"border": {
			"oldTitleStyle_": "h300"
		},
		"padding_st": "0 16px"
	},
	{

		"flowName": "validationDoc",
		"cmd": "markdown",
		"value": {
			"class": "foam.core.reflow.Markdown",
			"markdown": "### Validation\\u000a\\u000a`PropertyBorder` automatically shows the error returned by `validateObj` or `internalValidateObj`. The error appears in the default text color when the field is empty, and switches to destructive color once the user has entered a value. Read the validation doc for more details on validating properties and objs. \\u000a\\u000aIf a property has a default value (usually empty string or 0 or undefined), the property border renders the error as a muted string under the input field, however when the user inputs an invalid value the PropertyBorder adjusts to display the error in red as well as a red border around the field.\\u000a\\u000a```javascript\\u000a// In model definition with no extra PropertyBorder config needed:\\u000a{\\u000a  class: 'String',\\u000a  name: 'name',\\u000a  required: true,\\u000a  minLength: 3\\u000a}\\u000a```"
		},
		"border": {
			"oldTitleStyle_": "h300"
		},
		"padding_st": "16px"
	},
	{

		"flowName": "validationExample",
		"cmd": "example",
		"value": {
			"class": "foam.core.reflow.example.Example",
			"code": "var DC = foam.u2.demos.DemoContact;\\u000a// Empty contact — NAME has required: true that returns 'Required.'\\u000a// The error will show in default color; type one char to see the error change colours and then disappear once the value is valid\\u000avar empty = DC.create();\\u000astart().startContext({ data: empty }).add(DC.NAME.__).endContext().end();"
		},
		"border": {
			"oldTitleStyle_": "h300"
		},
		"padding_st": "0 16px"
	},
	{

		"flowName": "optionalDoc",
		"cmd": "markdown",
		"value": {
			"class": "foam.core.reflow.Markdown",
			"markdown": "// THIS FEATURE HAS BEEN REMOVED UNTIL WE CAN HAVE BETTER UX FOR THIS\\u000a\\u000aSet `optionalBorder: true` on the property definition to render a small toggle switch next to the label. When toggled off, the property is set to `null`; toggling on restores the previous value.\\u000a\\u000a```javascript\\u000a{\\u000a  class: 'String',\\u000a  name: 'phone',\\u000a  optionalBorder: true\\u000a}\\u000a```"
		},
		"border": {
			"oldTitleStyle_": "h300"
		},
		"shown": false,
		"padding_st": "16px"
	},
	{

		"flowName": "optionalExample",
		"cmd": "example",
		"value": {
			"class": "foam.core.reflow.example.Example",
			"code": "var DC = foam.u2.demos.DemoContact;\\u000a// PHONE has optionalBorder: true — click the toggle next to the label\\u000avar contact = DC.create({ phone: '+1 416 555 0199' });\\u000astart().startContext({ data: contact }).add(DC.PHONE.__).endContext().end();"
		},
		"border": {
			"oldTitleStyle_": "h300"
		},
		"shown": false,
		"padding_st": "16px"
	},
	{

		"flowName": "controllerDoc",
		"cmd": "markdown",
		"value": {
			"class": "foam.core.reflow.Markdown",
			"markdown": "### ControllerMode and PropertyBorder\\u000a\\u000a`AbstractPropertyBorder` listens to `controllerMode$` from context. `VIEW` mode restricts the inner view to read-only.\\u000a\\u000a```javascript\\u000athis.startContext({ controllerMode: foam.u2.ControllerMode.VIEW, data: myData })\\u000a  .tag(MyModel.NAME.__)\\u000a.endContext()\\u000a```"
		},
		"border": {
			"oldTitleStyle_": "h300"
		},
		"padding_st": "16px"
	},
	{

		"flowName": "controllerExample",
		"cmd": "example",
		"value": {
			"class": "foam.core.reflow.example.Example",
			"code": "var DC = foam.u2.demos.DemoContact;\\u000avar CM = foam.u2.ControllerMode;\\u000avar contact = DC.create({ name: 'Jane Doe' });\\u000astart('div').style({ display: 'flex', gap: '2rem' })\\u000a  .start('div')\\u000a    .start('p').addClass('p-label').add('RW (default)').end()\\u000a    .startContext({ data: contact })\\u000a      .add(DC.NAME.__)\\u000a    .endContext()\\u000a  .end()\\u000a  .start('div')\\u000a    .start('p').addClass('p-label').add('VIEW mode').end()\\u000a    .startContext({ data: contact, controllerMode: CM.VIEW })\\u000a      .add(DC.NAME.__)\\u000a    .endContext()\\u000a  .end()\\u000a.end();"
		},
		"border": {
			"oldTitleStyle_": "h300"
		},
		"padding_st": "0 16px"
	},
	{

		"flowName": "labelFormatterDoc",
		"cmd": "markdown",
		"value": {
			"class": "foam.core.reflow.Markdown",
			"markdown": "### Reactive labelFormatter\\u000a\\u000a`labelFormatter` is called **once** at render time (`this` = Element, `data` = model instance). To make the label react to property changes, map over a slot:\\u000a\\u000a```javascript\\u000a{\\u000a  name: 'organization',\\u000a  labelFormatter: function(data) {\\u000a    // data.contactType$map() is a slot\\u000a    this.add(data.contactType$.map(function(contactType) {\\u000a      return contactType === 'BUSINESS' ? 'Organization Name' : 'Employer';\\u000a    }));\\u000a  }\\u000a}\\u000a```\\u000a\\u000aToggle **Contact Type** in the example below and watch the Organization label update live — without any re-render of the whole form."
		},
		"border": {
			"oldTitleStyle_": "h300"
		},
		"padding_st": "16px"
	},
	{

		"flowName": "labelFormatterExample",
		"cmd": "example",
		"value": {
			"class": "foam.core.reflow.example.Example",
			"code": "var DC = foam.u2.demos.DemoContact;\\u000a// ORGANIZATION has a labelFormatter that maps over contactType$.\\u000a// Change Contact Type to watch the Organization label update reactively.\\u000avar contact = DC.create({ contactType: 'BUSINESS', organization: 'Acme Corp' });\\u000astart().startContext({ data: contact })\\u000a  .add(DC.CONTACT_TYPE.__)\\u000a  .br()\\u000a  .add(DC.ORGANIZATION.__)\\u000a.endContext().end();"
		},
		"border": {
			"oldTitleStyle_": "h300"
		},
		"padding_st": "0 16px"
	}
]""",
"lastModified":"2026-04-29T19:31:32.345Z"
})
