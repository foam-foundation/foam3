,0.021577924,-0.10577913,-0.0121885715,0.061200984,0.03328753,-0.024990799,0.017284883,0.07441425,-0.049896445,0.0788734,0.031873733,0.08434095,0.008845539,-0.040910948,-0.021252401,0.03089351,0.053817138,-0.042218395,0.031549472,0.0040175817,0.029743284,0.034570362,-0.02519148,0.03087308,-0.013766699,-0.041561056,-0.022136493,0.08412869,-0.012252532,-0.10097071,0.010650616,-0.010419848,-0.03049977,-0.060161907,0.013700112,-0.09833517,0.016277207,-0.020139525,-0.016642025,0.0141305635,-0.036038425,0.107540086,0.032058444,0.014911318,0.027421165,0.062460635,-0.0019878938]})
