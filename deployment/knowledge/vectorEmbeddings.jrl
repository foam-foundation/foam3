c({id:"VsSpring:4",text:"Dependency Management\nFOAM has a sophisticated multi-tier system:\n- requires: for class dependencies (factory methods) 7\n- imports: for runtime dependency injection of services 8\n- javaImports: for Java code generation imports 9\n- Works across networks for distributed services 10\n\nSpring Boot uses:\n- @Autowired or constructor injection for dependency injection\n- Maven/Gradle for build-time dependencies\n- Standard Java imports\n- Service discovery for distributed systems (Spring Cloud)",sourceId:"VsSpring",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.08662443,-0.05780317,-0.003461325,-0.0880265,0.08049913,-0.006797625,-0.034166384,-0.026434524,-0.075769424,-0.012254009,0.0052354382,-0.019758161,0.041504797,0.0047931154,0.07795897,-0.0660817,0.07462453,-0.06325331,0.029401299,-0.0183193,0.0014452386,-0.02431234,-0.095540926,0.004081638,-0.05192277,0.042053316,-0.010641584,-0.09832804,-0.02470218,-0.065646484,-0.014228596,0.08520032,-0.02384989,-0.014986957,-0.09589908,0.08926965,0.03654277,0.012467384,0.0043617184,-0.0010986475,-0.05957481,-0.03222466,0.057543382,-0.0597058,0.022120034,-0.07731384,-0.032651197,-0.038243145,-0.03729862,-0.013198567,0.0025188343,-0.07545033,0.012259344,0.055190034,0.031373203,0.010571926,0.07480568,0.043235276,-0.07841038,0.005159355,-0.05036433,0.022765284,-0.030610546,0.018317416,-0.0071492065,-0.052487705,0.021013685,-0.005068219,0.04725389,-0.08483432,-0.067065075,-0.026448414,0.013787543,-0.0034691207,-0.07725871,0.08010768,0.06649551,0.052441984,0.08580376,-0.05557097,0.011534458,0.19158715,0.015609294,0.0067322636,-0.038726825,-0.004577423,0.022691721,-0.027262742,0.0055581396,0.08718311,0.037570633,-0.077184096,0.025600007,0.002785694,-0.07492609,0.05022643,-0.0912795,-0.041353285,0.0037844374,0.043604366,0.014208796,0.033466768,0.11162442,-0.01838063,0.03890012,0.041279133,-0.091356516,0.001825029,0.024432413,-0.0017749721,-0.03434666,-8.30329E-4,-0.011027506,-0.052852895,0.