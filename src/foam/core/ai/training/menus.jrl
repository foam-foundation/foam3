// Default ML Lab menu section, only built with the ml flag (see core/ai/pom.js).
// An app can use it as is, or override any entry by id in its own menus.jrl.

p({
  "class": "foam.core.menu.Menu",
  "id": "ml",
  "label": "ML Lab",
  "authenticate": true,
  "handler": {"class": "foam.core.menu.SubMenu"}
})

p({
  "class": "foam.core.menu.Menu",
  "id": "ml.scripts",
  "parent": "ml",
  "label": "Scripts",
  "order": 1,
  "authenticate": true,
  "handler": {
    "class": "foam.core.menu.DAOMenu2",
    "config": {"class": "foam.comics.v2.DAOControllerConfig", "daoKey": "scriptDAO"}
  }
})

