c({id:"Axioms:1",text:"What are Axioms?\nAxioms are the core mechanism by which FOAM models define class structure and functionality. 1  They are defined with a pseudo-interface that includes optional installInClass(cls) and installInProto(proto) methods. 2\n\nThe basic axiom interface is formally defined in foam.lang.Axiom: 3",sourceId:"Axioms",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[0.012621446,-0.028994177,-0.0026474372,-0.06260046,0.035314538,0.0067509883,-0.028890679,0.026042167,-0.027781095,-0.016376175,-0.0012979892,-0.04719631,0.048908908,-0.021600893,0.03893486,-0.010483167,0.016828133,-0.027553137,0.0042094686,0.009546648,0.10033771,0.027382813,-0.09250425,-0.0014575257,-0.08070117,0.12071881,0.007098888,-0.13227163,-0.013601775,-0.00290921,-0.038334254,8.1300543E-4,0.059733413,0.0014670428,0.023293244,0.041073676,0.050216205,-0.05803301,0.004123617,0.048445582,-0.022295939,-0.061461452,-0.013572542,-0.028302869,0.08010732,0.07695321,0.015204695,-0.012018806,-0.01468307,0.0259065,-0.02652636,-0.0015731265,-0.06485228,0.014748898,0.116779484,0.13866322,0.03205263,0.05607997,-0.06604723,-0.098980606,0.040026322,0.021747047,-0.028456684,0.09548867,-0.010471478,0.07402009,-0.007109083,0.016088137,-0.0263453,0.032701727,-0.049045194,0.0058324677,0.0357963,-0.012113495,-0.04303469,0.022447206,0.042079184,0.05508915,0.014040728,0.0010607386,-0.09814981,0.06763602,0.036608644,-0.023346892,0.011242073,0.04361081,0.041999564,-0.08937139,-0.06469397,-0.012640933,0.06701423,-0.024139602,-0.01846543,-0.04445398,0.06069063,0.027297456,0.041743666,-0.06776066,-0.04928088,0.058931988,-0.0043042605,-0.0074269585,0.008267984,-0.045591023,0.019658769,-1.2850935E-4,-0.0487449,-0.060903046,-0.0074525047,0.03292653,-0.014089953,-0.025109569,-0.033774722,-0.062151145,0.033746887,0.023103604,-0.022506053,-0.02392591,0.028736861,-0.09141054,-0.009178273,-0.016313333,0.10209993,-0.0095370095,0.09930897,0.021651149,-0.05222365,5.1961424E-34,-0.04357478,-0.031840