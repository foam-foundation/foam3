p({
  "class":"foam.core.boot.CSpec",
  "name":"JDBCConnectionSpec",
  "lazy":false,
  "lazyOrder":-1,
  "serve":false,
  "class":"foam.core.boot.CSpec",
  "service":{
    "class":"foam.dao.jdbc.JDBCConnectionSpec",
    "databaseServer":"postgresql",
    "hostName":"localhost",
    "databaseName":"testSQLDAO",
    "userName":"foam_user",
    "userPassword":"foam_password",
    "port":5432
  }
})

p({
  "class":"foam.core.boot.CSpec",
  "name":"testEmployeeDAO",
  "serve":false,
  "serviceScript":"""
    jdbcSpec = x.get("JDBCConnectionSpec");
    if ( jdbcSpec == null ) {
      foam.core.logger.StdoutLogger.instance().error("testEmployeeDAO,JDBCConnectionSpec not found");
      throw new RuntimeException("testEmployeeDAO,JDBCConnectionSpec not found");
    }
    x = x.put("JDBCConnectionSpec", jdbcSpec);
    x = x.put("JDBCDataSource", new foam.dao.jdbc.JDBCPooledDataSource(x, "PoolA"));
    postgresdao = new foam.dao.jdbc.PostgresDAO(x, foam.dao.jdbc.test.TestEmployee.getOwnClassInfo());
     return new foam.dao.EasyDAO.Builder(x)
      .setSeqNo(true)
      .setAuthorize(false)
      .setRuler(false)
      .setOf(foam.dao.jdbc.test.TestEmployee.getOwnClassInfo())
      .setInnerDAO(postgresdao)
      .build()
      .addTableIndex("totallynewindex3", new foam.lang.PropertyInfo[] { foam.dao.jdbc.test.TestEmployee.FIRST_NAME, foam.dao.jdbc.test.TestEmployee.ID });
  """
})


