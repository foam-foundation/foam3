p({"class": "foam.core.reflow.Flow", "category": "FLOAT", "name": "Function Blocks", "description": "Tests the function command: a block whose returned value later blocks read under its name, instead of a value parked on globalThis.", "version": 1, "script": "[{\"flowName\": \"testResults\", \"cmd\": \"testresults\", \"value\": {\"class\": \"foam.core.reflow.float.TestResults\", \"total\": 6}}, {\"flowName\": \"intro\", \"cmd\": \"markdown A **function** block runs like a script block but keeps what its code returns as the block's value, so other blocks read that value by the block's name instead of through globalThis. The blocks below build a chain - a DAO read, a count over it, a DAO built from it - and the tests assert each link.\"}, {\"flowName\": \"regions\", \"cmd\": \"dao region\", \"value\": {\"class\": \"foam.core.reflow.DAOPrompt\", \"label\": \"All regions\", \"columns\": \"name,countryId,isoCode\"}}, {\"flowName\": \"canadaRows\", \"cmd\": \"function\", \"value\": {\"class\": \"foam.core.reflow.function.Function\", \"code\": \"// Read the DAO once. Whatever this returns is the block's value.\\nvar rs = await regions.filteredDAO.select();\\nreturn rs.array.filter(r => r.countryId === 'CA');\\n\", \"autoRun\": true}, \"shown\": false}, {\"flowName\": \"canadaCount\", \"cmd\": \"function\", \"value\": {\"class\": \"foam.core.reflow.function.Function\", \"code\": \"// A function reading another function: canadaRows ran to completion\\n// before this block started.\\nreturn canadaRows.length;\\n\", \"autoRun\": true}, \"shown\": false}, {\"flowName\": \"canadaDAO\", \"cmd\": \"function\", \"value\": {\"class\": \"foam.core.reflow.function.Function\", \"code\": \"// Returning a DAO makes the block usable wherever a DAO is. A block whose\\n// name ends in DAO is bound without the suffix too, so canada works as well.\\nvar dao = foam.dao.MDAO.create({ of: foam.core.auth.Region }, x);\\ncanadaRows.forEach(r => dao.put(r));\\nreturn dao;\\n\", \"autoRun\": true}, \"shown\": false}, {\"flowName\": \"rowsInDAO\", \"cmd\": \"function\", \"value\": {\"class\": \"foam.core.reflow.function.Function\", \"code\": \"// Reads the DAO the block above returned.\\nvar s = await canadaDAO.select();\\nreturn s.array.length;\\n\", \"autoRun\": true}, \"shown\": false}, {\"flowName\": \"noReturn\", \"cmd\": \"function\", \"value\": {\"class\": \"foam.core.reflow.function.Function\", \"code\": \"// No return at all - that is a script block, not a function.\\nvar x = 1;\\n\", \"autoRun\": false}, \"shown\": false}, {\"flowName\": \"test1\", \"cmd\": \"test(canadaCount,'A function block binds the value its code returned')\", \"value\": {\"class\": \"foam.core.reflow.float.Test\", \"description\": \"A function block binds the value its code returned\", \"expected\": \"13\"}}, {\"flowName\": \"test2\", \"cmd\": \"test(canadaRows$block.value.cls_.id,'The block keeps the Function, so the code stays editable')\", \"value\": {\"class\": \"foam.core.reflow.float.Test\", \"description\": \"The block keeps the Function, so the code stays editable\", \"expected\": \"foam.core.reflow.function.Function\"}}, {\"flowName\": \"test3\", \"cmd\": \"test(canadaRows$block.value.output.trim(),'A run logs what came back, not the whole array')\", \"value\": {\"class\": \"foam.core.reflow.float.Test\", \"description\": \"A run logs what came back, not the whole array\", \"expected\": \"Array(13)\"}}, {\"flowName\": \"test4\", \"cmd\": \"test(rowsInDAO,'A function can return a DAO that later blocks read')\", \"value\": {\"class\": \"foam.core.reflow.float.Test\", \"description\": \"A function can return a DAO that later blocks read\", \"expected\": \"13\"}}, {\"flowName\": \"test5\", \"cmd\": \"test(noReturn$block.value.errors_ ? 'invalid' : 'valid','Code with no return fails validation')\", \"value\": {\"class\": \"foam.core.reflow.float.Test\", \"description\": \"Code with no return fails validation\", \"expected\": \"invalid\"}}, {\"flowName\": \"test6\", \"cmd\": \"test(regions$block.value.cls_.id,'A block that is not a Function still binds its own value')\", \"value\": {\"class\": \"foam.core.reflow.float.Test\", \"description\": \"A block that is not a Function still binds its own value\", \"expected\": \"foam.core.reflow.DAOPrompt\"}}, {\"flowName\": \"summary\", \"cmd\": \"markdown\", \"value\": {\"class\": \"foam.core.reflow.Markdown\", \"reactions_\": {\"markdown\": \"'**' + canadaCount + '** of those regions are Canadian, listed below.'\"}}}, {\"flowName\": \"canadaTable\", \"cmd\": \"dao(canadaDAO, 'Canadian regions')\", \"value\": {\"class\": \"foam.core.reflow.DAOPrompt\", \"label\": \"Canadian regions\", \"columns\": \"name,isoCode,code\"}}]"})
