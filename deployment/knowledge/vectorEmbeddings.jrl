c({id:"DaoGotchas:0",text:"DaoGotchas\nCatalog of non-obvious DAO behaviors: decorator context, argless find/select, frozen objects, TTL branch, LTE and unset dates.\n\nKeywords: dao, gotchas, context, decorators, frozen objects, knowledge\n\n<flow name=\"DaoGotchas\" category=\"DOC/GUIDE\" spid=\"foam\" description=\"Catalog of non-obvious DAO behaviors: decorator context, argless find/select, frozen objects, TTL branch, LTE and unset dates.\" keywords=\"dao,gotchas,context,decorators,frozen objects,knowledge\"/>",sourceId:"DaoGotchas",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.108542934,-0.0055060354,-0.009812638,0.04675524,-0.03728672,-0.08163896,0.040915743,-0.030751193,-0.06665076,-0.01628286,-0.030457454,-0.062987834,-0.049602404,-0.03126372,-0.009753981,0.04246404,0.025833335,0.0020938131,-0.022687513,-0.045270305,0.11032538,0.032097377,-0.051175177,-0.022552809,0.012310685,0.017719874,-0.030227307,-0.056379046,0.0027762214,-0.09559402,-0.015487819,0.09037399,-0.022519672,0.008729292,0.04064066,0.052341364,0.024193047,-0.005187491,0.018477747,0.011607055,0.024965102,0.026200647,-0.010413571,-0.009501263,0.00797617,-0.0017350471,-0.06602869,-0.018743886,-0.051153515,-0.030875636,-0.10028884,-0.010217361,-0.014856244,0.035254154,0.007772529,0.026663978,-1.7140686E-4,-0.021670861,-0.030751904,-0.0076024123,-0.02385085,-0.0031362746,-0.030151373,0.11812729,-0.025152482,0.014940591,-0.015499439,0.052327435,0.1348983,9.730452E-5,-0.04086233,0.0012859656,0.013582078,0.0010527715,0.06096837,0.008569598,0.036847655,0.025347382,0.07983707,-0.12067801,0.0015893684,0.056755524,-0.021179667,0.030226462,-0.02857158,0.05365105,-0.012487494,-0.025610859,0.041365094,0.028852094,-0.029721346,-0.065324225,0.01995953,-0.068784684,-0.066660576,-0.032203674,0.051596615,-0.0014340957,-0.031953715,0.08272676,-0.007082339,0.027883956,-0.00597337,0.009502044,-0.016245915,-0.063257754,-0.026945548,-0.050861035,-0.02541689,0.036717203,-0.054597635,0.037430637,0.0027