c({id:"VsSpring:14",text:"Dependencies\nFOAM has no runtime dependencies, but does have build dependencies:\n\n git\n npm\n nodejs (version >= 16)\n maven\n* java (version >= 11)\n\nOnce dependencies are installed, update FOAM's javascript dependencies:\nFrom the root of the FOAM repository, execute:\n\n    ./build.sh --install\n\n    sudo chown -R $USER /opt\n\n\n\nFile: README.md (L160-163)\nmarkdown",sourceId:"VsSpring",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[0.021610595,-0.0319522,0.061222013,-0.02023091,0.0892841,-0.035276327,-0.05459621,-0.0726087,-0.05237624,-0.060195345,0.037858903,-0.054619852,-0.026290113,0.034099374,0.07549323,0.036316015,0.069688134,-0.04969043,0.08598641,0.07143381,-0.006449173,0.0462894,-0.020147892,-0.016815279,-0.0125313345,0.008591553,-0.014215701,-0.09892441,-0.05436193,-0.024896475,0.03352247,-0.03473854,0.05282973,-0.10361422,0.0061457343,0.06542902,-0.004731879,-0.062690824,-5.1546667E-5,0.029260274,-0.025068088,0.0362281,0.06849734,-0.07371637,0.013857784,-0.024180047,0.0110918265,-0.02337688,0.0033334177,0.07549192,0.009889579,-0.08538252,0.024172809,-0.11250766,0.05398866,0.04994524,0.0063927537,0.13233493,-0.03371066,0.03539987,2.4348918E-4,0.063210584,-0.011888056,-0.0032131406,0.045259878,0.006730781,0.014326482,-0.040701203,-0.05773289,-0.027015204,-0.03520878,-0.031878773,0.048945792,-0.09939939,-0.09235469,0.15113144,0.023635508,0.040198196,0.07064001,0.013479924,-0.07974435,0.04676494,0.064323135,0.004901035,-0.04595197,0.065627985,0.13722576,-0.019992588,0.01071508,0.05053867,0.026223192,-0.07941377,0.010465807,0.0013053393,0.002178783,-0.021806708,-0.046762772,0.035968978,-0.05830384,0.038336392,-0.12430269,-0.00584546,0.08485091,-0.035155997,-0.011507869,0.066882804,-0.060145576,0.0049778554,0.024190383,0.048937514,-0.0020873486,-0.02871221,0.048723806,-0.032900214,0.048103046,-0.029704764,0.025091179,-0.10354255,-0.011381309,-0.017965324,0.082501516,-0.065463275,0.10022231,-0.012539238,0.010263