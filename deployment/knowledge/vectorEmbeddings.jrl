0.027279818,0.037870813,0.036262423,0.02107984,-0.015703967,0.064764045,-0.023936808,-0.059831787,0.063047126,-7.0751976E-4,-0.08678705,-0.028988741,0.025414152,-0.03386851,0.10079777,-0.05145607,0.017212112,0.07621769,0.05634958,-0.023044901,0.038054954,0.013904831,0.007844443,0.08427114,0.02972072,-0.045174442,-0.07003392,-0.07939133,0.008309764,0.053868722,0.07100281,-0.11226831,0.03912718,0.054045904,-0.06446496,0.029310955,0.14739369,0.04413124,0.015144112,-0.08257427,-0.07693619,0.040387962,0.0389869,-0.08300684,-0.044848803,0.034916524,0.04599049,-0.081496924,0.068058334,-0.08089829,0.04088322,0.020878483,-0.045370575,0.002144841,-0.042658474,0.05852394,0.032796312,-0.012909987,-0.0039996677,0.047151044,-0.042444445]})
