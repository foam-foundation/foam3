p({
  "class":"foam.core.menu.Menu",
  "id":"knowledgeBase",
  "label":"Knowledge Base",
  "order":-299,
  "themeIcon": "documentation",
  "keywords": ["doc", "documentation", "flow", "help", "question", "knowledge"],
  "handler":{
    "class":"foam.core.menu.DAOMenu2",
    "config":{
      "class":"foam.comics.v2.DAOControllerConfig",
      "daoKey":"flowDAO",
      "browseTitle":"Knowledge Base",
      "createMenu":"knowledgeBaseAsk",
      "createTitle":"Ask AI",
      "createPredicate":{"class":"foam.mlang.predicate.False"},
      "editPredicate":{"class":"foam.mlang.predicate.False"},
      "deletePredicate":{"class":"foam.mlang.predicate.False"},
      "importPredicate":{"class":"foam.mlang.predicate.False"},
      "exportPredicate":{"class":"foam.mlang.predicate.False"},
      "searchColumns": [
        "category",
        "keywords",
        "access",
        "spid"
      ],
      "filterOptions": [
        "category",
        "keywords",
        "name",
        "source",
        "access",
        "spid",
        "version",
        "created",
        "lastModified",
        "lastModifiedBy",
        "createdBy"
      ],
      "predicate":{
        "class":"foam.mlang.predicate.In",
        "arg1":{
          "class":"foam.mlang.Constant",
          "value":"knowledge"
        },
        "arg2":{
          "class":"__Property__",
          "forClass_":"foam.core.reflow.Flow",
          "name":"keywords"
        }
      },
      "summaryView":{
        "class":"foam.core.reflow.FlowDocumentGroupingList",
        "showEmptyMessage":true,
        "groupExpr":{
          "class":"foam.lang.__Property__",
          "forClass_":"foam.core.reflow.Flow",
          "name":"category"
        },
        "rowView":{
           "class":"foam.core.reflow.FlowDocumentRowView"
        }
      }
    }
  }
})

// Ask AI on the Knowledge Base page: its button opens a chat that answers from the docs the
// user can open (ragService, over flowDAO). Shown only to users granted menu.read.knowledgeBaseAsk;
// without it the page shows no button. Hidden from the side menu under internal.
p({
  "class":"foam.core.menu.Menu",
  "id":"knowledgeBaseAsk",
  "label":"Ask AI",
  "themeIcon":"documentation",
  "handler":{
    "class":"foam.u2.dock.DockMenu",
    "view":{ "class":"foam.ai.llm.RAGChatPanel", "daoKeys":["flowDAO"] }
  },
  "parent":"internal"
})
