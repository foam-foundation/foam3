c({id:"claude:1",text:"FOAM for LLMs\nFOAM (Feature-Oriented Active Modeller) is a model-driven, cross-platform application framework for JavaScript, Java, and Swift. Everything is a model. Everything is composable. Code is a liability; declarations are assets.\n\n---",sourceId:"claude",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[0.013306248,-0.06637762,-0.036251016,0.001312544,0.09948617,-0.0037497368,-0.005815927,0.030196248,-0.043446727,-0.019294975,0.02990386,0.013116922,0.077574305,0.02528803,0.021872075,0.037429664,0.0941039,-0.038905267,0.0431973,0.032207906,0.0083380565,0.11757866,-0.055161513,0.063144036,-0.03368479,0.03224563,0.0024845656,-0.061930075,0.02076838,-0.03384937,0.0052706604,0.0024205698,0.02158189,-0.045805756,-0.009790379,-0.04888005,-0.03551204,-0.016660912,-0.09112937,-0.023694219,-0.05124787,-0.083735675,0.027126571,-0.074708655,0.07312602,0.045842435,-0.034896817,-0.06332128,-0.04317592,0.03340842,0.031505417,-0.11625491,0.010043069,-0.046519876,0.02178373,-0.016576562,0.00830017,-0.008186695,-0.056779865,0.0057564257,0.05175206,0.0064398795,-0.006536486,0.095390245,0.080225185,-0.0014993433,0.008670306,0.047980353,0.011209078,-0.0853428,-0.03328343,-0.057469226,0.042837057,0.010501595,-0.011538727,0.0018356468,0.05776837,0.056369368,0.13303044,0.045713987,-0.031899128,0.03288292,-0.0010612551,-0.042861223,-0.019129869,0.024483675,0.03731699,-0.019703256,0.03865359,-0.0020393177,0.026633535,-0.06373771,-0.0068581183,0.006383499,-0.040203966,-0.028176285,-0.041294828,0.013014275,-0.016984887,0.043996487,-0.0940924,0.042643722,0.048108377,-0.020482158,-0.021302143,-0.033072848,-0.0030544351,-0.02628918,0.052439064,0.04808422,0.008680309,0.027675536,0.056150783,0.018164191,0.05816746,-0.09787095,0.014805602,-0.014314797,0.055670183,-0.05563017,8.802667E-4,-0.029173173,0.073417984,-0.03549546,0.07595656,-0.06267828,-0.060525306,-2.6123628E-33,0.019928215,-0.044418838,0.02101821,0.06612773,0.10804714,-0.007715505,0.007705736,0