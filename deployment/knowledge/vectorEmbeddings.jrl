c({id:"SPID:13",text:"Best Practices\n1. Implement ServiceProviderAware for tenant-specific data models\n2. EasyDAO handles SPID automatically - detects the interface and adds ServiceProviderAwareDAO\n3. SPID is externalTransient - computed at runtime, not persisted or sent over the network\n4. Global SPID () is for shared data accessible to all tenants\n5. Theme SPID* provides fallback for unauthenticated access scenarios",sourceId:"SPID",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.060239904,0.005230899,-0.054615546,-0.006799394,-0.0060749655,0.051013622,-1.1426062E-4,-0.041229837,-0.053448807,-0.0018614711,0.07207895,0.042485204,0.015376779,0.01032639,-0.00393113,0.026435325,0.11095066,-0.015482439,0.012089662,0.025549164,-0.0024857586,-0.0428421,-0.06256705,0.03944181,-0.046239324,-0.0710303,0.0867303,0.004240594,0.043109033,0.066112176,0.07912765,0.030643055,-0.017466411,-0.012385325,-0.0035402386,-0.04879161,0.050677795,0.08606156,-0.0063487296,0.029224996,0.050629895,-0.03519474,-0.082159035,0.014150531,0.072912745,-0.075916864,-0.03492908,0.06238908,-0.016431278,0.026193261,0.10974768,-0.018689074,0.018457688,0.060513478,-0.05535497,0.011405615,-0.03668091,0.02131364,0.03545412,2.7746795E-4,0.07688341,-0.017834486,0.03885818,0.040822532,0.009576132,0.001447682,0.05082665,-0.0032706754,-0.041630775,-0.07885368,2.6433144E-4,0.009745826,-0.06632158,0.0015263645,-0.0031159555,0.014649651,-0.04491593,-0.035592753,-0.010081757,-0.11190078,0.036376994,0.07586622,0.0022589946,0.06141962,-0.0011832374,-4.938758E-4,-0.016174702,0.046007633,0.0011532712,0.016850108,0.043841653,0.062017616,0.016199766,-0.068923734,0.071242385,0.07795664,-0.050460637,-0.07055593,-0.05914784,-0.016574297,-0.10349817,0.03220893,0.007853591,0.054137137,0.077024244,0.0175107,0.10235561,-0.047685992,-0.015225315,0.041860245,-0.046889,0.060413934,-0.016264716,-0.008796614,0.0018378278,0.012985125,-0.05468114,0.013730118,0.03171777,-0.087174125,-0.031196956,-0.006655605,0.033