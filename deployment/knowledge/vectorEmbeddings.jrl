c({id:"MultiPartKeys:1",text:"MultiPart Keys (Composite Primary Keys)\nFOAM supports composite primary keys through the ids property. When a model needs a unique identifier composed of multiple fields, you define an ids array listing the property names that form the composite key.\n\nFOAM automatically generates an ID class for models with multipart keys. This generated class includes methods for creating, parsing, and comparing composite IDs.",sourceId:"MultiPartKeys",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[0.01639874,-0.022112945,-0.03634658,-0.038426537,0.03177201,-0.022846276,-0.013175746,-0.028530063,0.051500075,-0.032958128,-0.006422344,-0.026134586,0.0803992,-0.059538484,-0.011177407,-0.011927324,-0.022824205,-0.020161849,0.0053963424,0.038743045,-0.01508873,-0.0071748868,-0.04790741,-0.004109816,-0.08650049,0.0679339,0.06676398,-0.065579765,-0.0011276706,-0.07104546,0.029905053,-0.0045545627,0.006757043,-0.012373551,-0.013390539,-9.886659E-4,0.03238397,0.021455605,-0.015084402,-0.028556703,-0.025140718,-0.08690061,0.00628072,0.020952497,0.07464093,0.05522258,-0.09151104,0.014679895,0.017046623,3.564399E-4,-0.022838438,-0.043885905,-4.2409007E-4,0.08742212,0.0034577297,0.026676588,-0.040105205,-0.010665085,0.0047147837,0.017232308,0.0750766,0.04228787,0.07226878,0.028473342,0.08371661,0.015693543,-8.787233E-4,-0.03379733,-0.048514746,-0.079404935,0.016677024,0.009439898,0.024082618,-0.020926384,0.019601338,0.09747409,0.014971074,-0.020620834,0.05436163,0.0507466,-0.07777495,0.10089686,0.02067043,-0.049475394,0.049298223,0.035335906,0.0056147934,-0.02866951,-0.10943593,0.047752153,-0.0052517666,-0.09294693,0.07075727,-0.0106792385,0.019994719,0.012529764,0.011140569,0.002848883,0.06440175,0.020729236,-0.104381554,0.008971019,0.012705234,-0.06132247,0.0062842127,-0.052827317,0.007346024,-0.03379704,0.0191405,-9.3732186E-4,-0.042856906,0.011782487,8.723731E-4,0.021269422,0.0028056798,-0.03301424,0.017328313,0.052120104,0.098785676,-0.0568919