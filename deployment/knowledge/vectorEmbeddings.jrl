-6.025461E-8,-0.052872304,-0.06087365,-0.0507726,0.03373056,0.069634125,0.017134968,0.008276764,0.012358504,-0.035980716,-0.04287178,0.032206196,0.055490494,-0.024581583,-0.01642088,0.028748594,0.06293084,0.010602977,-0.016041795,-0.093372315,0.009268028,0.0111750895,-0.052835595,-0.079564966,0.085112795,0.0065850997,-0.022193724,-0.034322783,-0.021081755,-0.028108269,0.051797483,-0.050457656,0.06897064,0.017509786,-0.04722194,-0.05366703,0.07519355,0.0137186395,-0.03880361,-0.008240161,0.06495675,0.07786037,-0.012222761,-0.017610777,0.007154237,0.0799601,-0.056305245,-0.02514644,-0.03806464,0.039852697,-0.050925825,0.018847955,-0.019917771,-0.03572152,-0.021002406,-0.008153898,-0.061145935,-0.058185536,-0.04593394,0.06653914,0.012537503,0.045913238,0.06546138,0.12538025,-0.0054878388]})
