020999677,-0.016744297,0.022489691,0.019747825,0.06650416,0.019527491,0.010854638,-0.013905302,-0.048712313,-0.0039349026,0.045105107,0.051840536,0.04979838,0.030547354,0.053861663,0.070131466,-0.02347673,-0.09690828,-0.08289535,-0.009469297,0.010060779,-0.02968372,-0.06344381,0.06120533,0.03015618,-0.07809792,-0.013864473,0.058693353,0.08853671,0.04446976,0.027807875,0.034885406,0.019172493,0.011899064,-0.03616725,0.033086117,0.11939787,-0.06668249,-0.031739287,0.0281832,-0.020299632,-0.017717622,-0.041943703,-0.018119035,0.025176309,-0.003051928,-0.055466767,-0.025043404,0.023826022,0.014551543,0.0032354821,0.015562875,-0.08997015,0.023379283,-0.0028993078,-0.038851243,-0.06750051,-0.020502709,0.074122585,0.055711456,0.0050161993,0.07258338,0.124032,-0.01246498]})
