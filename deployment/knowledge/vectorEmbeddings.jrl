c({id:"ApplicationController:8",text:"Notifications\njavascript\n// Transient toast (disappears automatically):\nthis.notify('Record saved', '', this.LogLevel.INFO, true);\n\n// Persistent notification (stored in notificationDAO, shown as toast on next load):\nthis.notify('Approval required', 'Please review item #42', this.LogLevel.WARN, false);\n\n\nnotify(message, subMessage, severity, transient, icon)\n\n- transient: true \u2014 adds a NotificationMessage element directly to the controller (auto-dismisses)\n- transient: false \u2014 puts a Notification record to myNotificationDAO; subToNotifications() subscribes to that DAO and displays it as a toast via displayToastMessage()\n\nToast TTL for persistent notifications is 12 hours (NOTIFICATIONTOASTTTL).",sourceId:"ApplicationController",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.051075317,-0.02677203,0.03913463,0.055153877,0.07942933,-0.07644033,0.08777909,-4.698338E-4,0.069914915,-0.07704656,-0.0017406536,-0.0027425415,-0.04195277,0.06933603,-0.032320738,0.013470523,0.094962,-0.060894113,-0.041900296,-0.049226157,0.12079065,0.03617896,0.029512854,0.07230447,0.03912059,-0.013544292,0.061744824,-0.05360537,-0.021189673,-0.02822036,0.006895651,-0.021849224,-0.020219915,-0.057392415,-0.038405173,-0.0068260645,0.073755205,0.017727034,0.04472581,-0.047327712,0.07929428,-0.013746163,0.008126873,-0.022131506,0.04532909,-0.041205887,-0.08072219,-0.039695986,-0.02356024,0.04463372,0.059144784,-0.02744442,0.107249975,0.0050264616,-0.036889024,0.05297688,-0.0046770605,0.010013899,-0.044522423,0.027144706,-0.009726086,-0.06426983,0.03583329,0.026922544,0.02088991,0.0012473804,0.048971236,0.013972778,0.05884302,0.05259437,0.011705798,0.04359606,0.0521009,-0.02320721,0.0074534,-0.055456724,0.018773591,0.031463083,-0.018127134,-0.0025239068,-0.0067139333,-5.056667E-4,-0.010379097,-0.041657526,0.012564422,-0.015015957,0.046739984,0.00748453,-0.00515109,-0.007932998,-0.008514783,-0.04276094,-0.06274347,0.05708