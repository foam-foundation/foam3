c({id:"claude:17",text:"9. Inheritance and Mixins\njavascript\nfoam.CLASS({\n  name: 'PremiumInvoice',\n  extends: 'com.example.Invoice',   // single inheritance\n  mixins:  ['foam.lang.auth.Authorizable'], // copies axioms directly\n\n  properties: [\n    { class: 'Float', name: 'discountRate', value: 0.1 }\n  ]\n});\n\n\nimplements is like mixins but with proper method override semantics (override handling via SUPER). mixins does a direct axiom copy.\n\n---",sourceId:"claude",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.09328384,0.04141558,2.552404E-5,-0.018179372,0.01059348,-0.014251545,0.0042065773,-0.006434646,-0.03784392,-0.039719652,0.058215786,-0.020634858,-0.041808795,3.431464E-4,0.09401475,0.034075074,0.0137117375,-0.011303878,-0.06737438,0.047447957,0.05665129,-0.02885088,-0.042369626,0.05203458,0.037768327,0.05779278,0.007481692,-0.055058893,0.06329286,-0.02173767,0.024062088,0.06153395,0.008860341,0.012864765,-0.09264231,0.06702828,0.045117818,0.049861606,0.060948938,0.006388579,0.0201268,0.018010627,0.0028309224,-0.038848758,-0.010635177,-0.03876847,-0.040898945,-0.007859535,0.04216178,0.051400553,-0.015000668,-0.07682119,-0.0070593334,0.039852366,0.037876263,0.05832003,-0.018878827,0.031933356,-0.04406183,-0.078586556,-0.09770499,0.046118543,0.01113681,0.054924384,-0.005674873,-0.0103287045,0.0011398701,0.10796017,-0.10891253,0.027245216,0.018796405,0.0073223943,0.07404575,0.034573767,0.014515798,0.028263465,0.023627358,-0.033008993,-0.02664781,-0.0034148318,-0.0607004,-0.039606743,-0.010064494,0.01667967,0.0057046907,0.036097374,0.05218478,-0.09798834,-0.027432412,-0.024527593,0.0030969498,-0.007608007,0.017276542,-0.044364568,0.03440116,0.022973608,-0.053169593,-0.09535274,0.0022940373,0.086918876,-0.0499942,0.0116323875,0.086950116,0.01750745,0.04161363,-0.015581159,-0.05748067,-0.03573744,0.043560695,0.06605937,-0.006729661,-0.03361087,-3.1531617E-4,-0.055804346,-0.008943973,0.041373298,-0.01924517,-0.056032863,0.046286423,-0.06