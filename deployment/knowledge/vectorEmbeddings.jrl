654777,-0.0578068,-5.8250794E-8,-0.043698777,-0.05023553,-0.0051590516,0.06630296,0.09339604,-0.04992452,-0.026221031,0.0814486,-0.013657633,-0.005562605,0.043276556,0.114627674,0.060189817,0.022368908,0.037115093,-0.072196595,0.0012531019,-0.033542592,-0.15414877,-0.028240034,-0.023935644,-0.048550803,-0.0637407,0.011072992,0.011716083,-0.0054019745,0.061633393,-0.01742789,0.102904245,0.03390132,-0.029069975,0.04261905,0.043998394,0.07474075,-0.0041041626,0.0742836,0.07029096,0.026655072,-0.026316008,8.2924543E-4,0.023624057,-0.012539607,0.03348131,0.029016813,0.027807977,0.053310446,-0.08457638,0.02250801,0.087172836,0.0036387015,-0.045270655,-0.041656423,-0.05329878,0.001488705,0.013394284,-0.06581618,-0.010517716,-0.05466329,0.04731097,0.050734427,0.09746506,-0.008971226,0.016050132,0.03835613]})
