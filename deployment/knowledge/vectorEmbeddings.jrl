// Modified by admin admin (42) at 2026-10-02T11:19:30.897+0000
c({id:"Compaction:5",text:"The roll step is an atomic rename, run as a job on the journal's own assembly line so that it is ordered against every put and remove without blocking them. A rename moves no data, so the cutover costs the same at any journal size. (It used to be a copy + truncate, because a rename leaves an open writer pointing at the renamed file; the line lets the writer be closed first and reopened after.)\n\nKey point: live traffic never stops. It writes to the fresh users from the instant of the rename, while the snapshot is built separately.\n\n---",sourceId:"Compaction",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.08553162,0.04063933,-0.021149406,-0.03202115,-0.014130192,-0.04411853,-0.03678419,-0.036702584,0.069567725,0.0638366,0.068284914,0.13913128,-0.0469736,-0.06313159,-0.06320329,-0.035713304,-0.095006615,0.048245095,-0.06095473,0.044965573,0.009243264,-0.015419804,-0.023128735,0.014039619,0.05347009,-0.0029491084,-0.08268753,0.011731953,0.031394973,-0.07602086,0.04099726,0.067472994,-0.025516367,0.0179553,0.048255716,0.0016502561,-0.01058847,0.0064886217,0.034363072,-0.019263761,0.10182716,-0.022459768,-0.032434482,-0.007817221,-0.0044839405,-0.036771987,0.0063484404,0.0065963874,-0.03623142,0.04641778,-0.012677262,-0.034989268,-0.03712852,0.102378294,-4.744478E-4,-0.03669536,0.050223418,0.019018264,-0.05585049,0.054896526,-0.022755282,-0.008606791,-0.04988442,0.0026930196,0.031700365,-0.02868602,0.11812341,-0.05466833,0.021207128,0.0020034206,-0.026343752,0.04171102,-0.024585232,-0.004110119,0.0120323915,-0.05825874,-0.023775024,0.06304457,-0.06502776,-0.014313955,0.02693856,-0.09619718,0.043382592,0.012366912,-0.017805072,-0.01669774,0.024224056,-0.065992035,0.05146375,0.017830221,-0.015741702,0.038567763,0.066719666,-0.05295994,-0.032331347,-0.006814532,-0.017134171,0.08805803,0.03274719,0.011075222,0.007681312,0.07033139,-0.02984773,-0.045920167,0.021761619,-0.078653984,-0.017604304,-0.017813751,-0.03574891,0.05680966,