c({id:"demo:1",text:"{ name: 'Taco Truck',\n      predicate: 'cuisine = Mexican AND spicy = TRUE AND dineIn = FALSE AND priceLimit < 15' },\n\n{ name: 'Burrito Bar',\n      predicate: 'allergicToWheat IS FALSE AND cuisine = Mexican AND priceLimit < 20' },\n\n{ name: 'Upscale Mexican',\n      predicate: 'cuisine = Mexican AND priceLimit >= 30' }\n  ]\n});\n\nvar picker = com.example.RestaurantPicker.create({\n      allergicToSeafood: false,\n      priceLimit: 1000\n    });\n\nconsole.log('Picket:', picker);\n    console.log('Choices:', picker.getCandidates());\n\n// Properties are resolved immediately, narrowing candidates.\n    // Then loop: ask questions, set answers, converge.\n    var q = picker.selectNextQuestion();   // -> { name: 'cuisine', ... }\n    console.log('Next Question:', q.name);\n    picker.cuisine = 'Asian';\n\nconsole.log('Choices:', picker.getCandidates());\n\nq = picker.selectNextQuestion();       // -> { name: 'spicy', ... }\n    console.log('Next Question:', q.name);\n    picker.spicy = 'TRUE';\n\nconsole.log('Choices:', picker.getCandidates());\n    var results = picker.getCandidates();\n    picker.applyOutcome(results[0]);       // sets picker.name = 'Thai Restaurant'\n    console.log(picker.name);",sourceId:"demo",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.0030799718,0.05799785,0.060230907,0.09020226,-0.010524022,0.03717132,0.058225572,0.02561014,0.10560973,-0.05582356,0.009810838,-0.15441442,0.016539084,-0.033065766,0.054120846,0.015892884,-0.05809231,-0.06720581,-0.08454619,-0.09837065,0.048531733,-0.030069835,-0.011939174,0.033298157,-0.005831929,-0.032769404,0.02031555,-0.03741967,-0.05068739,0.0045240954,-0.05525298,-0.022616578,-0.027112493,-0.005523982,-0.05526732,-0.0751788,-0.078202195,-0.033475284,-0.031731717,-0.025009194,-0.090883195,-0.038498912,-0.017368466,-0.09099765,0.08646306,-0.047818135,-0.11576245,0.08321702,0.068856455,0.034198932,-0.036024388,-0.0029984945,0.010291977,-0.050511476,0.05921458,0.051