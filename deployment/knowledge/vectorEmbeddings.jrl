c({id:"VsSpring:11",text:"Use Cases\nFOAM excels at:\n- Cross-platform applications (web, mobile, server)\n- Complex data models with rich metadata\n- Applications requiring code generation\n- Systems needing built-in persistence without external databases\n- Enterprise applications with sophisticated business logic\n\nSpring Boot excels at:\n- Java-based microservices\n- REST API development\n- Integration with Spring ecosystem (Security, Cloud, Batch)\n- Traditional database-backed applications\n- Rapid prototyping with auto-configuration",sourceId:"VsSpring",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.019903509,-0.0021752198,-0.06470064,-0.06345387,0.014723332,0.014477381,-0.10406879,0.047947578,0.005643603,-0.007923091,-5.9133297E-4,0.003913603,0.070775874,-0.030818012,0.09719422,0.0043296698,0.088614844,-0.043187805,0.0535114,0.018657865,-0.03940576,0.010403749,-0.074967,-0.0032781882,0.03128985,0.026877344,0.01984686,-0.07183101,-0.024287727,-0.06316694,-0.027081462,0.06786189,-0.044039547,0.042862605,-0.03155638,0.027767234,0.051666766,-0.039840996,-3.9454884E-4,-0.046016105,-0.044447485,-0.0776382,-0.020358743,0.013512974,0.01939233,-0.04546892,-0.032205265,-0.014254082,1.7504202E-4,0.07372032,-0.05747133,-0.08630064,0.039626915,0.03659234,-0.020411551,-0.01021139,0.006154534,0.009481391,-0.010581075,-0.013200775,0.01979816,-0.0435305,0.004396765,0.09017616,0.008061403,0.004873966,-0.07421107,0.022632651,0.008195263,-0.10471262,-0.075319864,-0.04116382,-0.07520716,0.03544372,-0.097312294,0.034118753,-0.029572941,-0.003719465,0.043891013,0.009138207,-0.015184317,0.106877945,-0.05778047,0.08247666,-0.104364865,-0.0063681398,0.059772093,0.032926995,-0.032035477,-0.006739804,0.096483655,-0.022026377,0.06464548,-0.012388662,-0.0737182,-0.01392616,0.00483738,-0.03735409,0.05353615,0.007438225,-0.013526814,0.03164006,0.1010051,0.031332724,-0.023612572,-0.053655557,-0.014236647,-0.016252676,0.01934508,0.021865694,-0.061531994,-0.028624224,-0.0571