// Modified by admin admin (42) at 2026-10-02T11:19:18.134+0000
c({id:"Axioms:2",text:"How Axioms Work\nAxioms install themselves onto a Model's Class and/or Prototype during the class building process. 4  The installation happens in two phases to avoid ordering issues: 5\n\n1. Class Installation: Axioms are first stored in the class's axiomMap_ 6\n2. Installation Execution: Then installInClass() and installInProto() are called to modify the class and prototype 7\n\nAxioms are sorted by priority (default 100) before installation, with higher priority axioms installed first. 8",sourceId:"Axioms",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[5.2169E-4,0.0014576782,0.04623187,-0.07596032,0.018898664,-0.04213855,-0.04104017,0.0065166396,8.9587696E-4,0.022137536,0.0540774,0.05087759,0.013430997,-0.043823384,-0.0064316215,-0.01689446,0.018179607,-0.040139675,-0.07368761,-0.022461612,0.056240756,-0.072628856,-0.041999813,-0.0267417,-0.02590159,0.04846923,0.038866587,-0.026549129,0.0541282,-0.04398631,-0.04571474,-0.0012546472,0.032371555,0.0717571,-0.011330396,0.042516045,0.0707205,-0.03672652,-0.0010697235,0.04468913,-0.028534362,-0.063211516,-0.018286629,-0.012050667,0.06976539,0.05038996,0.027186181,-0.062189855,0.0024613675,-0.04444972,-0.06781983,0.01691528,-0.08567288,0.032085393,-0.024439136,0.13382041,0.06850094,0.031134356,-0.057336245,-0.05262802,-0.029270915,0.012582854,-0.046963133,0.08289628,0.027454823,-0.012787877,0.006319685,0.011748217,0.05018094,0.052352197,-0.0073306155,-0.002399206,0.045928232,-0.021381976,-0.049420796,0.0056938594,0.045182984,0.08905804,-0.016260425,-0.069483586,-0.04504973,8.472346E-4,0.02453449,-0.002296657,0.022549985,0.01862329,0.036922637,-0.06426852,-0.019995604,0.02687575,0.031191472,-0.07069338,-0.06282247,-0.011281483,0.021682737,0.032388076,0.045363456,-0.052884728,-0.01690843,0.06018281,-0.0050466135,-0.032158896,0.056871228,-0.041506305,0.021966685,-0.011643386,-0.096441984,-0.058921136,0.023995237,-0.008831565,0.012366988,-0.027667545,-0.027947031,-0.034996763,-0.0590296