5E-8,0.05690257,-0.05452754,0.041444838,0.07092407,0.07642115,0.010594503,0.03137113,-0.050595537,-0.01524021,-0.026089078,0.06587723,0.1095058,0.12774801,-0.031755414,0.028835515,-0.03463693,0.018458212,-0.07300862,-0.14533617,0.0055089435,-0.010984946,-0.07813219,-0.020514762,0.03530204,0.024380842,-0.058555037,0.12382523,-0.019487046,0.09984385,0.039789807,-0.047622878,0.011047863,0.026028052,0.07329884,-0.010311658,0.021318557,0.0181732,0.04541254,0.065229386,0.116685204,0.0052048564,-0.025012529,-0.062187895,0.016270604,-0.020434929,0.03290537,-0.091604635,-0.03770554,-0.023777429,0.009872964,-0.074783325,0.019992927,-0.07058351,0.006674322,0.042510115,-0.07199443,0.08362526,-0.0338092,0.07202309,0.0642717,0.040684514,-0.03853923,0.030072583,0.015944386]})
