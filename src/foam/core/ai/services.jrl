// ── services.jrl ──
// Claude as default provider, with PM and logging decorators.
// Stack: Client → Skeleton → Logging → PM → ClaudeLLMService
// API key is resolved via credentialDAO / vaultSecrets — see deployment/docker/credentials.jrl.

p({
  "class":"foam.core.boot.CSpec",
  "name":"llmService",
  "lazy":true,
  "serve":true,
  "authenticate":true,
  "boxClass":"foam.ai.llm.LLMServiceSkeleton",
  "client":
    """
      {
        "class": "foam.ai.llm.ClientLLMService",
        "delegate": {
          "class": "foam.box.SessionClientBox",
          "delegate": {
            "class": "foam.box.HTTPBox",
            "url": "service/llmService"
          }
        }
      }
    """,
  "serviceScript":"""
    return new foam.core.ai.llm.LoggingLLMService.Builder(x)
      .setDelegate(new foam.core.ai.llm.PMLLMService.Builder(x)
        .setDelegate(new foam.core.ai.llm.provider.ClaudeLLMService.Builder(x).build())
        .build())
      .build();
  """
})

// ── To swap providers, change the credential id and provider class: ──
//   "foam/llm/openai"   + foam.core.ai.llm.provider.OpenAILLMService
//   "foam/llm/deepseek" + foam.core.ai.llm.provider.DeepSeekLLMService
//   Ollama: no credential needed — OllamaLLMService.Builder(x).build() directly

// ── Embedding service — default provider: Ollama ──
// To swap provider, replace OllamaEmbeddingServiceImpl with another EmbeddingService impl.
p({
  "class":"foam.core.boot.CSpec",
  "name":"embeddingService",
  "lazy":true,
  "serve":true,
  "authenticate":false,
  "boxClass":"foam.ai.vector.EmbeddingServiceSkeleton",
  "serviceScript":"return new foam.core.ai.vector.provider.OllamaEmbeddingServiceImpl(x);",
  "client":"{\"class\":\"foam.ai.vector.ClientEmbeddingService\"}"
})

// ── Vector store DAO — persisted embedding index ──
p({
  "class":"foam.core.boot.CSpec",
  "name":"vectorStoreDAO",
  "lazy":true,
  "serve":true,
  "authenticate":true,
  "client":"{\"of\":\"foam.ai.vector.VectorEmbedding\"}",
  "serviceScript":"""
    foam.dao.DAO jdao = new foam.dao.EasyDAO.Builder(x)
      .setOf(foam.ai.vector.VectorEmbedding.getOwnClassInfo())
      .setPm(true)
      .setAuthorize(true)
      .setJournalType(foam.dao.JournalType.SINGLE_JOURNAL)
      .setJournalName("vectorEmbeddings")
      .build();
    return new foam.ai.vector.VectorStoreDAO.Builder(x)
      .setDelegate(jdao)
      .build();
  """
})
