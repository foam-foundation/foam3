57998896,0.010656826,-0.072105505,-0.092854135,-0.008655959,0.009791341,-0.04839987,-0.10042885,-5.884951E-5,-0.01805485,0.10250009,-0.06381507,-0.06700267,0.006018651,0.02925709,0.016249122,-0.06919217,0.048388053,0.0829544,0.01732208,0.049601097,0.016614547,0.117882185,-0.003291699,-0.0027565425,0.027695231,-0.0037995086,0.016626704,-0.058831636,0.03467756,-0.008561471,0.008192404,-0.066618614,-0.008137228,0.07874868,0.024621038,0.0150606735,-0.0050367345,-0.016471073,0.009024227,-0.07963515,0.018825995,0.021859854,0.038535424,-0.052383658,0.021673815,0.03256534,0.028729936,0.059635576,-0.0021021855,0.036328025,0.017967744,0.010497418,0.03482509]})
