c({id:"Context:0",text:"Context\nExplains FOAM's immutable hierarchical Context (X): get/put/putFactory API and the system/session/request context hierarchy.\n\nKeywords: context, dependency injection, x, imports, exports, knowledge\n\n<flow name=\"Context\" category=\"DOC/GUIDE\" spid=\"foam\" description=\"Explains FOAM's immutable hierarchical Context (X): get/put/putFactory API and the system/session/request context hierarchy.\" keywords=\"context,dependency injection,x,imports,exports,knowledge\"/>",sourceId:"Context",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.02037947,-0.024313444,-0.023426497,-0.052777216,0.06418674,-0.034462027,0.052975766,0.013066549,-0.03256033,-0.08116432,0.029408805,-0.07611232,0.08537192,0.020521054,0.068672106,0.06213301,0.07421921,-0.026581712,-0.013237729,0.0014869045,0.1132761,0.07236954,-0.026745562,0.0046789423,-0.060317893,0.09784339,-0.057343584,-0.09073884,0.07760293,-0.010890781,0.011609782,0.10992494,-0.035519343,-0.03472287,0.009270949,0.09144544,0.008651759,-0.051232364,-0.0028119716,-0.009356871,-0.014995535,-0.004397221,-0.017819377,-0.015657652,-0.022752918,0.007190565,-0.008969531,-0.009461078,-0.03859158,0.03469232,-0.07384383,-0.04992074,-0.044226855,-0.03441873,0.041694462,0.05929923,0.00939208,0.05080668,-0.044916026,0.026583806,0.021290606,0.011329194,-0.037197504,0.07501472,0.040339403,-0.026899131,-0.052309897,0.02511582,0.032225735,-0.13762504,-0.07611669,-0.0048824004,-0.03192538,-0.029068504,0.010882992,0.04029778,0.041879278,0.003931096,-0.0018468397,-0.060176343,5.774667E-4,0.14278214,0.021431806,-0.009649989,-0.003171903,0.03942657,0.08338149,-0.031996306,-0.026368104,0.08918975,-7.3396467E-4,-0.1836518,0.010489174,-0.011779259,0.044121373,0.018915238,-0.038835503,0.004759287,-0.013233118,0.03406505,-0.086494416,-0.010017462,-0.026648039,-0.032521237,-0.019731391,-0.016128983,-0.10057877,-0.00999022,0.0011506462,0.035003565,-0.10529807,0.04145457,-0.0021009992,-0.034092024,-0.016835826,