43,0.039799806,-0.0026721945,-5.701454E-8,-0.09973344,0.022779321,-0.0044383816,0.0049409675,0.0036410685,-0.017005363,0.05989797,0.08243877,-0.055531118,-0.067218244,0.049924117,0.0662279,0.06548662,0.036651433,0.056738388,-0.0054596737,0.013745474,0.015754083,-0.050239462,0.012316512,0.033187255,0.002477652,0.010360513,0.06651902,0.034549557,-0.035016716,0.009899739,9.740318E-4,0.0378049,-0.048838194,-0.056561183,0.046734415,-0.001695718,0.076618075,0.0056231725,-0.072527885,0.047577348,0.001311081,-0.021527141,0.1181853,-0.0018659574,0.033363964,-0.053038392,-0.060507614,0.05400818,-0.011153584,-0.019950919,-0.030888034,0.009316669,0.038670674,-0.054193564,-0.017379602,0.03960523,-0.0045482535,0.10146906,-0.017871343,-0.028878156,0.04100779,0.014988704,0.022675615,0.031340465,0.038534448,0.13289917,-0.011142541]})
