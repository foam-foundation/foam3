c({id:"Build:3",text:"Command Line Arguments\nThree input styles are supported\n\n- single character (-h) - for a very few tasks.\n- GNU getopt word style (--help) plus optional arguments.\n- word style without the leading --, again with optional arguments.\n\nThe word style arguments can be listed individually or comma seperated. \n- For example --cleanAll,all",sourceId:"Build",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.025099576,0.072354525,-0.011986693,-0.008775843,-0.03555607,0.010465537,0.0822224,0.036489394,-0.052453514,0.0027320264,0.013042416,-0.037812524,0.070482224,0.0062252004,0.093950406,0.00898413,-0.044076107,-0.01666302,0.006361717,-0.028341213,-7.336769E-5,0.069721796,-0.0047279815,-0.064069495,-0.05733308,0.0524997,-0.0442876,-0.029509451,0.004103108,-0.024617387,0.040137548,0.03985819,0.07348537,0.020050392,0.04082307,0.03249422,0.05715806,0.040782735,-0.031828295,0.041345797,-0.044787746,0.016178906,-0.06726135,-0.005718039,0.014545583,0.02798437,-0.06400942,-0.011492775,-0.063088425,-0.012309396,-0.04277373,-0.051358327,-0.027431043,-0.0108500365,0.1049093,-0.016917896,-0.043792415,0.032152824,0.040224694,-0.042646654,-0.10517259,0.06029929,-0.1296815,0.022978298,0.0059723505,0.043701973,0.038940128,0.018559404,-0.05689952,0.07467693,-0.0886629,-0.046843782,-0.08915767,-0.042352,-0.03801953,0.11453597,0.023646329,-0.016829737,-0.05262544,-0.061311875,0.023907512,0.038747016,0.0010875394,0.050602164,0.015189082,0.06245156,-0.087502964,0.014553291,0.06638432,0.0151752755,-0.013921838,-0.13275684,-0.039643113,-0.007817583,0.0011970695,0.08400641,-0.042306237,-0.095106624,-0.0925416,0.030018123,-0.029551096,-0.019398453,0.07882106,-0.1001199,0.028871002,0.013497519,0.004697855,-0.031165855,0.0731456,0.032793164,-0.059006914,-0.038519908,-0.0590027,-0.075652786,-0.015079003,0.016402084,0.044192377,-0.059125114,0.06980705,-0.02948241,0.031184148,0.008730321,-0.04694677,0.07176663,-0.023150483,-0.059624095,0.06318516,1.0098504E-33,0