c({id:"SPID:11",text:"Examples of SPID-Aware Classes\nClasses that implement ServiceProviderAware in FOAM3:\n\n- User - Each user belongs to a specific SPID\n- Theme - Themes are scoped per SPID\n- Ticket - Support tickets isolated by SPID\n- Flow - Business flows per tenant\n- Rule - Business rules can be SPID-specific\n- Menu - Menus can be customized per SPID",sourceId:"SPID",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.082533926,-0.056305498,-0.07628605,-0.094895475,0.011479632,0.028057648,0.06935902,-0.078778446,-0.053313624,-0.037693895,-0.0070471787,0.03643465,0.048626896,0.0074919024,0.108303726,-0.027623648,0.043752693,-5.169976E-4,0.0031403704,0.0022567962,0.07723417,0.04800453,-0.083812535,0.06301832,-0.18881299,0.0017183942,0.077587835,-0.10774008,-0.019514423,0.040824383,0.054432143,0.049894486,0.0028523304,-0.06621412,0.049825836,0.0024140796,0.02275547,0.02559723,-0.05060258,0.055234194,-0.029522788,-0.010720525,-0.033874057,-0.047342364,0.076924704,-0.035078384,-0.09823572,0.013155423,-0.036034644,0.011942024,0.044965934,-0.09536406,0.032699525,0.0027840312,-0.071379624,0.014077152,-0.031757493,0.05942943,0.021800809,0.022340097,0.0056263166,-0.01317293,0.023180844,0.009373939,0.013212047,0.00767643,-0.0032096237,-0.006641469,-0.03115872,-0.06195381,-0.018448202,-0.029185027,-6.986663E-4,0.067237504,0.033285543,0.06537126,0.026504653,0.016306149,-0.008718455,-0.10724236,-0.008305208,0.07260235,0.05205134,0.02713939,0.03093695,0.01735915,-0.024897255,-0.01602351,0.0014283496,0.069242574,0.007901137,-0.01578114,0.029834835,-0.11513091,-0.011404547,0.06532995,-0.12598747,-0.102511555,0.020358903,0.052813552,-0.13902354,-0.027718585,0.06435447,0.027050065,0.025507597,0.01945978,-0.0038081277,-0.023312137,-0.04698569,0.05716103,-2.8787245E-4,-0.008522522,0.045154717,-0.056561735,0.019167943,-0.012608885,-0.057227995,0.003097259,0.0560177,-6.0851895E-4,0.017268583,0.009219481,0.03796586,-0.024630785,0.0050246296,0.09075941,-0.03669247,4.