c({id:"Deployment:8",text:"The heartbeat broadcast and monitoring system is disabled by default.  To enable, create services.jrl entries at the application deployment level, enabling both healthSupport and healthHeartbeatService:\n\np({\n  \"class\": \"foam.core.boot.CSpec\",\n  \"name\": \"healthHeartbeatService\",\n  \"enabled\": true\n})\np({\n  \"class\": \"foam.core.boot.CSpec\",\n  \"name\": \"healthHeartbeatMonitor\",\n  \"enabled\": true\n})",sourceId:"Deployment",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.003685933,0.010801683,-0.005210024,-0.027241953,0.0501426,0.016212823,-0.03879449,-0.031578142,0.013392481,-0.037278093,-0.025602564,-0.031997684,0.013636958,0.005578064,0.06652852,-0.0924445,0.12299769,-0.080248736,-1.5564938E-4,0.024361327,-0.03540296,0.045172665,0.042289875,0.050441083,0.001386167,-0.05565711,-0.043276157,0.003060743,-0.010395006,0.010591223,0.103716366,-0.057898898,0.096490085,0.024870168,0.0049857963,0.021519179,0.08006303,-0.0013240475,-0.098096125,0.012839081,0.039103847,-0.03591934,-0.035637163,-0.05992491,0.01825512,-0.05601879,-0.11622671,-0.055107463,0.026076265,0.047907494,-0.0691972,-0.07731506,0.07485395,-0.007510886,0.03035194,0.009248421,-0.015669972,0.05604681,5.0710945E-4,-0.058812577,0.027948784,-0.04401957,0.027377976,-0.007130513,-0.074530415,-0.02535589,-0.015172392,0.033978857,0.07721431,-0.017095959,-0.0065693394,0.00739427,0.100846194,-0.02826333,-0.018320777,0.09636878,-0.030486248,-0.07572824,0.046707828,-0.035512973,-0.0702683,-0.04382821,-0.05249783,0.015032814,-0.037509013,0.041762967,0.004409745,-0.07354208,-0.059732843,0.029441023,-0.005999553,-0.033717822,-0.0031114055,-0.0013829934,-0.011859834,0.052176055,-0.07574167,0.02250444,-0.0010759465,0.0015763311,0.03317618,-9.52706E-4,0.044113044,0.11171278,0.059192583,-0.0174639,-0.14971107,0.066802174,0.037203338,-0.0036580157,0.03882699,0.046231218,0.0895859,0.012813793,0.050605606,0.08610332,0.02884382,0.018602751,-0.020240355,-0.00107643