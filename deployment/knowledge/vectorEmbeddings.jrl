.6186246E-8,-0.027500423,-0.010921684,0.028237084,-0.11467198,-0.023021655,-0.008141367,0.093687296,-0.021985725,-0.042929742,-0.03070529,0.0666997,0.06908112,0.016057122,-0.03596197,0.100358084,0.041716065,0.011663451,0.04787457,-0.06474494,0.032848403,-0.008968754,-0.025781754,-0.07347326,0.02296492,0.08782349,-0.013242548,-0.016653962,0.017057419,0.05547901,0.11481484,0.023033876,0.017554387,0.03439366,0.120365635,-0.048835922,0.04594608,0.051379677,0.009599713,-0.0070672175,0.1312264,0.024561508,-0.050472498,-0.014283305,0.038729135,0.085233256,0.023852656,0.017938755,-0.06288278,-0.006589187,-8.474056E-4,-0.07070162,-0.01866083,-0.03470203,0.074861035,0.018783815,-0.06592762,0.039987244,-0.011394255,0.01310367,0.009771176,0.03884818,-0.024063207,0.07817524,0.07617919]})
