c({id:"PropertyGotchas:15",text:"| Goal | Use |\n|---|---|\n| Editor with full label, validation and permission UI | .add(prop.) |\n| Compact editor WITH the permission gate | .tag(prop._, { config: { label: '', reserveLabelSpace: false } }) |\n| Compact editor, forced read-only locally | .startContext({ controllerMode: foam.u2.ControllerMode.VIEW }) \u2026 .endContext() |\n| Compact editor, mode driven by your own slot | .tag(prop, { mode$: someSlot }) |\n| Compact editor with no mode awareness | .add(prop) \u2014 not when permissions matter |\n\n---",sourceId:"PropertyGotchas",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[0.023016535,0.028889082,-0.11637941,0.0780835,0.062416106,0.05842588,0.011594343,0.04067157,-0.021805707,-0.014055035,0.061247613,-0.014367945,-3.9974082E-4,0.023835119,0.048527237,0.059031513,0.04527864,-0.0640957,-0.011994418,-0.0058967825,0.047729243,0.02564395,0.09287912,0.009657218,-0.068971835,0.06285612,-0.08134352,-0.009122348,0.12689956,-0.016227145,0.024546145,0.010352912,0.0020659058,-0.004852244,0.010066743,0.0053356458,0.0052564577,-0.040219583,-0.004000569,-0.0716822,0.043816928,0.020882059,-0.039414544,-7.628454E-4,0.01735982,0.010308343,-0.011992133,-0.07597057,-0.028421734,0.066119984,0.05990485,-0.06858766,-0.015779411,-0.034298275,0.014364292,0.030988738,-0.023683844,-0.031205783,0.027085265,0.012479724,-0.004814322,-0.029273089,-0.03827526,0.012431498,0.0044999,0.08604243,0.011967482,0.024574276,-0.061566174,0.023790749,0.06356939,0.012869503,0.068291344,-0.028977605,0.021574521,-0.07270809,-0.10273971,0.008992418,0.004360541,-0.09896582,0.01844841,0.008568237,-0.024658037,-0.010704063,-0.041645657,0.088161625,0.045185044,0.0012788469,0.052429214,0.049941152,0.027618641,-0.048246026,0.035489023,0.012566219,-0.07759426,-0.051669456,-0.043203603,0.035984218,-0.107071154,0.027915286,-0.061268162,-0.019027479,0.012607984,0.011654287,0.05818319,-0.027839195,0.020452088,0.0042434605,-0.09300863,0.055754963,0.016200842