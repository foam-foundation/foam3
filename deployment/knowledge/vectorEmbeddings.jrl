c({id:"ApplicationController:11",text:"Source Files\n| File | Role |\n|------|------|\n| src/foam/core/controller/ApplicationController.js | The monolithic application shell |\n| src/foam/core/zac/Client.js | ZAC \u2014 the micro-service replacement (in progress) |\n| src/foam/core/zac/index.html | ZAC entry point |\n| src/foam/core/controller/AppStyles.js | Global CSS installed by the controller |\n| src/foam/core/controller/Fonts.js | Font declarations |\n| src/foam/core/theme/Theme.js | Theme model (CSS tokens, nav overrides, app config) |",sourceId:"ApplicationController",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.0337069,0.017065529,-0.0024817397,-0.038618017,0.09383414,-0.008222137,-0.011527244,0.015070476,-0.046394914,-0.00410513,0.03174755,-0.002634035,0.0274432,-0.045393597,0.10059992,-3.3659016E-4,0.036892284,-0.022412842,0.06453529,0.048763342,0.032184232,0.03641913,-0.005026517,-0.025050182,-0.033825014,0.034156207,-0.01074489,-0.03281984,-0.012360996,-0.08801831,0.017076824,0.06314585,0.06360202,-0.06069694,-0.03307078,0.030565599,0.06078444,-0.10297933,-0.016377846,-0.013054815,0.016779635,0.026300434,-0.021663878,-0.0619804,-0.0073463176,-0.06521249,-0.026813889,-0.07157548,-0.015948882,0.08480724,-7.366524E-4,-0.093147464,0.025486685,-0.04636058,-0.0142333945,0.06938592,-0.020910708,0.07253113,0.040189493,0.085127264,0.057227008,0.040626694,-0.025692007,0.068312176,0.083302125,-0.008049316,-0.0021261529,0.017587705,-0.049699087,-0.082668915,-0.030645015,-0.05345661,0.05222372,-0.062013168,-0.05499878,6.1218854E-4,0.03596723,0.03577437,-0.013584603,-0.078586325,-0.037428487,0.0021065718,0.04139,0.003401501,0.03324726,0.1643122,0.048311558,-0.03701211,-0.0066571203,-0.016518218,0.023333248,-0.10324996,0.023475949,-0.01304533,-0.073395,0.016544364,-0.07391064,0.013633318,-0.01590907,0.07844076,-0.09848256,-0.061518885,0.15005508,0.025696106,-0.029283259,-0.01497772,-0.03897006,0.090605095,-0.011916742,0.0361886,-0.006291,-0.00941762