c({id:"Comics:11",text:"Minimal Usage\njavascript\n// Minimal \u2014 config auto-derived from the DAO's of class\ntag({ class: 'foam.comics.v3.DAOController', data: myDAO })\n\n\njavascript\n// Explicit config\ntag({\n  class: 'foam.comics.v3.DAOController',\n  data: myDAO,\n  config: foam.comics.v2.DAOControllerConfig.create({\n    browseTitle: 'Contacts',\n    tableColumns: ['name', 'email', 'active'],\n    detailView: { class: 'foam.u2.detail.SectionedDetailView' }\n  })\n})\n\n\njavascript\n// From a menu journal entry (menus.jrl)\np({\n  \"class\":     \"foam.core.menu.Menu\",\n  \"id\":        \"contacts\",\n  \"label\":     \"Contacts\",\n  \"handler\": {\n    \"class\": \"foam.core.menu.DAOMenu2\",\n    \"config\": {\n      \"class\":    \"foam.comics.v2.DAOControllerConfig\",\n      \"daoKey\":   \"contactDAO\",\n      \"browseTitle\": \"Contacts\"\n    }\n  }\n})\n\n\n---",sourceId:"Comics",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.09979762,0.022806587,-0.07230924,0.05256099,0.04497724,-0.055320717,0.034669675,0.050464198,-0.065114446,-0.035058625,-0.011462561,-0.010857625,-0.03427867,0.027199246,0.061731007,0.024751293,0.04113805,-0.09296145,-0.04209386,0.08181798,0.14007363,0.032796767,0.03914308,-0.09325,-0.024678946,-4.6088317E-4,-0.0069037983,-0.033040408,-0.06587713,-0.043519963,0.06334683,0.040288325,-0.054225016,-0.0058171176,-0.021997135,-0.036961373,0.012847309,0.0036959378,0.01379789,0.011006952,-0.0063222786,0.09102736,-0.040478855,0.010165549,0.028942686,-0.018570539,-0.040783588,0.017993318,-0.0047773095,0.051378913,-0.06384439,-0.008046602,9.907942E-4,-0.05717441,0.003424126,0.09394738,-0.1182963,-0.019217992,-0.0127362395,0.048367016,0.053449195,0.012868079,-0.023476023,0.046405636,0.0058675148,-0.034604162,0.052695226,-0.024569826,-0.029505385,0.015300475,-0.076267086,0.0035931878,0.06379762,0.026980342,0.051275656,-0.041329607,-0.04787157,0.019165292,0.06158748,-0.052540302,0.04051323,0.03409474,0.01225769,0.04418553