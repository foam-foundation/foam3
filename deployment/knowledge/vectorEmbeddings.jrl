c({id:"CrunchForDeveloper:3",text:"CrunchController\nCrunchController contains logic for handling CRUNCH intercepts and\ncreating CRUNCH-specific wizard sequences. It should be provided by\nthe application's main controller in an exported property named\ncrunchController.\n\nCrunchController methods\n\n<foam class=\"foam.flow.widgets.MethodShortSummary\" of=\"foam.u2.crunch.CrunchController\"></foam>",sourceId:"CrunchForDeveloper",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[1.867792E-4,-0.09190545,-0.12110246,0.004300512,-0.033064872,-0.028485386,-0.0090258615,0.040356304,-0.03666957,-0.062186763,0.044001665,-0.022256188,-0.004832088,-0.01902139,-0.0063564726,0.008710473,0.0038169178,-0.07058986,0.0088548055,-0.027900217,0.08210255,0.049871597,0.052087158,0.025078358,-0.068277754,-0.034734398,0.04056778,-0.036292974,0.05207083,0.019199219,0.12560646,0.019661766,0.0830275,-0.0499207,0.07006036,0.0016102504,0.005707807,-0.0030044736,-0.0024926544,-0.008691443,-0.0035398316,-0.025501292,-0.013751782,0.005982066,0.070323534,-0.02093093,-0.061737187,0.0067682667,0.008660572,0.026340218,-0.005519917,-0.034625318,0.017399672,-0.05949094,0.05726263,-0.011740097,-0.027932946,0.064919345,0.025703926,0.03999733,0.04935261,-0.010083009,-0.010686195,0.0399318,0.062250074,-0.004276389,0.013871638,-0.0070603485,0.0053479467,-0.048785444,-0.09839495,-0.030057063,0.021354089,-0.026291616,0.02420674,-0.030350715,0.017057415,-0.054012783,-0.04506087,0.025683112,-0.07732006,0.014820415,0.017315118,-0.036359034,-0.005464237,0.043043233,0.045327008,-0.0032481775,0.02460976,-0.05739892,0.039298914,-0.08299764,0.0058747507,0.0030088786,-0.087107345,0.023707576,0.013048346,-0.036564324,-0.052699257,0.047755178,-0.1353542,-0.0031043177,0.09733853,0.0074454984,-0.0024877724,-0.049099367,0.035927013,-0.0012386739,-0.05523397,0.046232175,0.019967454,-0.0022404452,0.030731712,0.023305481,0.11185428,-0.03846055,0.021419358,0.03261542,-0.07416557,0.003141314,-0.031893376,-0.002305