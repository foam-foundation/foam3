c({id:"Boxes:2",text:"Example\nvar box = HTTPBox.create({ url: 'https://examle.com/some-box-service' });\nvar replyBox = {\n  send: function(envelope) {\n    console.log(\"got reply\", envelope.message);\n  }\n};\n\nbox.send(foam.box.Envelope.create({\n  message: \"hello\",\n  replyBox: replyBox\n}));",sourceId:"Boxes",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[0.020453433,0.027404226,0.026337398,0.05581154,-0.0035342446,-0.11919751,-0.025421953,-0.047461804,0.08850596,-0.06563097,-0.043907322,-0.010336639,-0.09333386,0.015692126,0.033893377,-0.007027508,0.0077981404,-0.043012843,0.0040629916,0.024795258,0.091442555,0.028583147,6.532553E-4,0.0032134522,-0.02660607,-0.06884674,-0.0019293737,-0.042219196,-0.02147686,-0.006208702,0.07966956,-0.068274036,-0.007880843,0.012047,-0.13213937,0.05358497,-0.017673248,-0.014734576,0.029342992,-0.016079266,-0.08394903,0.0064343894,-0.007866771,-0.017583797,0.10014242,-0.022132942,-0.0126893725,0.03338658,-0.0017952984,0.039338365,0.06575683,-0.029631613,-0.03656504,0.06066755,-0.06099762,-4.967906E-4,-0.035508327,0.01029683,-0.03804493,0.062472444,-0.003727632,-0.074762605,0.029555151,-0.027965095,0.045716047,-0.03614501,-0.052260086,0.06499707,-0.114377715,-4.4414526E-5,-0.012368941,0.008679028,-0.018091358,0.031010315,0.0416292,-0.04852517,-0.0045583257,-0.004949472,0.01744742,0.19131944,-0.020103512,-0.094421595,0.022593392,0.028345777,0.0077369483,0.09230202,0.014207082,0.05797397,-0.026124392,-0.025503464,0.0065203174,0.015283707,0.0075229737,0.02315331,-0.06289263,0.03397489,-0.06093407,-0.038648512,-0.06822237,0.01739777,0.050647646,0.0028054444,-0.00713905,-0.07756272,0.057467613,0.0010576083,-0.051627643,0.015591914,0.0021457477,0.04327274,-0.075657055,-0.016309673,0.02530206,0.03585117,0.032977983,-0.04121154,-0.021972623,-0.032151826,0.07430587,-0.026830243,0.07032384,-0.09814554,-0.026316417,-0.038051404,0.0014203633,-0.057791386,0.12952863,-4.3436174E-34,0.08131295,0.015037536,-0.0015276246,0.1226