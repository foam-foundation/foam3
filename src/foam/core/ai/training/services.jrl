// ── Training DAOs ──
// Only built with the ml flag (see core/ai/pom.js).
// trainingRunDAO  — one record per MLXTrainingJob submission; persists loss, status, and adapter path.
// trainingMetricDAO — per-iteration metrics (loss, speed, tokens/sec); multi-part key [runId, iteration].
p({
  "class": "foam.core.boot.CSpec",
  "name": "trainingRunDAO",
  "serve": true,
  "client": "{\"of\":\"foam.core.ai.training.TrainingRun\"}",
  "serviceScript": """
    return new foam.dao.EasyDAO.Builder(x)
      .setOf(foam.core.ai.training.TrainingRun.getOwnClassInfo())
      .setGuid(true)
      .setPm(true)
      .setAuthorize(true)
      .setJournalType(foam.dao.JournalType.SINGLE_JOURNAL)
      .setJournalName("trainingRuns")
      .build();
  """
})

p({
  "class": "foam.core.boot.CSpec",
  "name": "trainingMetricDAO",
  "serve": true,
  "client": "{\"of\":\"foam.core.ai.training.TrainingMetric\"}",
  "serviceScript": """
    return new foam.dao.EasyDAO.Builder(x)
      .setOf(foam.core.ai.training.TrainingMetric.getOwnClassInfo())
      .setPm(true)
      .setAuthorize(true)
      .setJournalType(foam.dao.JournalType.SINGLE_JOURNAL)
      .setJournalName("trainingMetrics")
      .build();
  """
})

// ── Eval DAOs ──
// evalPromptDAO  — library of prompts with rubric items; read by MLXEvalJob before each run.
// evalRunDAO     — one record per MLXEvalJob execution; tracks pass rate and status.
// evalResultDAO  — per-prompt result for one run; composite key [evalRunId, promptId].
p({
  "class": "foam.core.boot.CSpec",
  "name": "evalPromptDAO",
  "lazy": true,
  "serve": true,
  "authenticate": true,
  "client": "{\"of\":\"foam.core.ai.training.EvalPrompt\"}",
  "serviceScript": """
    return new foam.dao.EasyDAO.Builder(x)
      .setOf(foam.core.ai.training.EvalPrompt.getOwnClassInfo())
      .setSeqNo(true)
      .setPm(true)
      .setAuthorize(true)
      .setJournalType(foam.dao.JournalType.SINGLE_JOURNAL)
      .setJournalName("evalPrompts")
      .build();
  """
})

p({
  "class": "foam.core.boot.CSpec",
  "name": "evalRunDAO",
  "lazy": true,
  "serve": true,
  "authenticate": true,
  "client": "{\"of\":\"foam.core.ai.training.EvalRun\"}",
  "serviceScript": """
    return new foam.dao.EasyDAO.Builder(x)
      .setOf(foam.core.ai.training.EvalRun.getOwnClassInfo())
      .setGuid(true)
      .setPm(true)
      .setAuthorize(true)
      .setJournalType(foam.dao.JournalType.SINGLE_JOURNAL)
      .setJournalName("evalRuns")
      .build();
  """
})

p({
  "class": "foam.core.boot.CSpec",
  "name": "evalResultDAO",
  "lazy": true,
  "serve": true,
  "authenticate": true,
  "client": "{\"of\":\"foam.core.ai.training.EvalResult\"}",
  "serviceScript": """
    return new foam.dao.EasyDAO.Builder(x)
      .setOf(foam.core.ai.training.EvalResult.getOwnClassInfo())
      .setPm(true)
      .setAuthorize(true)
      .setJournalType(foam.dao.JournalType.SINGLE_JOURNAL)
      .setJournalName("evalResults")
      .build();
  """
})

