E-8,-0.037774086,-0.013159562,-0.014748093,-0.01371251,0.025731206,-0.06343901,0.033738103,0.045683127,-0.045291394,-8.111112E-4,0.08151115,0.080251895,0.004698967,-0.011285074,-0.008871413,0.043905348,0.025731688,-0.06445085,-0.07171842,0.07365052,0.0072546857,0.007741941,0.020746857,-0.010498971,0.07287755,-0.038851876,0.0042277854,0.064476065,0.03539828,0.047010537,0.02312297,-0.009534065,0.06938417,0.11425243,-0.012335465,-0.03907543,-0.03024151,-3.6790074E-4,0.05879052,0.1406029,0.07780641,-0.070068955,-0.025005234,-0.015260346,0.008251732,0.04247034,-0.058000166,-0.043494113,0.044363067,-0.026343161,-0.024907796,-0.001982367,-0.07244371,-0.027565725,0.071620315,-0.0038833923,0.053283125,0.034823626,0.011041199,-0.006886019,0.024891742,0.013011383,0.002608995,-0.026121123]})
