c({id:"Slots:13",text:"javascript\n// WRONG \u2014 recomputes only when block is reassigned, not when .currency changes:\nthis.slot(function(block) { return block?.flowParent?.value?.currency; });\n// RIGHT \u2014 recomputes on a change at any segment of the path:\nthis.slot(function(block$flowParent$value$currency) { return block$flowParent$value$currency || 'USD'; });",sourceId:"Slots",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.048858855,0.06038704,-0.010606944,0.02842088,-0.07109565,-0.041242514,0.014039324,-0.0511004,0.14950736,-0.06989115,-0.011616148,-0.013567625,-0.12439636,0.0056748837,-0.011901987,-0.023634925,-0.012421815,0.046644438,-0.008415403,-0.06384683,-0.016831454,-0.042388555,-0.030290587,0.013829403,0.06498183,0.06298662,6.029948E-5,-0.044343125,0.036542937,-0.039377503,-0.027484804,-0.020480666,-0.12742528,-0.0035869037,-0.086441666,0.026222266,0.0038316322,0.052077845,0.022939745,-0.012946679,0.042080026,0.036860254,0.021091647,-0.09559689,0.08151081,-0.029295327,-0.036381464,0.091156825,-0.084063694,0.029897962,0.04061481,-0.05422287,-0.03679192,0.07252192,0.033626802,-0.019083546,0.090117715,0.026416285,0.042750414,-0.017850779,0.031398986,-0.0111158285,0.051714707,0.03690147,0.034623418,-0.08118999,-0.008440341,0.026112432,-0.07062405,0.06592877,0.08250438,0.027556734,0.042971727,-0.0056318925,0.053947363,-0.035205025,0.0489916,0.08816882,0.032927178,-0.020114802,0.018187074,-0.017658183,-0.014267666,-0.027428083,0.108760245,-0.029838886,0.002223959,-0.010473211,0.06812291,-0.040371113,0.0027316003,-0.011462548,0.07682337,0.020091563,0.030355487,0.018974546,-0.008974724,-0.027961476,-0.061731994,0.007731973,0.034051925,0.04628154,-0.05391192,-0.017419439,-0.037192844,0.0050785956,-0.037665546,-0.0041600247,-0.008449716,-0.018620826,-0.04133926,0.030200498,0.014421407,0.016716376,-0.05801419,-0.042553406,-0.007408483,-0.08356023,0.06309707,0.17733909,0.023973795,0.0552877,-0.029307194,-0.026012613,-0.011258797,-0.049438696