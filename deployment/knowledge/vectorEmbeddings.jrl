,0.007396909,0.08717115,-0.018845014,0.004395049,0.03515008,0.07396924,0.06373089,-0.010016521,0.04770239,-0.030823123,-0.0038525483,-0.053302925,-0.11524063,2.3676216E-4,-0.013288053,-0.020919945,-0.029606083,0.038608056,0.01594106,-0.010633675,0.05471249,0.027279302,0.054533314,0.005397738,-0.062473975,0.021112034,-0.014690576,0.10616507,-0.07721758,0.03959639,0.03165105,-0.007331879,-0.0027096695,0.033086352,0.002330137,-0.057354294,-0.0048489384,0.03483212,0.011515703,0.090899505,0.0021787134,-0.030311722,0.0022246863,0.021554211,-0.06457839,0.017126765,-0.08127076,0.0022181482,0.0023049565,-0.10625959,0.031676494,-0.018469865,0.02367456,0.047242638,-0.01456684,-0.009079002,0.06285622,0.021474652]})
