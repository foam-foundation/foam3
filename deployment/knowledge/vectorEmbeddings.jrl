c({id:"REQUIRES_VS_IMPORTS:16",text:"Summary\nUnderstanding the difference between requires and imports is crucial for effective FOAM development:\n\n- requires: = \"I need these classes so I can create instances\"\n- imports: = \"I need these services/values injected into me\"\n- exports: = \"I'm making these services/values available to my children\"\n\nThis design enables loose coupling, testability, and the ability to work across networks - core principles of the FOAM architecture.",sourceId:"REQUIRES_VS_IMPORTS",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.025778566,-0.060744934,-0.0026293881,-0.023362065,0.08562456,-0.021975359,-0.019065164,-0.011916301,-0.047085118,-0.056613855,-0.008548248,-0.09616954,0.025088703,0.049295187,0.07552345,-0.018757327,0.100918576,-0.17710225,0.0032384924,0.048847336,0.024420163,0.024770897,-0.055785805,-0.018826557,-0.090642236,0.033735964,-0.010998449,-0.10269224,0.058677584,-0.010530717,-0.040577598,0.044229276,-8.7781646E-4,-0.019607749,0.03576096,0.089624606,0.047337748,-0.041374985,-0.06201158,0.025559017,0.020690657,-0.07097009,-0.029088022,0.01482663,-0.031103814,-0.026686331,-0.025077429,-0.04339598,0.003477873,0.01788493,-0.039727487,-0.007640276,-0.053310852,0.0022362284,-0.025196278,0.055007108,0.046720408,0.04113204,-0.07947257,0.028954422,-0.020093948,0.022308467,0.030129164,0.058706142,0.06772405,-0.08110159,-0.089561574,0.048549406,-0.014961439,-0.015314831,-0.097047515,-0.0016941733,-0.072297856,-0.013495631,-0.010931944,0.035940476,0.030324476,0.04877795,0.06077948,-0.054328483,-0.019695396,0.12034017,-0.024793416,-0.016790316,-0.012522897,0.05402061,0.097539365,-0.056158803,-0.010865896,0.033655617,0.06829625,-0.11067938,0.021795165,0.055167183,0.055175852,0.047038358,-0.04337634,0.050814856,-0.056598768,-0.021147972,-0.12183975,-0.031013727,0.08206474,-0.010540929,-0.06856033,-0.033165697,-0.07907886,-0.07672581,0.024405863,0.053321585,0.009771638,0.0056449734,0.040604927,-0.0057655233,0.04