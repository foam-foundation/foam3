c({id:"CurrencyAndUnits:6",text:"Unit labels on plain numbers\nA number property can carry units: 'days'. The read view and the text field translate it at display time with the flat key foam.units.<units>, falling back to the raw value (ValueView.js:55-59, src/foam/u2/TextField.js:77). Add a Locale row with source foam.units.days to translate it; see i18n-advanced.",sourceId:"CurrencyAndUnits",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[0.0011595236,0.061148845,-0.05982588,-0.0034651456,-0.073744655,0.08387546,0.027437596,-0.020955032,0.055309594,-0.083120264,0.0142563,-0.0481831,0.0073326677,0.020508803,0.0032683583,-0.04428383,-0.06685483,0.02922804,-0.017369373,0.025988137,0.041928545,0.03806641,0.04184598,0.07316828,0.042854324,0.111629575,-0.016767211,-6.79026E-4,0.041939184,0.031224146,-0.030559408,0.04847105,0.10754883,-0.0024246331,0.0065944633,-0.020869916,0.03355429,0.035313185,-0.026451796,0.10200174,0.0031175178,-0.090496555,0.06408256,0.016272455,0.002900124,0.02814533,-0.012326173,-0.0036490825,0.018738769,0.14570698,0.025896272,0.04216746,-0.012550806,0.011261332,-0.007263783,0.038093552,0.041129086,0.0014431312,0.029802164,0.05467221,-0.048988756,0.098730855,0.06733736,-0.010363705,0.018504115,0.0066654915,-0.02980236,0.034803726,-0.07423753,-0.00963185,0.07952093,-0.014788874,0.09748826,0.009751116,-0.06255288,0.058456555,-0.04724301,-0.043376885,0.0761433,0.0068892585,-0.02765685,0.015356984,0.10080545,0.053405073,0.0164472,0.04936741,0.099892706,0.05863933,0.007348072,-0.044158474,0.010594586,-0.029453075,0.022162322,0.08882802,-0.031347353,-0.005601271,0.031980652,0.023611372,-0.093278795,0.0052829757,-0.0151985,0.032561198,-0.016422508,0.017689208,-0.08829722,-0.059122287,0.051190495,-0.023553612,-0.023652604,-0.02743452,0.0954556,-0.012049397,-0.05773864,-0.0025710636,0.017089026,-0.106795035,0.04820691,-0.10663103,0.07444609,-0.058764797,0.0057478184,-0.0029953257,-0.064878024,0.05145138,-0.06862585,0.06729798,0.1184505,3.4739