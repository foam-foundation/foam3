c({id:"FSM:3",text:"MyStateMachine.validateMachine() throws if no state is isInitial, if a transition names an\nunknown state, or if guards / permissions / onTransition has a key that is not in that\nstate's transitions (StateMachineEnum.js:394-433). getInitialStates() and\ngetTerminalStates() are also static (:386-392).\n\n---",sourceId:"FSM",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.08335357,-6.906114E-4,0.0033457568,-0.015311101,0.018060397,-0.018032115,0.042888843,0.036020793,-0.005331967,-7.776764E-4,-0.024474775,-0.043801647,0.007986957,0.044298247,-0.079636425,0.025975749,0.039719317,-0.04634366,0.08312737,0.022993835,0.03314204,-0.04659885,-0.039642595,-0.022885919,0.030994983,0.07869214,-0.012414444,-0.008473327,0.057110514,-0.023437945,-0.003650495,-0.11453503,-0.10364106,0.009901325,0.07051254,0.061078276,0.009661619,0.013756814,-0.0074651875,0.042869333,0.05662949,0.013029733,0.015861057,0.029921332,0.05705689,0.025388151,-0.0259132,-0.06617777,-0.051137894,0.027450163,-0.0034112763,-2.7911874E-4,0.097136006,0.022160472,0.011524033,0.04627348,0.056348313,0.082969464,0.02958018,0.002655531,0.012250257,-0.033010177,-0.024421798,-0.019681,0.06577485,0.10135851,0.009824742,-0.07066795,-0.0066328337,-0.013500553,0.058112998,-0.014776878,0.06446243,0.099614,-0.052847084,-0.07611558,-0.014510433,-0.010267318,0.03384772,-0.0062480154,-0.047427934,-0.07148032,-0.07621515,0.0059354412,0.0016028162,0.055587985,-0.0704752,-0.01705112,0.0142770205,0.093707584,-0.014837148,-0.05557586,-6.419618E-4,-0.026256256,0.02612457,0.011947677,-0.03029346,0.006407673,0.012606716,0.04177361,-0.06207515,-0.020625362,-0.016563434,0.031706583,-2.696929E-4,0.02746822,-0.023764461,-0.068090744,-0.07264634,0.062126562,0.002621686,0.009201778,0.09645937,0.06792302,0.050209634,0.074322775,0.028564164,0.020687297,0.025937874,0.034301154,0.0377439,-0.044769738,0.07847195,-0.017509827,-0.06977799,-0.004092363,-0.017058877,1.4111101E-33,-0.007049422,-0.06601555,-0.02757