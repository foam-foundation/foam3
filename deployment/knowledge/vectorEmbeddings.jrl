c({id:"VsReact:9",text:"Use Cases\nFOAM excels at:\n- Enterprise applications with complex data models\n- Cross-platform code generation\n- Applications requiring built-in persistence\n- Systems needing comprehensive metadata\n\nReact excels at:\n- UI-focused applications\n- Rapid prototyping\n- Integration with existing JavaScript ecosystems\n- Applications with simple data requirements",sourceId:"VsReact",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.052325603,0.0017968359,-0.046672538,-0.039908502,0.03420531,-0.041580822,-0.09506041,0.08109194,-0.007608299,-0.043578457,-0.04351702,-0.047975656,0.019770691,-0.015127904,0.12010229,0.05632425,0.06575161,-0.036143154,0.047311727,-0.006465514,-0.036529064,0.001536755,-0.054228526,0.0013082072,0.030062431,0.059534207,0.04448989,-0.07414465,0.020871084,-0.018089738,0.016975116,0.043429747,-0.03514213,0.042046957,-0.04639108,0.05448272,-0.0154514285,-0.046671692,8.1637775E-4,-0.047932755,-0.05989385,-0.0045913504,-0.04822124,0.015903946,0.026118305,-0.084796146,-0.043344293,-0.026056074,-0.014718257,0.06998753,-0.08495903,-0.06865321,0.04089345,0.012518422,0.01751211,-0.0034924906,0.020314168,-0.021920428,0.023287004,0.008414945,0.027371386,-0.018163737,0.04104621,0.083998665,0.020330248,0.05038192,-0.092987746,0.036367152,-0.010134143,-0.11399575,-0.09083619,-9.922596E-4,-0.01717393,0.026214177,-0.06842913,-0.027539866,-0.062380034,-0.025143433,0.051779255,-0.0054661552,-0.023482949,0.06664843,-0.084025495,0.105528705,-0.07515235,0.034425125,0.08156526,0.042473085,-0.034945413,0.023080459,0.069052346,-0.056164,0.10149218,-0.0018033858,-0.05760917,-0.0065423097,0.03842268,-0.02238277,0.021464514,0.011542803,-0.029024063,0.0044065965,0.08018932,-0.024367599,-0.07535642,-0.0339715,0.0034462854,-0.03264007,-0.002500224,0.04082252,-0.05421948,-0.016539386,-0.04483636,-0.097698495,0.01609546,-0.08073645,-0.049110983,-0.076734565,0.11078365,0.023956193,0.074481465,0.051957317,-0.0069382284,-0.017967425,0.0921