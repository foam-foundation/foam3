6053494,0.066851914,-0.11621994,0.13527526,-0.016272532,-6.044687E-8,-0.09679089,0.01549023,-0.022104567,-0.04689573,0.04447836,0.03120001,0.034476686,-0.011377268,-0.05858308,-0.01922258,0.017731756,0.06955086,-0.006830426,0.07930276,0.07171591,0.02464686,-0.07342507,-0.030003836,-0.056737278,-0.0061170994,0.060432486,-0.011891266,0.006817152,-0.030995881,0.09779278,-0.029324254,-7.4682006E-4,0.07559936,0.039307363,0.015520107,-0.0778079,0.04401305,-0.008532772,0.057429686,0.04402743,0.043869615,-0.014395381,-0.06640977,-0.018491013,0.01998082,0.021080209,-0.020698383,-0.01832674,0.004466113,0.101930454,0.061153747,-0.08789309,0.0036961967,0.0064901635,0.058296174,-0.011323309,-0.0049541704,-0.06740711,0.033662427,0.04960503,-0.055211052,-0.048357025,-0.026712809,0.050991118,-0.023587089,0.036476977,-0.007120775,0.12634547,0.018416444]})
