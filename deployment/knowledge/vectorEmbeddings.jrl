2,0.029255807,0.0086535225,0.018332878,-0.025384378,0.06762472,-0.03375251,0.0556292,0.09077416,0.01973121,0.00983517,0.07064512,0.0932507,-0.015149128,-0.009988153,-0.055045914,0.06077168,0.010141671,-0.037010245,-0.043589216,-0.008714325,0.059048228,-0.03617283,0.02501262,0.09178169,0.048132043,0.04202611,-0.06703858,0.0830519,0.04110089,0.062649295,-0.04949239,0.029239215,0.06797516,-0.021111535,-0.030009706,0.07183836,0.107267864,-0.040575232,-0.09547733,-0.008012889,0.13149443,0.06565679,-0.026324498,-0.06621376,0.029859435,0.07523839,-0.037635263,0.026956435,-0.06881674,-0.0023431345,-0.0907741,-0.00891994,-0.0027233819,2.1391244E-4,0.047937088,0.011334781,0.014638555,0.052887782,0.09624047,0.023088504]})
