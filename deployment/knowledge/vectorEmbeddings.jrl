2,-5.9163753E-8,-0.027807128,-0.08289368,-0.029093487,0.08489043,0.102721885,-0.059376817,0.019340718,0.11627023,-0.0019944042,-3.3189237E-4,0.13154736,0.07247211,0.030269157,0.02697182,0.06998441,0.017829383,0.020989913,-0.049428836,-0.11267662,-0.0031593796,-0.034916855,0.004302403,-0.03884253,-0.013787861,0.011962567,-0.0042515886,0.09891335,0.061803237,0.06016328,0.013635201,-0.054975636,-0.012750826,0.0291478,0.048930768,0.06794243,0.049181696,-0.03880732,0.059672557,-6.806408E-5,0.05624153,0.03504748,-0.004478496,-0.0011486843,0.057810523,0.045095857,0.016840888,-0.10720963,-0.014977654,0.048694517,-0.015091031,-0.058043584,-0.035529725,-0.053366944,-0.026819842,-0.07629293,0.005665162,0.06544093,-0.053612582,0.044410452,0.033212416,0.080988586,-0.008109595,-0.0057091685,0.021106219]})
