c({name:"ConvertGroupsToGrants",createdByAgent:49393173,spid:"foam",script:"[\n\t{\n\t\t\n\t\t\"flowName\": \"script1\",\n\t\t\"cmd\": \"script\",\n\t\t\"value\": {\n\t\t\t\"class\": \"foam.core.reflow.Script\",\n\t\t\t\"code\": \"groupDAO = x.groupDAO;\\u000agrantDAO = x.grantDAO;\\u000a\\u000aasync function convertGroup(g) {\\u000a  let ps = (await g.permissions.dao.select()).array;\\u000a  log(g.id, g.parent, ps);\\u000a\\u000a  let ag = foam.core.grant.GrantAssignment.create({\\u000a    id: 'group-' + g.id,\\u000a    name: 'Group ' + g.id,\\u000a    grant: foam.core.grant.CompoundGrant.create({\\u000a      grants: ps.map(p => {\\u000a        if ( p.id.startsWith('@') ) return foam.core.grant.SharedGrant.create({grantId: p.id.substring(1)});\\u000a        return foam.core.grant.PermissionGrant.create({permission: p.id});\\u000a      })\\u000a    })\\u000a  });\\u000a  if ( g.parent ) ag.grant.grants.push(foam.core.grant.SharedGrant.create('group-' + g.parent));\\u000a  log(foam.json.stringify(ag));\\u000a  // grantDAO.put(ag);\\u000a}\\u000a\\u000agroups = (await groupDAO.select()).array;\\u000agroups.forEach(async g => {\\u000a  convertGroup(g);\\u000a});\"\n\t\t},\n\t\t\"border\": {\n\t\t\t\"oldTitleStyle_\": \"h300\"\n\t\t},\n\t\t\"padding_st\": \"16px\"\n\t}\n]",created:1767022151630,createdBy:49393173,lastModified:1767022151630,lastModifiedBy:49393173,lastRun:1767020887669})
