2,0.11469671,-0.0034740514,-0.020211695,-0.034659155,-0.02860652,0.020846024,-0.06651532,-0.011667601,-0.0015526062,0.025234366,-0.06447291,-0.064271025,0.030351607,0.018887624,0.08356024,-0.023081098,0.027372712,0.072989464,0.010831164,0.060188666,0.013134976,0.056446172,-0.04536075,-0.0440075,-0.048846442,0.023220241,0.04673762,-0.08175391,-0.018893093,0.08459703,-0.04536548,-0.083310276,-0.10559302,-0.05417972,0.05653228,-0.025079038,0.00781153,-0.02359189,0.035785716,0.052134596,0.018733226,0.005296098,-0.028178401,0.035571534,0.061883442,-0.032016344,-0.028461097,0.17023392,0.018576026]})
