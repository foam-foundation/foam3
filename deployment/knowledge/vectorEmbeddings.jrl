c({id:"VsReact:1",text:"Overview\nYou're asking about FOAM (Feature Oriented Active Modeller), a modeling framework and class-based object system that can generate code for multiple platforms 1 , versus React, a popular JavaScript UI library. While both can build web applications, they represent fundamentally different architectural approaches.",sourceId:"VsReact",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.07330833,-0.11160154,-0.07117775,0.018332105,0.099860966,-0.04374567,-0.039589845,0.079848975,-0.04661423,-0.056143872,-0.057421558,-0.008132483,0.0203892,0.019615132,0.08508373,0.029728455,0.03548887,-0.043485742,0.0068946327,-0.00396365,0.047931295,0.009278176,-0.048489407,0.03198622,-0.033686254,0.05656564,0.017249282,-0.06440594,0.029411156,-0.04235424,0.036030106,-0.018456206,-0.008130024,0.0178153,-0.106335506,0.0035741553,-0.049366407,-0.04321233,-0.10102594,-0.059149582,-0.089943066,0.005605516,2.1675469E-4,-0.014303989,0.098336145,-0.056065187,-0.094152346,-0.035993565,-0.012686906,-0.035563447,-0.051795736,-0.12778763,0.02004801,-0.06178842,-0.0019006768,0.022571769,0.029549804,-0.03668408,-0.012285661,0.0058597163,0.009606409,0.009120849,0.053286683,0.051994957,0.04144022,-0.0024788182,-0.0028249992,0.010180223,0.06879629,-0.14689253,-0.086544946,-0.034454312,0.06037903,-0.028197968,0.02300725,-0.084815316,0.010331585,0.100795396,0.08351487,0.031500824,-0.017606497,-0.005195262,-0.052443735,-0.014848712,-0.016983418,0.04642048,0.0055864244,0.017207708,-0.01222671,0.011433739,0.011857957,-0.04432407,0.09450144,0.00874667,-0.06846528,-0.03955088,0.04369797,0.020065952,0.009044183,0.04428169,-0.06480403,0.008957112,0.030651914,-0.02117678,0.03531404,-0.018664325,-0.008413792,0.013296626,0.06715698,0.04430979,-0.035411093,-0.0019912429,-0.013282469,-0.009351049,0.04605201,-0.04772965,0.016590692,-0.015143213,0.085647576,0.04832438,0.007008261,-0.004469808,0.02210656,-0.012493251,0.12209851,-0.0296114,-0.09246618,7.5713224E-34,0.01971020