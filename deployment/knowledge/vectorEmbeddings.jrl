10673785,-0.04060916,0.0014129557,-0.030464126,-5.717743E-8,-0.028294226,-0.022212507,0.01232893,0.016233575,0.16070782,-0.042447563,0.04619052,0.0926778,-0.025162486,-0.026431883,0.13674559,0.06034635,0.003226108,0.054909162,0.061314564,-0.08275052,-0.033602152,-0.08444283,-0.12077585,-0.0061431183,-0.009878039,0.012008453,-0.045407698,0.015292509,0.047897886,-0.0042153923,0.09086553,0.031947583,0.054547805,0.11008056,-0.02636764,0.041260846,0.0726359,0.108834535,-0.014907958,0.047066737,0.058350403,0.04324674,-0.06496878,0.030482689,0.039395053,0.037490327,0.037144076,-0.014188155,0.028147658,0.011784683,-0.034498017,-0.025005689,0.1049259,-0.029559238,-0.052677993,-0.025562417,-0.048208676,0.0025736152,-0.052893274,-0.04463404,0.02113715,-0.043597028,0.07117194,0.033004917,0.07687725,-0.10813615,0.003305306,0.059102483]})
