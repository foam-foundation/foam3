4,0.021137966,-0.04343116,0.020885931,-5.9532184E-8,-0.04938487,-0.020433,0.042906664,0.041285887,0.09959479,-0.015777187,-0.0742484,-0.017723076,0.09004688,0.0052282275,0.041745137,-0.005937293,0.018902298,0.0532676,0.06423757,-0.046605237,0.12060137,-0.033310607,-0.07784721,0.033886347,0.04263226,0.013769613,-0.043122455,0.11576319,0.04717849,-0.02842501,0.06211431,0.025609914,0.0011987785,-0.026188847,-0.06298098,-0.02947901,0.026683915,0.018741885,-0.015042416,0.032871895,0.123754725,-0.018720504,-0.013779395,0.066951655,0.023482377,0.07496697,0.03133297,0.0167588,0.09486323,0.014273117,-0.09645987,-0.09308808,-0.017581325,-0.04215495,-0.059879128,-0.02359846,-7.959318E-4,0.06494737,-0.058043573,-6.376167E-4,0.039486054,-0.088785715,0.009858594,0.09840304,0.023624254,0.023766985,0.02659355,0.036295433]})
