p({
  class:"foam.core.script.Script",
  id:"DAOCompaction",
  code:"""
/**
 * Configuration (via scriptParameter):
 * daos: 'userDAO,accountDAO'
 */

import foam.dao.compaction.*;
import foam.dao.DAO;
import foam.dao.ProxyDAO;

String[] daos = null;
sp = scriptParameter;
if ( sp != null ) {
  p = sp.getParameters();
  if ( p != null ) {
    if ( p.get("daos") != null ) {
      daos = String.valueOf(p.get("daos").toString()).split(",");
    }
  }
}
if ( daos == null || daos.length == 0 ) {
    print("No dao(s) specified");
    return;
}
for ( n : daos ) {
    d = x.get(n);
    if ( n == null ) {
        print("ERROR: DAO not found: "+n);
        break;
    }
    if ( ! ( d instanceof DAO ) ) {
        print("ERROR: Not DAO: "+n);
        break;
    }

    try {
        print("INFO: Compacting: "+n);
        cmd = new CompactionCmd();
        cmd.setServiceName(n);
        // Sent through the DAO stack, so it reaches every JDAO underneath:
        // one for an ordinary DAO, one per partition for a partitioned one.
        d.cmd(cmd);
        // The command does not block; an operator running this wants the
        // report, so wait for it here rather than making every caller wait.
        if ( ! cmd.awaitCompletion(4L * 60L * 60L * 1000L) ) {
            print("WARNING: still running after 4h; check EventRecords for the outcome");
        }
        print("");
        print("=== " + n + " (" + cmd.getCompactedCount() + " journal(s)) ===");
        print(cmd.getReport());
        print("");
        print("OK: Compaction complete: "+n);
    } catch (IllegalStateException e) {
        print(e.getMessage());
        print("WARNING: Compaction aborted: "+n+", System OK");
        break;
    } catch (Throwable t) {
        print(t.getMessage());
        print("ERROR: Compaction failed: "+n+", System state unknown. Intervention required.");
        break;
    }
}

print("DONE");
""",
  lastModified:1753810864645
})
