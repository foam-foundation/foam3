c({id:"VsReact:7",text:"Code Generation vs Runtime\nFOAM generates code at build time, creating optimized classes with features like:\n- Database support\n- Network serialization\n- Validation\n- Documentation\n\nReact is purely runtime, with no code generation (though TypeScript can add type checking).",sourceId:"VsReact",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.0675116,-0.036191996,-0.021310212,0.06554223,0.038553864,-0.0067916354,-0.06616423,0.033434846,-0.035600003,-0.023748806,-0.06088448,0.011329847,-0.05149187,-0.04940275,0.050422415,0.005378796,0.012835668,-0.11924555,0.04306165,-0.020800294,0.05328653,-0.055505935,-0.009495594,0.038758107,0.011929604,0.083928846,0.058433145,-0.072518624,0.081438,0.03182605,0.00388401,0.07769715,0.009902981,-0.011233165,-0.0787933,0.07240251,-0.042403396,0.013432658,3.9692427E-4,0.008950279,-0.08583193,0.01540058,0.011102004,0.034634754,0.057977665,-0.09376694,0.0054423553,-0.09778336,-0.124254204,-0.06422676,-0.03533833,0.017621482,-0.004508015,-0.11923781,0.05844553,-0.035229675,0.063750155,0.041024268,-0.005425832,-0.019581275,-0.0012372542,0.008601229,0.014207321,-0.06390006,0.060590032,0.020735173,-0.004837474,-0.011091023,0.06977526,-0.11158001,-0.0721966,0.033419807,0.06889678,0.038032934,-0.015851164,0.042610805,0.06789409,0.009603952,0.062356465,-0.0043619173,0.0017625847,-0.030735461,-0.017232602,0.051547874,-0.049945217,0.11650196,0.13052489,0.022816826,0.00924641,0.037202004,0.009550601,-0.061308946,0.06677911,0.01819142,-0.019418247,-0.03152192,-0.062259164,-0.03235401,0.08231309,-0.029304668,-0.051359683,0.037117817,0.068844825,-0.0050520212,-0.0013924545,0.0050286464,0.03650318,-0.027155923,-0.01362142,0.084216595,0.016772883,0.027013099,0.049580842,-0.034635376,-0.050748806,0.03516334,-0.041340467,-0.041892316,0.06111636,0.12544808,0.1048755,0.012261491,0.055298515,0.05308553,-0.0210064,-0.041636433,0.020278394,2.5725653E-33,0.015622346,-0.04626059,0.008780419,0.07221016,0.03799068,-0.0