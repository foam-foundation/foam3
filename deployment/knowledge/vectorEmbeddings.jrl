.024486143,-0.025805429,-0.08101832,2.2925275E-5,-0.084133565,-0.029797312,-0.071960516,-6.011728E-8,-0.044742305,0.002603363,-0.019104091,0.02321482,0.013387619,-0.0271068,0.07757231,0.07013276,-0.055073056,-2.477024E-4,0.09597086,0.11155592,0.059093438,-0.018658616,0.021005355,0.0011508238,0.035864066,-0.022068027,-0.07895804,0.0496834,0.0050245174,0.011529835,-0.008051763,0.044116233,0.11326723,-0.056319237,-0.0036522867,0.021272035,0.06657554,0.006763747,0.010158695,-0.0145882405,0.052728735,0.11134638,0.022977663,-0.07326128,0.029000912,-0.016713828,0.055409398,0.14199942,0.058172222,-0.07037198,-0.02949935,0.01132822,0.021819692,0.04970096,-0.058583613,-0.09530658,0.05590743,-0.0671576,-0.05115206,0.0047534388,-0.055016596,-0.0049888794,0.08655768,-0.05124173,0.018225038,0.045224328,0.023115981,0.056217905,0.020748384,-0.03128101,0.025470719,-0.018377643]})
