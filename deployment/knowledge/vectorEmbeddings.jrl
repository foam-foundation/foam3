c({id:"Intro:3",text:"Core Philosophy\nFOAM operates on a simple but powerful principle: define your models declaratively, and let the framework generate everything else. Instead of writing repetitive CRUD operations, validation logic, UI components, and serialization code for each feature, you describe what your data looks like and how it should behave\u2014FOAM handles the rest.",sourceId:"Intro",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[0.057226058,-0.03616334,-0.05955671,-0.045667022,0.031167218,0.004156603,-0.07255193,0.005657182,-0.050614312,-0.04857652,-7.533254E-4,-0.043860734,0.04827256,-0.015906887,-0.0029037038,0.032101594,0.07785438,-0.07941017,0.008577197,0.026840022,0.042458486,0.060478397,-0.061627343,0.064399675,-0.08740622,0.1096912,0.016576976,-0.10810419,0.01432505,-0.05227927,0.032968853,0.03726314,0.018449197,-0.00594358,0.052061055,-0.012810907,-0.015390713,-0.011125564,-0.02795166,-0.059791975,-4.5084392E-4,-0.09733863,-0.020774648,0.007483549,0.07081823,-0.009922437,-0.030943247,-0.004899668,0.010548348,0.003991735,-0.00983738,-0.07272971,-0.030508865,0.01517849,0.038986415,0.084212564,-0.017588455,0.007471524,-0.046241026,-0.030115724,0.04581595,-0.0063792504,-0.024496606,0.098990075,0.1031725,-0.017223522,-0.012215728,0.0073024235,-0.005500285,-0.04446473,0.0014065966,-0.011549216,-5.6052214E-4,-0.060643695,0.026659355,0.08781983,-0.03618179,-0.04360877,0.0092078075,-0.029733233,-0.05061179,0.099923894,0.0857584,-0.059220355,0.028746504,0.035229433,0.085740454,-0.032450516,-0.097818315,-0.003064687,0.0810166,-0.03793159,0.034720864,-0.0376953,-0.042404942,0.036502704,-0.02209036,-0.055854328,-0.003886758,0.035476312,-0.06879451,0.016748656,0.03614317,-0.00790934,0.0056930203,-0.058014516,0.01754537,-0.017909324,-0.041019,0.04993394,-0.011417999,0.041701596,-0.033199035,-0.02257034,0.12162148,-0.066660024,0.040649775,0.04406311,-0.029646138,-0.020037664,0.006263538,-0.056674838,0.05192311,-0.030108558,-0.03137467,-0.025776