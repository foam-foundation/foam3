67,0.056791224,-0.06816645,-0.027517566,-3.969508E-8,-0.04355342,-0.037038583,-0.014984481,0.008734258,0.076082155,0.011209997,0.024423374,0.06250162,-0.033363786,0.019382142,0.036542214,0.06759238,0.036235813,0.04776446,-0.01630089,-0.06763638,-0.029174937,0.04564397,-0.052090663,0.047395274,0.002859503,-0.009962964,-0.016050298,-0.0036873596,0.11309615,-0.06472717,0.03511312,-0.06482434,0.0439687,0.13234551,-0.066570014,0.047438726,0.05214158,0.044028565,0.03383198,-0.060474787,-0.008472281,-0.007855981,0.0035501334,0.037607517,0.035340752,-0.010802202,-0.049994573,-0.006289439,0.00979044,-0.07794686,0.077339135,-0.07357591,0.083588034,0.024231195,-0.08101213,-0.059051886,0.009496833,-0.079780065,-0.051900074,-0.047978092,-0.0019693011,0.0013582634,0.01552519,-0.032404177,0.006543585,-0.08832829,-0.019138131,0.015981518]})
