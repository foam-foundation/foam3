p({"class":"foam.core.ai.llm.provider.test.LLMToolsTest","id":"LLMToolsTest","description":"Claude and chat-completions providers: tool definitions, tool calls and their results, web search, thinking and cache tokens in the request body and the parsed reply"})
p({"class":"foam.core.ai.llm.provider.test.LLMSendTest","id":"LLMSendTest","description":"Claude and chat-completions providers over HTTP against a scripted local server: retries, the message the caller gets when they run out, and a listener stopping a call during a retry wait"})
p({"class":"foam.core.ai.llm.provider.test.OpenAICredentialURLTest","id":"OpenAICredentialURLTest","description":"Chat and embedding calls go to <url>/v1/chat/completions and <url>/v1/embeddings when the OpenAI credential has a url, follow a changed url on the next call, keep OpenAI's endpoint without one, and leave an instance baseURL, Ollama and DeepSeek on their own endpoints"})
