28118206,0.04583274,-0.065531455,-0.047030807,-0.0042110127,-0.016989756,-0.082167394,-0.0056894114,0.09626891,0.013288687,-0.04403473,0.10919476,0.07096029,0.07773597,0.0116150705,8.080241E-4,-0.026534026,0.1302087,0.08528738,-0.0030927213,-0.03138708,0.0052232617,0.028248366,0.019650219,0.07213615,0.07891991,-0.0059750536,-5.088594E-4,0.039926812,0.028792292,0.013801442,-0.07346375,-0.008681479,-0.075871244,-0.011489741,-0.023406826,6.297966E-4,-0.07477976,0.0156065365,-0.049732003,-0.02233219,0.099876404,0.002311687,0.08403289,0.055180684,0.032411773,1.7077666E-4,0.027611041,0.024449311]})
