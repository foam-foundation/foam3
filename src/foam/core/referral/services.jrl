
p({
  "class": "foam.core.boot.CSpec",
  "name": "referralCodeDAO",
  "serve": true,
  "authenticate": true,
  "serviceScript":
  """
  return new foam.dao.EasyDAO.Builder(x)
    .setFuid(true)
    .setJournalName("referralCodes")
    .setJournalType(foam.dao.JournalType.SINGLE_JOURNAL)
    .setOf(foam.core.referral.ReferralCode.getOwnClassInfo())
    .build()
    .addPropertyIndex(new foam.lang.PropertyInfo[] { foam.core.referral.ReferralCode.CUSTOM_REFERRAL_CODE });
  """,
  "client": """
  {
    "of": "foam.core.referral.ReferralCode"
  }
  """
})

p({
  class:"foam.core.boot.CSpec",
  name:"generateUserReferralCode",
  serve:true,
  authenticate:true,
  service:{
    class:"foam.core.referral.ServerUserReferralCodeService"
  },
  boxClass:"foam.core.referral.UserReferralCodeServiceSkeleton",
  client:
    """
      {
        "class": "foam.core.referral.ClientUserReferralCodeService",
        "delegate": {
          "class": "foam.box.SessionClientBox",
          "delegate": {
            "class": "foam.box.HTTPBox",
            "url": "service/generateUserReferralCode"
          }
        }
      }
    """
})
