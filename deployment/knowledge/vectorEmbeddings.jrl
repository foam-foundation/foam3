c({id:"SPID:4",text:"Core Classes\nServiceProviderAware Interface\n\nLocation: foam3/src/foam/core/auth/ServiceProviderAware.js\n\njavascript\nfoam.INTERFACE({\n  package: 'foam.core.auth',\n  name: 'ServiceProviderAware',\n\n  constants: [\n    {\n      name: 'GLOBALSPID',\n      value: '',\n      type: 'String'\n    }\n  ],\n\n  properties: [\n    {\n      class: 'Reference',\n      of: 'foam.core.auth.ServiceProvider',\n      name: 'spid',\n      externalTransient: true\n    }\n  ]\n});\n\n\nServiceProvider Class\n\nLocation: foam3/src/foam/core/auth/ServiceProvider.js\n\nServiceProvider extends Capability and represents a tenant:\n\njavascript\nfoam.CLASS({\n  package: 'foam.core.auth',\n  name: 'ServiceProvider',\n  extends: 'foam.core.crunch.Capability',\n\n  properties: [\n    {\n      class: 'String',\n      name: 'id',\n      // Must be lowercase alphanumeric with dots/hyphens\n      // e.g., \"acme\", \"acme.corp\", \"my-tenant\"\n    },\n    {\n      name: 'inherentPermissions',\n      // Automatically grants these permissions:\n      // - serviceprovider.read.<spid>\n      // - serviceproviderdao.read.<spid>\n    },\n    {\n      class: 'Long',\n      name: 'anonymousUser'\n      // Reference to anonymous user for this SPID\n    }\n  ],\n\n  methods: [\n    // setupSpid(x, user) - Grants SPID capabilities to user\n    // removeSpid(x, user) - Removes SPID capabilities from user\n  ]\n});\n\n\nServiceProviderAwareDAO\n\nLocation: foam3/src/foam/core/auth/ServiceProviderAwareDAO.js\n\nA DAO decorator that enforces SPID-based access control:\n\n| Operation | Behavior |\n|-----------|----------|\n| put() (create) | Sets SPID from context if not set; checks serviceprovider.read.<spid> |\n| put() (update) | Checks permissions; changing SPID requires serviceprovider.update. |\n| find() | Filters by SPIDs user has serviceprovider.read.<spid> permission for |\n| select() | Adds SPID predicate to all queries automatically |\n| remove() | Checks serviceprovider.remove.<spid> or global permission |",sourceId:"SPID",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.077512845,-0.0011306556,-0.07637594,-0.01796708,-0.0023155243,-0.049779043,0.08173847,-0.010934684,-0.048390176,-0.045236345,0.0629816,-0.003126511,0.04403055,0.018210774,0.08082969,0.08439042,0.035996664,-0.019070046,-0.029798519,-0.022461116,0.07188563,0.02735817,0.017034609,-0.011432123,-0.05829178,-0.041688412,0.0046329917,-0.12368347,-0.051804982,0.026008354,0.09129693,-0.026494183,-0.029265415,-0.07294372,0.0145374285,0.037424203,0.025460415,-0.0106066605,0.019394394,0.0038185017,-0.0016022101,0.057872225,-0.048032235,-0.07030348,0.010767725,-0.04053857,-0.07939338,0.0062558507,-0.0165007,0.02001992,0.04222458,-0.04174821,0.020299703,0.0068940334,-0.019890433,0.036437344,-0.04936181,0.06087444,0.0175374,-0.020090204,0.04056488,-0.045750976,0.02638712,0.028538449,0.012497773,-0.028937474,0.021659384,-0.041844778,-0.028525826,-0.029427677,-0.022017872,0.055017155,-0.02543302,-0.04364415,0.0474124,0.044983592,0.016110526,0.03865006,0.02649297,-0.12100987,-0.017081292,0.054708574,0.015778866,0.043663267,-0.049053025,0.02783659,0.06511654,-0.0648739,0.0061896928,0.037912022,0.016965682,0.023438452,-8.315266E-4,-0.058477785,0.017133392,0.06398912,-0.06781651,-0.0012328811,-0.085153304,0.083909936,-0.11411392,-0.056374658,-0.0010689944,0.062119093,0.07417299,-0.024321543,-0.0176588,-0.017168622,-0.04479824,0.092637315,0.0010673843,0.047772948,0.008230187,0.04452472,0.0025126333,2.2877805E-4,0.03658008,0.00403564,0.0021056843,0.024234474,0.12714559,-0.02793818,0.055443805,-0.004585578,0.047568906,-0.0114734005,0.024536608,3.6093808E-33,0.07317644,-0.06779415,0.003376511,0.04935239,0.07441867,-0.020024559,0.00426394,0.005900105,-0.03268669,0.06299683,-0.07789134,0.09798392,0.0153857395,-0.021461455,0.059743397,-0.016572341,0.020642614,0.038875453,0.09166188,0.008842267,0.009259956,0.050460193,-0.031634375,0.030865127,0.0319998,0.004187383,-0.025858648,-0.0