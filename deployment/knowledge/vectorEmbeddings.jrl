c({id:"Wizard:11",text:"Overview\nPossibly the most complex logic in the wizard is when and how wizardlets are\nsaved. The wizardlet interface defines a save method which wizardlet\nsubclasses are expected to implement, the most common case being\nCapabilityWizardlet which saves the data using CrunchService.",sourceId:"Wizard",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.0154264495,0.0037519727,-0.09290761,-0.0011941376,-0.023501297,0.0073890095,0.028313125,-0.025623769,0.0048942706,-0.012568002,-0.004091846,0.055245437,-0.038052097,-0.057566892,-0.03791552,-0.0954682,-0.0021242339,-0.024682248,-0.14454019,-0.08204702,0.090371884,-0.0395314,0.04913897,-0.0019021451,-0.010100874,-0.015501054,0.0781949,0.02207956,0.108015455,0.011763763,0.045919526,0.049345974,-0.09409251,-0.014079668,-0.04801414,0.053540114,0.0012578008,0.07697251,0.09067574,-0.08492209,-0.032906022,-0.109580554,-0.098672405,0.0028330057,-0.0049714604,0.012933257,-0.08065693,-0.054186217,-0.07779177,-0.019423584,0.0052054403,0.004463818,-0.06976838,-0.0015278276,0.06030025,0.013816545,-0.024382018,0.023972355,-0.06559993,0.022522647,-0.039148975,0.038672894,-0.03550233,0.06441047,-0.007978733,0.05250728,0.024586482,0.016896807,0.06740235,-0.12670007,-0.0896266,-0.0048734187,-0.004133653,0.010426227,0.011583033,0.023626136,0.030671649,-0.06559809,0.0044284035,-0.012141171,-0.0031979159,0.08480439,0.024822814,0.04286465,0.06600644,-0.021041438,0.025770511,0.061219063,0.084062025,0.017762769,-0.02252514,0.037159573,0.06503727,0.024804935,-0.045892995,0.058646627,-0.025446115,-0.034383006,0.014657656,0.031337697,0.027856216,0.028857442,0.112140104,0.021230515,0.053740345,-0.10135484,0.06638753,-0.07866986,0.010867361,-0.013350153,0.020787764,0.0033609371,2.628151E-4,-0.05177262,0.06857992,-0.049368743,-0.05400485,0.09147625,-0.049633652,-0.023627812,-0.008605906,0.07798993,0.06890899,-0.057730943,0.040174823,0.037907243,-0.038221955,1.3393104E-33,-0.026983147,0.012061109,-0.05864209,0.