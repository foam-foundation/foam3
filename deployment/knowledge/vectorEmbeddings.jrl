3E-4,-0.033796307,-0.05695429,0.011603367,0.084179565,-0.005998808,-0.03628295,-0.038486056,-4.3697806E-8,-0.019485708,0.004654283,0.023564052,0.08658265,0.030469717,-0.077704795,0.0075607384,0.02400871,0.032926105,-0.037583336,0.08790047,0.09872142,0.011012897,0.03819901,-0.0018677987,-0.05627348,-0.028228277,0.023334742,-0.06664996,0.027745964,0.034889203,0.009971592,0.015683485,0.030472135,0.10421454,-0.047687065,0.103079095,0.0028796457,0.09268547,0.095653266,-0.096176,0.031425852,0.091829695,0.09094592,0.03300106,-0.074116044,-0.010595743,0.035062924,-0.0023969659,0.035107724,0.008872659,-0.00758743,-0.021578133,0.023501407,0.06865015,-0.05665572,-0.05888128,0.033717625,0.06830845,0.05182326,-0.054051943,-0.023450138,-0.037526593,-0.03618197,-0.046944633,-0.1290086,-0.010670055,0.041277133,0.04627571,0.020495,0.043856252,-0.07934105,0.004690238,-0.031700715]})
// Modified by admin admin (42) at 2026-10-02T11:19:50.092+0000
c({id:"DaoExamples:6",text:"js\n// counts the guitars \n// short-circuits it and returns only the count number\nguitarDAO\n.select(expr.COUNT())\n.then(function(count) {\n  console.log('count: ', count.value);\n});\n\njs\n// give me all gibsons\nguitarDAO\n.where(expr.EQ(Guitar.BRAND, 'gibson'))\n.select()\n.then(function(guitars) {\n  console.log('gibsons count: ', guitars.array.length);\n  console.log(guitars.array[0].name);\n});\n\njs\n// give me all gibsons or seizis using OR\nguitarDAO.where(expr.OR(expr.EQ(Guitar.BRAND, 'seizi'), expr.EQ(Guitar.BRAND, 'gibson')))\n.select()\n.then(function(guitars) {\n  console.log('seizi or gibsons count: ', guitars.array.length);\n});\n\njs\n// give me all gibsons or fenders using IN\nguitarDAO.where(expr.IN(Guitar.BRAND, ['gibson', 'fender']))\n.select()\n.then(function(guitars) {\n  console.log(guitars.array.length);\n});\n\njs\n// give me all fenders with a price below 2500\nguitarDAO\n.where(expr.AND(expr.LT(Guitar.PRICE, 2500), expr.EQ(Guitar.BRAND, 'fender')))\n.select()\n.then(function(guitars) {\n  console.log(guitars.array.length);\n});\n\njs\n// give me all guitars where brand starts with g or name starts with s\nguitarDAO.where(expr.OR(expr.STARTSWITH(Guitar.BRAND, 'g'), expr.STARTSWITH(Guitar.NAME, 's')))\n.select()\n.then(function(guitars) {\n  console.log(guitars.array.length);\n});\n\njs\n// using contains\nguitarDAO.where(expr.CONTAINS(Guitar.NAME, 'sh'))\n.select()\n.then(function(guitars) {\n  console.log(guitars.array.length); // 1 , slash\n});\n\njs\n// using containsic (ignoring case)\nguitarDAO.where(expr.CONTAINSIC(Guitar.NAME, 'SH'))\n.select()\n.then(function(guitars) {\n  console.log(guitars.array.length); // 1 , slash\n});\n\njs\n// give me all fenders and order by price\n\n// this is a custom sink function\n// this function will be applied on each guitar instance.\nvar sinkFn = function (guitar) { console.log(guitar.price) }\n\nguitarDAO.where(expr.EQ(Guitar.BRAND, 'fender'))\n.orderBy(expr.DESC(Guitar.PRICE))\n.select({ put: sinkFn })\n.then();",sourceId:"DaoExamples",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[0.008462436,0.055238117,0.04086116,0.0075319214,-0.013910457,0.020674262,0.060185604,0.062947564,0.080257885,-0.041548185,0.003629072,-0.023165204,0.009239455,-0.03693643,0.047894966,-0.03082708,-0.011643642,0.0445237,-0.060702194,-0.044583578,0.090656556,0.006974459,-0.019864874,-0.014598943,-0.03771708,0.047824,0.023509532,-0.011078415,-0.058664884,-0.019743208,-0.08546703,-0.0081228735,-0.047651123,0.004764981,-0.024124226,-0.07239697,-0.11997171,-0.04565993,0.027907096,-0.020628352,-0.03835797,0.036527786,0.010733284,-0.037636776,0.06253162,-0.051397674,-0.09236467,0.05717307,0.053226244,0.03951857,-0.027077788,0.0115788765,-0.009654613,-0.030501068,0.07735184,-0.040229913,-0.10973577,-0.09476751,-0.011218806,0.032946743,-0.029183796,-0.09037488,-0.05358293,0.027836299,0.03680904,-0.08265575,0.06162919,0.011460117,-0.06632524,0.056855902,0.017867113,0.09081848,0.03344717,0.055492524,-0.016906982,0.079449385,0.025604706,-0.051123578,0.031287186,7.684661E-4,-0.062240243,-0.03166693,-0.09949695,-0.0046940157,-0.0042121774,0.010382344,0.027675668,-0.008460656,0.042787682,-0.09003381,-0.056059506,-0.026128778,-0.026005566,0.05415364,0.030100169,0.08217702,0.048707616,0.042668004,0.03268113,0.034134924,-0.023548674,-0.009451628,0.08262217,-0.03143176,-0.13140683,-0.040315505,0.006205822,0.031652436,-0.041253507,-0.049809344,-0.014743608,0.06915375,-0.014336634,0.08423752,-0.03530099,-0.0042119483,0.13492087,-0.056968406,0.037027955,0.038177617,0.037576254,0.090489455,0.077506065,0.031287007,0.033162687,0.046986394,0.011853153,-1.9362761E-34,-0.009829866,-0.047834296,0.03246107,-0.035467476,-0.008060477,0.0044695796,-0.059868775,0.086359665,-0.08129278,0.10321117,-0.039043687,0.04532644,0.041866068,-0.029895823,0.08608269,0.0019728553,0.060560804,-0.07766347,-0.03225545,0.009744017,-8.72155E-4,-0.06952313,0.0019693624,0.10357244,0.00440