c({
  class: "foam.core.script.Script",
  id: "NodeShellTest",
  language: 3,
  code: """
console.info('select 1');
x.countryDAO.select(function(c) {
    console.info('Country (1)', c.toSummary());
});

console.info('select 2');
s = await x.countryDAO.select();
s.array.forEach(c => {
   console.info('Country (2)', c.toSummary());
});
  """
})
