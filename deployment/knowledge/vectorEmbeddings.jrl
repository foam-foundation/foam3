c({id:"cheat-sheet:14",text:"Dynamic Views\njavascript\n// Auto-binds to data properties\nthis.add(function(firstName, lastName) {\n  return this.start('div').add(Name: ${firstName} ${lastName}).end();\n});\n\n// For object properties, use this.dynamic() directly\nthis.start('div')\n  .add(this.dynamic(function(myProp, otherProp) {\n    return Values: ${myProp} ${otherProp};\n  }))\n.end();\n\n\nNote: this.add(function(){}) auto-binds to data properties. For the object itself, use this.dynamic() directly.",sourceId:"cheat-sheet",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.063963264,0.026071507,0.014895481,0.046337817,-0.03002682,-0.006426103,0.08900381,0.016106058,0.06869962,-0.062394626,-0.020165114,0.014692419,-0.081128076,0.08143392,0.0118185785,0.08160282,0.0583043,-0.030759262,-0.06300835,0.023561582,-0.025436193,-0.023456933,-0.058176637,-0.00818503,0.02556504,0.09792412,0.06988919,-0.0077485587,0.062355917,-0.040814135,0.046768468,-0.13925903,-0.037905533,0.036583267,-0.118932106,-0.06821692,-0.051997054,0.05849228,0.010153236,0.012351024,0.024517046,0.06164677,-0.020152908,-0.03473375,0.012057462,-0.0113240555,-0.003647066,-0.008596729,-0.02241073,-0.010993734,-0.081509046,-0.015013141,0.02654864,0.014642019,-0.022992,0.02132637,0.0012541584,0.018654527,0.040029548,0.071329854,0.06644505,-0.01926187,0.06972843,0.08852426,0.054409347,-0.045802355,-0.001678622,0.043614697,-0.055823732,0.09831783,0.011004692,0.0069359634,0.095583126,-0.06212929,0.042296287,-0.00747863,-0.08604904,-0.037412293,0.016751269,-0.030767156,0.014769486,-0.0029683686,-0.053930078,0.011832583,-0.010340183,0.10197537,-0.09553705,0.011053966,-0.061073598,-0.05381974,-0.08281592,-0.06380422,-0.041360866,0.047535185,-0.0078116716,0.017877564,0.0027004783,-0.08542997,-0.03409765,-0.04551936,-0.04994146,0.02230965,-0.014299683,0.09402921,0.04052469,-0.06166883,-0.020966895,-0.05403169,-0.030477019,0.09736321,0.049061652,0.08731231,-0.027912017,-0.018870397,-0.026331306,-0.