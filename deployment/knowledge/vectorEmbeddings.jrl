c({id:"U3:18",text:"Safe HTML \u2014 HTMLView\nWhen you need to render raw HTML (e.g., rich text from a CMS), use HTMLView:\n\njavascript\nthis.tag('foam.u2.HTMLView', { data: this.data.richTextContent$ });\n\n\nHTMLView reactively updates innerHTML. Never add raw HTML strings via add() \u2014 strings are always text-escaped, which blocks XSS by construction.\n\n---",sourceId:"U3",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[0.0027363733,0.014181923,-0.027680673,0.023372306,0.11071767,-0.0048155724,-0.024702018,-0.06971768,0.046132863,-0.024928149,0.011979955,-0.0016429148,-0.021463633,-0.014371117,0.061296567,0.043501858,0.06482396,-0.08640574,-0.061880216,0.04532214,-0.017625742,-0.01555972,0.022459684,0.009094019,0.060504004,0.0676891,0.06563561,-0.06934304,0.061981674,0.008699866,0.06735795,-0.12700517,0.0071914257,-0.028365184,-0.09027783,0.039716028,-0.014476519,-0.048867945,0.046240952,0.00794813,-0.012510356,0.019032111,-0.06521429,-0.022039961,0.022933422,-0.049726844,-0.023091706,-0.074927054,-8.3377317E-4,0.02201094,-0.048068892,-0.038680144,0.042838816,0.063442305,-0.019522142,0.013370674,-0.00628605,-0.070556685,-0.013063929,0.019651633,0.03121895,0.011241571,0.09100093,0.055207714,0.030066341,-0.020578733,-0.034705378,0.028212009,-0.028242273,0.0061840513,0.012636819,-0.032150205,0.07325196,-0.056670096,0.030821932,0.020903856,0.05518219,-0.07245288,0.023932694,0.040773027,0.056233335,0.02019275,0.014588641,-0.024831787,0.07473773,0.11990388,0.0015005764,2.350613E-4,-0.06328468,-0.034210358,0.050592087,0.024515308,0.045609605,0.0849447,-0.07400774,0.025626557,-0.0015215166,-0.01229719,-0.06794342,0.012788998,-0.012342349,-0.0145066865,-0.06961251,-0.013723804,-0.055016153,-0.09358587,0.03242508,0.04938644,0.004350409,0.008077956,0.07292163,0.01904521,-0.1208629,-0.01649907,-0.07037301,-0.108406186,0.036196414,-0.064790584,0.030666726,0.070167154,0.019103443,-0.00711362,-0.009910251,0.0076316358,0.041951913,-0.08102525,0.023864176,5.2473