66,0.016324451,0.08647345,-0.06647542,0.018247426,-0.09031439,-0.04801901,0.03281653,0.028168207,-0.03096044,0.03630835,0.072760195,-0.045163725,0.016434435,0.012898053,0.010633883,0.0789842,0.012398219,-0.0029386368,0.006210746,0.036321416,0.0557606,-0.06822774,9.826549E-4,-0.063605554,0.07453729,-0.019609807,0.06577356,0.08783329,-0.044127837,0.0036819768,0.11900806,-0.04804305,-0.03565207,-0.023756245,-0.037780542,0.033942398,-0.068748,0.009472341,-0.12636642,0.0027428525,0.008805215,0.0038098805,0.007960158,7.157532E-4,0.061113708,-0.0010456742,-0.01440242,0.02631846,0.10599178,-0.03761649]})
