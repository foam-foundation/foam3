84383,-0.012851418,0.012994651,0.051978208,0.0794787,0.0058482913,0.028105782,-4.8608168E-8,-0.01965875,-0.07156882,-0.08443235,0.06705018,0.034053892,0.01514945,-0.022264345,0.036786366,0.022331141,-0.046136804,0.100757845,0.013388199,0.030846536,-0.013314732,-0.0021864788,0.040536918,0.023966614,-0.09981022,-0.02192526,0.021629104,4.2444075E-4,0.0061387233,-0.08618254,0.0693052,0.085132755,-0.035694912,-0.056018572,-0.059403878,0.015253493,0.0029722573,-0.020337338,0.049140904,0.020095969,-0.06073465,-0.02677181,0.01789027,0.022247236,0.016875548,-0.011892922,0.03801127,0.120327964,-0.004287225,-0.088275716,0.010877989,-0.0028835442,-0.1019637,-0.021448828,-0.009470851,0.07892071,-0.0829313,0.011795688,-0.0059657507,-0.04212685,-0.011619921,0.008421216,-0.03993452,-0.036950905,-0.03522297,0.036480904,0.105260395,0.07416254,0.02835677,0.040509224,-0.0073789265]})
