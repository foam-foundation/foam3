c({id:"Slots:6",text:"javascript\nthis.tag({ class: 'foam.u2.TextField', data$: this.firstName$ });  // binds firstName\nthis.tag({ class: 'foam.u2.TextField', data$: this.lastName$  });  // same view, different target\n\nFor a worked example (a Recipe detail view built from these pieces), see the\ntutorial. The rest of this guide is the part\nthe tutorial doesn't cover.",sourceId:"Slots",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.0035318204,0.050775096,0.01421756,0.029801136,0.078321196,0.0318136,0.054445755,-0.05590882,0.07851789,-0.09519356,0.012713248,-0.006781858,-0.117232956,0.015216796,0.0075849122,0.049445983,0.012766447,-0.057750203,-0.011613628,0.03405829,0.044340488,0.0056636976,-0.01904574,0.010191391,0.016953943,0.1415644,0.034811955,-0.009830851,-0.015110147,-0.060266454,-0.0021938065,-0.049389362,-0.018017547,0.0021877368,-0.101414934,-0.06049829,-0.05174055,0.051140435,0.045994584,0.024570223,0.020909343,0.032887723,-0.05507225,0.005545365,0.03388791,-0.025547918,-0.023087092,-0.0053497287,0.036193404,0.06166444,-0.08292629,-0.11048181,0.06133214,-0.010133568,0.012829142,0.049264733,-0.08770754,-0.024733098,0.0060319523,0.06333446,0.028778605,6.682927E-4,0.046921436,0.08128399,0.079728164,-0.067225605,0.0023953917,0.022633573,-0.10527417,0.036636095,0.04194255,-0.024386525,0.16122426,-0.03601417,0.031354103,0.012927985,-0.05706042,0.038461246,0.051310617,0.040424522,-0.026394112,0.020370882,0.018680979,-0.073430136,0.011607959,0.09585418,-0.016125385,-0.014355416,-0.06584587,-0.11669155,-0.008043909,-0.09453449,0.018433182,0.07015481,-0.05977295,0.024126297,-0.054888867,-0.013914444,-0.09194596,0.016007034,-0.068732046,-0.014795074,-0.025841575,0.014196609,0.023073109,-0.04830989,-0.012431801,-0.0455801,0.0118951695,0.062146217,0.018846503,0.044081263,-0.09009732,0.015517835,0.02205976,-0.10032951,0.05642264,-0.05294876,-0.007862896,0.010003815,-0.008661474,-0.050518878,-0.044962548,-0.04688053,-0.027126683,0.027449962,-0.0345858