-0.0023240752,0.03178785,0.029019643,-0.08089405,0.010367183,-0.026299091,0.0018877902,-0.09673427,-6.7623056E-8,-0.012772363,-0.010503769,0.021209182,0.0627766,0.12022838,-0.07796002,0.06792622,0.054462798,0.059946183,-0.04139561,0.054952778,0.13630553,0.0051345364,-0.019983113,0.016219378,0.028182624,0.042921882,-0.042626277,-0.07360128,-0.03108821,0.029391972,-0.059627607,0.003031982,0.037218604,0.09203366,-0.0029596875,0.06192273,0.0758824,0.05075904,0.0043978505,-0.09170147,0.010539669,0.101720266,0.074593924,-0.08784975,0.05254752,0.11464633,0.036918208,-0.054943763,0.032887816,0.01570706,-0.0600105,-0.046429083,-0.018523179,0.017767297,-0.018294057,-0.06491866,0.0025142482,0.018896636,0.017250184,-0.094811186,-0.016172834,-0.022211347,0.019605128,-0.021469055,-0.036997523,0.07122977,0.0045749727,0.11602991,0.031304203,0.09969455,0.0018407503,0.112888455,-1.5249349E-4]})
