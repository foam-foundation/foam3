p({
  class: "foam.core.cron.Cron",
  schedule:{
    class:"foam.core.cron.IntervalSchedule",
    duration:{
      class:"foam.core.cron.TimeHMS",
      minute:5
    },
    start:1669885200000
  },
  id: "expireSessionsCron",
  description: "Expire sessions based on ttl",
  code:
  """
    // Refresh OAuth tokens
    new foam.core.oauth.OAuthTokenRefreshCron().execute(x);

    // Remove expired sessions
    new foam.core.session.cron.ExpireSessionsCron().execute(x);
  """
})
