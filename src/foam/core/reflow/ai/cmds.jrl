p({
  "class":"foam.core.reflow.ai.LLMCommand",
  "id": "ai",
  "permissionRequired": true,
  "description": "AI prompt to ask a question"
})
p({
  "class":"foam.core.reflow.ai.AgentCommand",
  "id": "agent",
  "dryRun": false,
  "permissionRequired": true,
  "description": "Agent runs FLOW commands from a request"
})
p({
   "class":"foam.core.reflow.ai.AgentCommand",
   "id": "!",
   "permissionRequired": true,
   "dryRun": false,
   "description": "Agent shorthand to run FLOW commands"
})
p({
   "class":"foam.core.reflow.ai.AgentCommand",
   "id": "?",
   "permissionRequired": true,
   "dryRun": true,
   "description": "Agent shorthand to preview FLOW commands"
})
p({
  "class":"foam.core.reflow.ai.AgentCommand",
  "id": "plan",
  "dryRun": true,
  "permissionRequired": true,
  "description": "Plan FLOW commands with an agent"
})
p({
  "class":"foam.core.reflow.ai.AskCommand",
  "id": "ask",
  "permissionRequired": true,
  "description": "Ask a question and return the response to the agent",
  "hidden": true
})
p({
  "class":"foam.core.reflow.cmd.Command",
  "id": "propose",
  "permissionRequired": true,
  "description": "Propose a command for execution",
  "script": "addValue(foam.core.reflow.ai.Propose.create({command: args.join(' ')}, this));"
})
