c({id:"Dao:10",text:"removeAll()\nWorks like select() but removes matching objects instead of returning them. Use filtering first \u2014 a bare dao.removeAll() deletes everything:\n\njavascript\n// Delete all completed todos\nawait dao.where(EQ(Todo.IS_COMPLETED, true)).removeAll();\n\n\n---",sourceId:"Dao",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-0.03482185,0.07596597,0.09476314,0.039183043,0.07211331,-0.06574287,0.07435919,-0.10131129,0.031938087,-0.018142287,-0.0103392415,0.035160802,-0.09055389,-0.033368606,-0.0066000116,0.011335401,0.012895512,-0.013409208,-0.029681807,-0.061642986,0.062373437,-0.009601929,-0.06773694,0.03936462,0.07455376,0.02516504,0.061066985,-0.11243206,-0.041625567,-0.01918583,-0.008120592,-0.011723809,0.012071273,-0.031107698,-9.6361036E-4,0.0059999893,-0.018070754,-0.07754257,0.03574594,-0.060763076,0.004483314,0.07086511,-0.028844526,-0.091263376,0.10197887,0.029370876,-0.14527379,-0.008510626,0.01665922,-0.04625587,0.018164445,0.037668698,-0.053773504,0.0013047538,0.025697168,-7.6970604E-4,-0.02395864,-0.046348825,-0.06956513,-0.034978732,0.04469242,-0.028214235,-0.0045833685,0.034949422,0.08226315,-0.020099677,0.046344403,-0.06759822,0.046328213,0.05054883,0.013062199,0.0498117,0.04661605,0.03389808,0.030868068,0.007092348,0.029880974,0.017986676,-0.0028754186,0.09802424,-0.0613755,-0.069872886,-0.03054531,0.022538766,-0.0582647,-0.010814702,-0.08583663,-0.11077638,0.10794249,-0.04240792,-0.03433908,-0.0019368839,0.0027278115,0.040451143,0.029993907,-0.035241377,0.040644687,0.060724832,-0.014155191,0.058095485,0.012676472,0.037612308,-0.027330069,0.006311479,-0.060245022,0.0037786427,0.0012638626,-0.04138632,-0.070262864,-0.009377926,-0.0835614,0.049139556,0.038814202,0.028665941,-0.04728262,0.021877564,0.14815779,0.052428365,-0.04494504,0.045777075,0.034443054,0.05267891,-0.026228461,0.05760077,-0.014133867,0.004202215,-0.024348425,1.2528353E-33,0.01606632,-0.041894063,0.01179536,-0.11914524,0.04238768,0.02655090