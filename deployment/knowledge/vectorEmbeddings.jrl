6813,0.05230351,-0.08841356,0.022364534,-0.02724597,-0.06678849,-0.0136917215,0.069739364,0.028358892,-0.07319518,-0.025095692,0.038619842,-0.048552394,0.08052327,-0.012163965,0.0744701,-0.06401698,-0.03457316,0.030805428,-0.02045627,0.06772707,0.047441978,0.017387388,0.058508426,-0.086311124,0.086210705,0.032990888,0.02394706,-0.076829806,-0.0013207658,-0.017181166,0.03605423,-0.043895654,0.03693967,-0.017151935,-0.14343524,-0.007042124,-0.0107961185,-0.010682232,0.03576117,0.032062214,0.011663382,0.0039875344,-0.035947964,-0.027225723,-0.012877769,0.03847676,0.029883908,0.032162406,0.0077368557,-0.004827592,-0.04551369,-0.021247007,0.05687495,0.0076254345,0.0025559608,0.0017573879,-0.076945595,-0.0481889,0.022559678,-0.137938,0.03544791,0.03719001,-0.015463768,0.07553153,0.0019132533,-0.05373525,0.04748893,0.10321679,-0.025350966,-0.0024744233,0.045228496,0.0030407251,0.03786282,-0.011854718,0.0031317442,-0.04262957,-0.07412522,0.012107446,0.056683622,-0.016227128,0.058647837,0.046335988,0.0016765858,0.051256124,-0.058820423,0.022971597,0.024291491,-0.0041275686,-0.044671357,0.025194425,0.09413899,-0.01924303,-0.0015919169,-0.02782386,-5.3407653E-8,-0.1517169,-0.038245495,-0.10242539,-0.038880106,0.049134724,1.0062349E-4,0.04595754,0.019762348,0.010813044,-0.08015524,-0.013413273,0.029850459,-0.0038772058,-0.041290198,8.221967E-4,-0.037161663,-0.03317894,0.016918553,-0.07851098,4.8172325E-4,0.036878057,-0.008313329,-0.04745016,0.036167417,0.060412448,-0.06875113,-0.010118159,0.06840476,-0.030621763,0.0033914428,-0.035001095,0.08503733,0.041766997,-0.0028388908,-0.02358576,0.11855779,0.03565551,-0.01987405,0.023827454,0.057385378,0.0943396,0.021277435,-0.016080664,0.004890576,0.05339278,-0.0067002913,0.0098259,-0.0059709633,0.10294012,-0.1053307,-0.039027978,-0.0102606015,-0.053321004,0.048928842,-0.006582187,-0.09889856,-0.05910012,-0.07618186,-0.038403675,0.03490808,0.09005616,0.02513418,0.056430686,0.00905497]})
