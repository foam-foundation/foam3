40243,0.090444446,-0.04055412,-0.06179869,0.13100675,0.0031374674,-0.036918458,0.08637805,0.08431382,0.005496601,0.013632453,0.07667712,-0.0014675603,0.05495963,-0.06302587,-0.041978456,-0.0011945792,0.045219254,-0.01074005,0.007588267,0.0028118347,0.14635833,-0.0248943,0.12561761,0.06933253,0.0498178,0.049883626,-0.052415196,0.021258716,0.07570219,0.08810902,0.003433292,-0.043971237,0.034841686,0.03591645,-0.036243692,-0.02876741,0.024307258,0.02575875,5.402959E-4,0.025798947,0.027340265,0.04032187,0.024433386,-0.0291255,0.038827527,0.0031720272,-0.08622291,-0.04579643,0.022214668,0.019375697,-0.056384362,-0.023307448,0.018570054,-0.06184061,0.039025236,0.061015427,0.0454441,-0.0068903863,0.0636076,-0.003115188]})
