c({id:"SPID:12",text:"Predicate Helpers\nIsSpid Predicate\n\nUsed in rules/queries to check user's SPID:\n\njavascript\nfoam.CLASS({\n  package: 'foam.core.crunch.predicate',\n  name: 'IsSpid',\n\n  properties: [\n    {\n      class: 'StringArray',\n      name: 'spids'\n    }\n  ]\n});\n\n// Usage in a rule\n{\n  predicate: {\n    class: 'foam.core.crunch.predicate.IsSpid',\n    spids: ['acme', 'newcorp']\n  }\n}\n\n\nServiceProviderAwarePredicate\n\nWraps predicates to add SPID filtering for related objects:\n\njavascript\nfoam.CLASS({\n  package: 'foam.core.auth',\n  name: 'ServiceProviderAwarePredicate',\n  extends: 'foam.mlang.predicate.AbstractPredicate'\n});",sourceId:"SPID",kind:"flow",embeddingModel:"Xenova/all-MiniLM-L6-v2",vector:[-2.3188158E-4,0.05297078,-0.0025372452,0.008964742,0.044898357,0.010803738,0.068054564,-0.049633943,-0.0019505506,-0.06986211,0.004459352,-0.042790804,0.026913993,0.07807192,0.07696863,0.068854265,0.0153606655,-0.0589046,-0.039281003,-0.053977873,0.16186327,0.05178563,-0.034159184,0.017461428,-0.10079261,0.018726174,-0.012724395,-0.14212501,0.025776636,0.05916683,0.028441794,0.03295349,0.0051936014,0.0010160842,0.019709906,0.048592776,-0.0033828476,-0.005137217,0.03687794,-0.010175625,0.024170078,0.028886864,-0.02387264,-0.0435286,0.030261917,-0.0020466528,-0.07305901,0.05019471,-0.008514183,0.044344302,-0.013251462,-0.072528295,0.034164153,-0.03675798,0.062205315,0.057528462,-0.090728655,0.0017496744,-0.01136708,-0.047266483,0.025558297,-0.095234156,-0.01614027,0.058575362,0.033784058,-0.042248495,0.07132801,0.0017376811,0.008308047,0.06628794,-6.535468E-4,0.056214653,0.013009648,0.010079897,0.020652628,0.12290656,0.06640159,-0.046085387,0.06199776,-0.0034187196,-0.101773456,-0.021001326,0.003215731,-0.00577324,0.03411601,0.031716295,0.018571207,-0.09370053,0.004761413,1.8659404E-4,0.02116393,-0.08223513,0.0069659804,-4.0625499E-4,-0.06996362,0.052262463,-0.10882226,-0.027087713,-0.00907753,0.05444182,-0.09997727,0.008684057,0.0