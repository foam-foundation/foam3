-0.034715157,0.044458944,-0.0032644854,-0.028987156,0.013263926,2.5500523E-4,0.029811665,0.05438129,-0.00827581,0.023278795,0.019258335,0.07303041,-0.023120105,0.026726764,0.08998766,0.046256166,-0.010892791,-0.045530077,-0.07098651,-0.075601734,0.033907004,-0.03342565,-0.01367715,3.6455505E-4,0.012759419,-0.032546848,0.030880824,0.083338544,0.057328403,-0.026045768,-0.083584666,-0.027937839,-0.050638936,0.13340664,-7.295033E-4,0.035176635,0.008334103,-0.06229296,-0.01630368,-0.0014749542,0.049670316,-0.04241116,0.004461618,-0.007523148,0.088121995,0.036293086,-0.11551855,0.044962,0.053138155,0.02096924,-0.019974273,-0.0051413076,-0.06735457,0.046631157,0.07050633,-0.074677214,-0.019761,-0.04509422,0.055798378,0.057185065,-0.017594775,-0.028206762,0.11425757,0.0070675807]})
